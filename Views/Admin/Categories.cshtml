@model CategoriesModel
@{
    ViewData["Title"] = "Categories";
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/Admin/Categories.css" />

<!-- ── Page Header ── -->
<div class="page-header">
    <div>
        <div class="page-title">Categories</div>
        <div class="page-sub">Manage your product categories for keyboards, keycaps, and accessories</div>
    </div>
    <button class="btn-add" onclick="openAddCategoryModal()">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/>
        </svg>
        Add Category
    </button>
</div>

<!-- ── Stat Cards ── -->
<div class="stats-grid">
    @foreach (var s in Model.Stats)
    {
        <div class="stat-card">
            <div class="stat-icon @s.IconClass">
                @Html.Raw(s.IconSvg)
            </div>
            <div>
                <div class="stat-label">@s.Label</div>
                <div class="stat-value">@s.Value</div>
            </div>
        </div>
    }
</div>

<!-- ── Filter Panel ── -->
<div class="filter-panel">
    <div class="search-wrap">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
        </svg>
        <input class="search-input" type="text" placeholder="Search categories..." />
    </div>
    <select class="filter-select">
        <option>All Status</option>
        <option>Active</option>
        <option>Inactive</option>
        <option>Featured</option>
    </select>
</div>

<!-- ── Category List ── -->
<div class="list-panel">
    <div class="list-panel-header">All Categories</div>

    @foreach (var cat in Model.Categories)
    {
        <!-- Parent Row -->
        <div class="cat-row parent">
            <button class="toggle-btn @(cat.IsExpanded ? "" : "collapsed")">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
            </button>
            <div class="cat-thumb"></div>
            <div class="cat-info">
                <div class="cat-name-row">
                    <span class="cat-name">@cat.Name</span>
                    @if (cat.IsFeatured)  { <span class="badge badge-featured">Featured</span> }
                    @if (cat.Status == "Active")   { <span class="badge badge-active">Active</span> }
                    @if (cat.Status == "Inactive") { <span class="badge badge-inactive">Inactive</span> }
                </div>
                <div class="cat-desc">@cat.Description</div>
            </div>
            <div class="cat-stats">
                <div class="cat-stat">
                    <div class="val">@cat.ProductCount</div>
                    <div class="lbl">Products</div>
                </div>
                @if (cat.SubcategoryCount.HasValue)
                {
                    <div class="cat-stat">
                        <div class="val">@cat.SubcategoryCount</div>
                        <div class="lbl">Subcategories</div>
                    </div>
                }
            </div>
            <button class="menu-btn">···</button>
        </div>

        <!-- Child Rows -->
        @if (cat.IsExpanded && cat.Children != null)
        {
            @foreach (var child in cat.Children)
            {
                <div class="cat-row child">
                    <div class="cat-thumb sm"></div>
                    <div class="cat-info">
                        <div class="cat-name-row">
                            <span class="cat-name">@child.Name</span>
                            @if (child.IsFeatured)  { <span class="badge badge-featured">Featured</span> }
                            @if (child.Status == "Active")   { <span class="badge badge-active">Active</span> }
                            @if (child.Status == "Inactive") { <span class="badge badge-inactive">Inactive</span> }
                        </div>
                        <div class="cat-desc">@child.Description</div>
                    </div>
                    <div class="cat-stats">
                        <div class="cat-stat">
                            <div class="val">@child.ProductCount</div>
                            <div class="lbl">Products</div>
                        </div>
                    </div>
                    <button class="menu-btn">···</button>
                </div>
            }
        }
    }
</div>

<!-- ── Add Category Modal ── -->
<div id="addCategoryModal" class="modal">
    <div class="modal-overlay" onclick="closeAddCategoryModal()"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h2>Add New Category</h2>
            <button class="modal-close" onclick="closeAddCategoryModal()">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
            </button>
        </div>
        
        <form id="addCategoryForm" class="modal-body">
            <div class="form-group">
                <label for="categoryName">Category Name *</label>
                <input 
                    type="text" 
                    id="categoryName" 
                    name="categoryName" 
                    class="form-input" 
                    placeholder="Enter category name"
                    required />
            </div>

            <div class="form-group">
                <label for="categoryDescription">Description</label>
                <textarea 
                    id="categoryDescription" 
                    name="categoryDescription" 
                    class="form-textarea" 
                    placeholder="Enter category description"
                    rows="3"></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="categoryStatus">Status *</label>
                    <select id="categoryStatus" name="categoryStatus" class="form-select" required>
                        <option value="">Select status</option>
                        <option value="Active" selected>Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-checkbox-label">
                        <input 
                            type="checkbox" 
                            id="categoryFeatured" 
                            name="categoryFeatured" 
                            class="form-checkbox" />
                        Mark as Featured
                    </label>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="closeAddCategoryModal()">Cancel</button>
                <button type="submit" class="btn-submit">Add Category</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openAddCategoryModal() {
        document.getElementById('addCategoryModal').classList.add('active');
    }

    function closeAddCategoryModal() {
        document.getElementById('addCategoryModal').classList.remove('active');
        document.getElementById('addCategoryForm').reset();
    }

    document.getElementById('addCategoryForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = {
            name: document.getElementById('categoryName').value,
            description: document.getElementById('categoryDescription').value,
            status: document.getElementById('categoryStatus').value,
            isFeatured: document.getElementById('categoryFeatured').checked
        };

        console.log('Category Data:', formData);
        
        // TODO: Send data to backend API
        // fetch('/Admin/AddCategory', {
        //     method: 'POST',
        //     headers: { 'Content-Type': 'application/json' },
        //     body: JSON.stringify(formData)
        // }).then(response => response.json())
        //   .then(data => { /* handle response */ });

        closeAddCategoryModal();
        alert('Form submitted! (Connected to API handle needed)');
    });

    // Close modal when pressing Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeAddCategoryModal();
        }
    });
</script>

