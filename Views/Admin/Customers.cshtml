@using System.Text.Json
@model KeyboardWebsiteProject.Models.AdminCustomerViewModel
@{
    ViewData["Title"] = "Customers";
    Layout = "_AdminLayout";
}

<div class="page">

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-error">@ViewBag.ErrorMessage</div>
    }

    <!-- ── Top bar ── -->
    <div class="topbar">
        <div>
            <h1>Customers</h1>
            <p>Manage your customer base and relationships</p>
        </div>
        <div class="topbar-actions">
            <button class="export-btn">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                Export
            </button>
            <button class="add-btn" onclick="openModal()">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M20 21a8 8 0 10-16 0"/>
                    <line x1="19" y1="8" x2="19" y2="14"/>
                    <line x1="16" y1="11" x2="22" y2="11"/>
                </svg>
                Add Customer
            </button>
        </div>
    </div>

    <!-- ── Stat cards ── -->
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-icon blue">
                <svg width="22" height="22" fill="none" stroke="#2563eb" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">Total Customers</div>
                <div class="stat-value" id="totalCustomers">@Model.TotalCustomers.ToString("N0")</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon blue">
                <svg width="22" height="22" fill="none" stroke="#2563eb" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                    <circle cx="8.5" cy="7" r="4"/>
                    <line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">New This Month</div>
                <div class="stat-value">@Model.NewThisMonth.ToString("N0")</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">
                <svg width="22" height="22" fill="none" stroke="#10b981" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <polyline points="16 11 18 13 22 9"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">Active</div>
                <div class="stat-value">@Model.ActiveCustomers.ToString("N0")</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange">
                <svg width="22" height="22" fill="none" stroke="#f97316" stroke-width="1.8" viewBox="0 0 24 24">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                    <polyline points="17 6 23 6 23 12"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">VIP Members</div>
                <div class="stat-value">@Model.VipMembers.ToString("N0")</div>
            </div>
        </div>
    </div>

    <!-- ── Filter bar ── -->
    <div class="filter-bar">
        <div class="search-wrap">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
            <input type="text" id="searchInput" placeholder="Search customers by name or email..." oninput="filterTable()" />
        </div>

        <select class="filter-select" id="sortFilter" onchange="filterTable()">
            <option value="recent">Most Recent</option>
            <option value="name">Name A–Z</option>
            <option value="spent">Highest Spent</option>
            <option value="orders">Most Orders</option>
        </select>

        <button class="more-filters-btn">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <line x1="4" y1="6" x2="20" y2="6"/>
                <line x1="8" y1="12" x2="16" y2="12"/>
                <line x1="11" y1="18" x2="13" y2="18"/>
            </svg>
            More Filters
        </button>
    </div>

    <!-- ── Table card ── -->
    <div class="table-card">
        <div class="table-card-header">All Customers</div>
        <table>
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Phone</th>
                    <th>Orders</th>
                    <th>Total Spent</th>
                    <th>Created</th>
                    <th>Order Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="customerTable">
                <!-- Rows injected by JS -->
            </tbody>
        </table>

        <!-- Pagination -->
        <div class="pagination">
            <span id="pageInfo">Showing 1–8 of 12 customers</span>
            <div class="page-btns">
                <button class="page-btn" id="prevBtn" onclick="changePage(-1)">‹</button>
                <button class="page-btn active" id="p1" onclick="goPage(1)">1</button>
                <button class="page-btn" id="p2" onclick="goPage(2)">2</button>
                <button class="page-btn" id="nextBtn" onclick="changePage(1)">›</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Add Customer Modal ── -->
<div class="modal-overlay" id="modalOverlay" onclick="closeModalOutside(event)">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">Add New Customer</div>
            <button class="modal-close" onclick="closeModal()">✕</button>
        </div>
        <div class="mrow two">
            <div class="fg"><label>First Name</label><input type="text" id="mFirstName" placeholder="John" /></div>
            <div class="fg"><label>Last Name</label><input type="text" id="mLastName" placeholder="Doe" /></div>
        </div>
        <div class="mrow one">
            <div class="fg"><label>Email Address</label><input type="email" id="mEmail" placeholder="john@example.com" /></div>
        </div>
        <div class="mrow two">
            <div class="fg"><label>Phone Number</label><input type="tel" id="mPhone" placeholder="+1 (555) 000-0000" /></div>
            <div class="fg">
                <label>Status</label>
                <select id="mStatus">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="VIP">VIP</option>
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="cancel-btn" onclick="closeModal()">Cancel</button>
            <button class="submit-btn" onclick="addCustomer()">Add Customer</button>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast" id="toast">Customer added successfully!</div>

<script>
    // ── Data from DB ──
    const customers = @Html.Raw(JsonSerializer.Serialize(Model.Customers, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
    const PER_PAGE = 8;
    let currentPage = 1;
    let filtered = [...customers];

    function initials(c) {
        if (c.initials) return c.initials;
        const parts = (c.name || '').split(' ').filter(p => p.length > 0);
        return parts.slice(0, 2).map(p => p.charAt(0)).join('').toUpperCase() || '--';
    }

    function renderTable() {
        const start = (currentPage - 1) * PER_PAGE;
        const page  = filtered.slice(start, start + PER_PAGE);
        const tbody = document.getElementById('customerTable');

        if (page.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="empty-row">No customers found.</td>
                </tr>
            `;
        } else {
            tbody.innerHTML = page.map(c => `
                <tr>
                    <td>
                        <div class="cust-cell">
                            <div class="av av-${c.color}">${initials(c)}</div>
                            <div>
                                <div class="cust-name">${c.name}</div>
                                <div class="cust-email">${c.email}</div>
                            </div>
                        </div>
                    </td>
                    <td class="phone-cell">${c.phone || '—'}</td>
                    <td class="orders-cell">${c.orders}</td>
                    <td class="spent-cell">฿${Number(c.spent).toLocaleString('en-US')}</td>
                    <td>${c.created}</td>
                    <td>${c.lastOrder}</td>
                    <td><button class="actions-btn" title="Options">···</button></td>
                </tr>
            `).join('');
        }

        const total = filtered.length;
        const end   = Math.min(start + PER_PAGE, total);
        document.getElementById('pageInfo').textContent =
            `Showing ${start + 1}–${end} of ${total} customers`;

        const pages = Math.ceil(total / PER_PAGE);
        document.getElementById('p1').classList.toggle('active', currentPage === 1);
        document.getElementById('p2').classList.toggle('active', currentPage === 2);
        document.getElementById('p2').style.display = pages >= 2 ? '' : 'none';
        document.getElementById('prevBtn').disabled = currentPage === 1;
        document.getElementById('nextBtn').disabled = currentPage >= pages;
    }

    function filterTable() {
        const q    = document.getElementById('searchInput').value.toLowerCase();
        const sort = document.getElementById('sortFilter').value;

        filtered = customers.filter(c => {
            return !q || `${c.name} ${c.email}`.toLowerCase().includes(q);
        });

        if (sort === 'name')   filtered.sort((a,b) => a.name.localeCompare(b.name));
        if (sort === 'spent')  filtered.sort((a,b) => b.spent - a.spent);
        if (sort === 'orders') filtered.sort((a,b) => b.orders - a.orders);

        currentPage = 1;
        renderTable();
    }

    function changePage(d) { currentPage = Math.max(1, currentPage + d); renderTable(); }
    function goPage(p)     { currentPage = p; renderTable(); }

    // ── Modal ──
    function openModal()  { document.getElementById('modalOverlay').classList.add('open'); }
    function closeModal() { document.getElementById('modalOverlay').classList.remove('open'); }
    function closeModalOutside(e) { if (e.target === document.getElementById('modalOverlay')) closeModal(); }

    function addCustomer() {
        const f = document.getElementById('mFirstName').value.trim();
        const l = document.getElementById('mLastName').value.trim();
        const e = document.getElementById('mEmail').value.trim();
        const p = document.getElementById('mPhone').value.trim();
        const s = document.getElementById('mStatus').value;
        if (!f || !l || !e) return;

        const colors = ['blue','green','purple','orange','teal','pink'];
        const newC = {
            id: Date.now(), first: f, last: l, email: e,
            phone: p || '—', orders: 0, spent: 0, status: s,
            joined: new Date().toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}),
            lastOrder: '—',
            color: colors[Math.floor(Math.random() * colors.length)]
        };

        customers.unshift(newC);
        document.getElementById('totalCustomers').textContent = customers.length.toLocaleString();
        filterTable();
        closeModal();

        // clear fields
        ['mFirstName','mLastName','mEmail','mPhone'].forEach(id => document.getElementById(id).value = '');

        const toast = document.getElementById('toast');
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2600);
    }

    // Init
    renderTable();
</script>
