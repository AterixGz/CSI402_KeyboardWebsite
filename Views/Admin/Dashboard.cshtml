
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}
    <div class="topbar">
        <div>
            <div class="topbar-title">Dashboard</div>
            <div class="topbar-sub">Welcome back, Admin</div>
        </div>
        <div class="last-updated">Last updated: <span>@Model.LastUpdated</span></div>
    </div>

    <div class="content">

        <!-- ── Stat Cards ── -->
        <div class="stats-grid">
            @foreach (var stat in Model.Stats)
            {
                <div class="stat-card">
                    <div class="card-header">
                        <div class="card-label">@stat.Label</div>
                        <div class="card-icon @stat.IconClass">
                            @if (stat.IconClass == "icon-green")
                            {
                                <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
                                </svg>
                            }
                            else if (stat.IconClass == "icon-purple")
                            {
                                <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
                                </svg>
                            }
                            else if (stat.IconClass == "icon-blue")
                            {
                                <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4z" clip-rule="evenodd"/>
                                </svg>
                            }
                            else if (stat.IconClass == "icon-orange")
                            {
                                <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"/>
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"/>
                                </svg>
                            }
                        </div>
                    </div>
                    <div class="card-value">@stat.Value</div>
                    <div class="card-change @(stat.IsPositive ? "change-pos" : "change-neg")">
                        @(stat.IsPositive ? "↗" : "↘") @stat.Change
                    </div>
                </div>
            }
        </div>

        <!-- ── Bottom Panels ── -->
        <div class="bottom-grid">

            <div class="panel">
                <div class="panel-header">
                    <div>
                        <div class="panel-title">Recent Orders</div>
                        <div class="panel-sub">Latest transactions</div>
                    </div>
                    <div class="panel-icon">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" opacity=".4">
                            <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
                        </svg>
                    </div>
                </div>

                @foreach (var order in Model.RecentOrders)
                {
                    <div class="order-item">
                        <div class="order-avatar">@order.Initials</div>
                        <div class="order-info">
                            <div class="order-name">@order.Name</div>
                            <div class="order-product">@order.Product</div>
                        </div>
                        <div class="order-right">
                            <div class="order-amount">@order.Amount</div>
                            <span class="badge @order.BadgeClass">@order.Status</span>
                        </div>
                    </div>
                }
            </div>

            <div class="panel">
                <div class="panel-header">
                    <div>
                        <div class="panel-title">Top Customers</div>
                        <div class="panel-sub">By total spend</div>
                    </div>
                    <div class="panel-icon">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" opacity=".4">
                            <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
                        </svg>
                    </div>
                </div>

                @foreach (var customer in Model.TopCustomers)
                {
                    <div class="customer-item">
                        <div class="customer-rank">@customer.Rank</div>
                        <div class="customer-info">
                            <div class="customer-name">@customer.Name</div>
                            <div class="customer-email">@customer.Email</div>
                        </div>
                        <div class="customer-right">
                            <div class="customer-amount">@customer.Amount</div>
                            <div class="customer-orders">@customer.Orders</div>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
