@model KeyboardWebsiteProject.Models.AdminSettingsViewModel
@{
    ViewData["Title"] = "Settings";
    Layout = "_AdminLayout";

    var avatarUrl = Model?.Profile?.AvatarUrl ?? string.Empty;
    var firstName = Model?.Profile?.FirstName ?? string.Empty;
    var lastName = Model?.Profile?.LastName ?? string.Empty;
    var email = Model?.User?.Email ?? string.Empty;
    var phone = Model?.User?.Phone ?? string.Empty;
    var role = !string.IsNullOrWhiteSpace(Model?.User?.RoleName) ? Model.User.RoleName : "Store Administrator";
    var initials = string.Empty;
    if (!string.IsNullOrWhiteSpace(firstName)) initials += firstName.Trim()[0].ToString().ToUpper();
    if (!string.IsNullOrWhiteSpace(lastName)) initials += lastName.Trim()[0].ToString().ToUpper();
    if (string.IsNullOrWhiteSpace(initials)) initials = "JD";
}
<div class="page">

    <!-- Page header -->
    <div class="page-header">
        <h1>Settings</h1>
        <p>Manage your store settings and preferences</p>
    </div>

    <div class="layout">

        <!-- ── Side Nav ── -->
        <nav class="sidenav">
            <a class="nav-item active" onclick="switchTab(this, 'profile')">
                <!-- Profile icon -->
                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                </svg>
                Profile
            </a>
            <a class="nav-item" onclick="switchTab(this, 'store')">
                <!-- Store icon -->
                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                Store
            </a>
        </nav>

        <!-- ── Main Panel ── -->
        <div class="settings-panel" id="panel-profile">
            <div class="panel-title">Profile Information</div>
            <div class="panel-sub">Update your account profile information and email address</div>

            <hr class="divider" />

            <!-- Avatar -->
            <div class="avatar-row">
                <div class="avatar" id="avatarEl" onclick="document.getElementById('photoInput').click()">
                    <span id="avatarInitials" style="display:@(string.IsNullOrWhiteSpace(avatarUrl) ? "flex" : "none")">@initials</span>
                    <img id="avatarImg" src="@avatarUrl" style="display:@(string.IsNullOrWhiteSpace(avatarUrl) ? "none" : "block")" alt="avatar" />
                </div>
                <div class="upload-col">
                    <button class="upload-btn" onclick="document.getElementById('photoInput').click()" disabled>
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                        Upload Photo
                    </button>
                    <input type="file" id="photoInput" accept="image/*" style="display:none;" onchange="previewPhoto(event)" disabled />
                    <div class="upload-hint">JPG, PNG or GIF. Max 2MB.</div>
                </div>
            </div>

            <hr class="divider" />

            <!-- First + Last name -->
            <div class="form-row two-col">
                <div class="form-group">
                    <label for="firstName">First Name</label>
                    <input type="text" id="firstName" value="@firstName" placeholder="First name" disabled />
                </div>
                <div class="form-group">
                    <label for="lastName">Last Name</label>
                    <input type="text" id="lastName" value="@lastName" placeholder="Last name" disabled />
                </div>
            </div>

            <!-- Email -->
            <div class="form-row one-col">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" value="@email" placeholder="Email address" disabled />
                </div>
            </div>

            <!-- Phone + Role -->
            <div class="form-row two-col">
                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="tel" id="phone" value="@phone" placeholder="Phone number" disabled />
                </div>
                <div class="form-group">
                    <label for="role">Role</label>
                    <input type="text" id="role" value="@role" placeholder="Store Administrator" readonly disabled />
                </div>
            </div>

        </div>

        <!-- Placeholder panels for other tabs -->
        <div class="settings-panel" id="panel-store" style="display:none;">
            <div class="panel-title">Store Settings</div>
            <div class="panel-sub">Configure your store name, currency, and other preferences.</div>
            <hr class="divider"/>
            <div class="form-row one-col">
                <div class="form-group">
                    <label>Store Name</label>
                    <input type="text" value="KeyCraft Store" disabled />
                </div>
            </div>
            <div class="form-row two-col">
                <div class="form-group">
                    <label>Currency</label>
                    <input type="text" value="USD" disabled />
                </div>
                <div class="form-group">
                    <label>Timezone</label>
                    <input type="text" value="UTC-5 (EST)" disabled />
                </div>
            </div>
        </div>


    </div>
</div>

<!-- Toast -->
<div class="toast" id="toast">Changes saved successfully!</div>

<script>
    const tabs = ['profile','store','security'];

    function switchTab(el, tab) {
        // Update nav active state
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        el.classList.add('active');

        // Show correct panel
        tabs.forEach(t => {
            const p = document.getElementById('panel-' + t);
            if (p) p.style.display = (t === tab) ? 'block' : 'none';
        });
    }

    function saveChanges() {
        const toast = document.getElementById('toast');
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2800);
    }

    function previewPhoto(e) {
        const file = e.target.files[0];
        if (!file) return;
        if (file.size > 2 * 1024 * 1024) { alert('File exceeds 2MB limit.'); return; }
        const reader = new FileReader();
        reader.onload = ev => {
            const img = document.getElementById('avatarImg');
            img.src = ev.target.result;
            img.style.display = 'block';
            document.getElementById('avatarInitials').style.display = 'none';
        };
        reader.readAsDataURL(file);
    }

    // Update initials dynamically
    ['firstName','lastName'].forEach(id => {
        document.getElementById(id).addEventListener('input', () => {
            const f = document.getElementById('firstName').value.charAt(0).toUpperCase();
            const l = document.getElementById('lastName').value.charAt(0).toUpperCase();
            document.getElementById('avatarInitials').textContent = f + l;
        });
    });
</script>
