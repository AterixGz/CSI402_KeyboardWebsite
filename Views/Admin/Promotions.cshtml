@model List<KeyboardWebsiteProject.Models.PromotionViewModel>
@{
    ViewData["Title"] = "Manage Promotions";
    Layout = "_AdminLayout";

    var promotions = Model ?? new List<KeyboardWebsiteProject.Models.PromotionViewModel>();
    var promoCategories = ViewBag.PromoCategories as List<string> ?? new List<string> { "All Categories" };
    var promoProducts = ViewBag.PromoProducts as List<KeyboardWebsiteProject.Models.Product> ?? new List<KeyboardWebsiteProject.Models.Product>();
    int totalAll      = promotions.Count;
    int totalActive   = promotions.Count(p => p.Status == "active");
    int totalUsed     = promotions.Sum(p => p.Used);
    int totalLimit    = promotions.Sum(p => p.Limit);
    int avgDiscount   = totalLimit > 0 ? totalUsed * 100 / totalLimit : 0;
}

<div class="topbar">
    <div>
        <div class="topbar-title">Manage Promotions</div>
        <div class="topbar-sub">Create, edit, and manage promotional codes for your store</div>
    </div>
    <button type="button" class="btn-add-topbar" onclick="openModal()">+ Add Promotion</button>
</div>

<div class="content">

<!-- MODAL -->
<div class="modal-overlay" id="modal" onclick="closeModalOutside(event)">
    <div class="modal">
        <div class="modal-header">
            <span class="modal-title" id="modal-title">Add Promotion</span>
            <button class="btn-close" onclick="closeModal()">✕</button>
        </div>
        <div class="modal-body">
            <div class="field-row">
                <div class="field">
                    <label>Promotion Type</label>
                    <select id="f-type" onchange="togglePromotionFields()">
                        <option value="coupon">Coupon Promotion</option>
                        <option value="system">System Promotion</option>
                    </select>
                </div>
                <div class="field">
                    <label>Status</label>
                    <select id="f-status">
                        <option value="active">Active</option>
                        <option value="scheduled">Scheduled</option>
                        <option value="expired">Expired</option>
                    </select>
                </div>
            </div>
            <div class="field">
                <label class="required">Promotion Name</label>
                <input id="f-name" type="text" placeholder="e.g., Summer Sale Keyboards" required />
            </div>
            <div class="field-row" id="coupon-fields">
                <div class="field">
                    <label class="required">Promotion Code</label>
                    <input id="f-code" type="text" placeholder="e.g., SUMMER2024" style="text-transform:uppercase" />
                </div>
                <div class="field">
                    <label>Usage Limit</label>
                    <input id="f-limit" type="number" placeholder="e.g., 500" min="0" />
                </div>
            </div>
            <div class="field-row">
                <div class="field">
                    <label>Discount Type</label>
                    <select id="f-discount-type">
                        <option value="percentage">Percent</option>
                        <option value="fixed">Fixed Amount</option>
                    </select>
                </div>
                <div class="field">
                    <label class="required">Discount Amount</label>
                    <input id="f-discount" type="text" placeholder="e.g., 20% or ฿500" required />
                </div>
            </div>
            <div class="field-row">
                <div class="field">
                    <label>Minimum Spend</label>
                    <input id="f-min-spend" type="text" placeholder="e.g., ฿1,000" />
                </div>
                <div class="field checkbox-field">
                    <label class="checkbox-label"><input id="f-free-shipping" type="checkbox" /> Free Shipping</label>
                </div>
            </div>
            <div class="field">
                <label class="required">Product/Category Selection</label>
                <div class="unified-selection">
                    <div class="selection-row">
                        <select id="f-category" onchange="refreshProductSelect()">
                            @foreach (var category in promoCategories)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                        <select id="f-product-select">
                            <option value="" selected>Select product (optional)</option>
                        </select>
                        <input id="f-qty-min" type="number" placeholder="Min qty (optional)" min="0" />
                        <input id="f-qty-max" type="number" placeholder="Max qty (optional)" min="0" />
                        <button type="button" class="btn-add-item" onclick="addSelectedItem()">+ Add</button>
                    </div>
                    <div id="selected-items" class="selected-items"></div>
                </div>
            </div>

            <div class="field-row">
                <div class="field">
                    <label class="required">Start Date</label>
                    <input id="f-start" type="date" required />
                </div>
                <div class="field">
                    <label class="required">End Date</label>
                    <input id="f-end" type="date" required />
                </div>
            </div>
            <div class="field" id="coupon-expiry-field">
                <label>Expiry Date</label>
                <input id="f-expiry" type="date" />
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
            <button type="button" class="btn-save" onclick="savePromo()">Save</button>
        </div>
    </div>
</div>

<div class="page">

    <!-- ── Stat cards ── -->
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-icon si-blue">
                <svg width="22" height="22" fill="none" stroke="#2563eb" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">Total Promotions</div>
                <div class="stat-value" id="stat-total">@totalAll</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-green">
                <svg width="22" height="22" fill="none" stroke="#16a34a" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">Active</div>
                <div class="stat-value" id="stat-active">@totalActive</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-orange">
                <svg width="22" height="22" fill="none" stroke="#ea580c" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">Total Used</div>
                <div class="stat-value" id="stat-used">@totalUsed</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-red">
                <svg width="22" height="22" fill="none" stroke="#dc2626" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">Avg. Usage</div>
                <div class="stat-value" id="stat-avg">@avgDiscount%</div>
            </div>
        </div>
    </div>


    <!-- ── MAIN CARD ── -->
    <div class="card">
        <!-- Filters -->
        <div class="promo-tabs">
            <button class="tab-item active" data-tab="coupon" onclick="switchPromoTab('coupon')">Coupon Promotion</button>
            <button class="tab-item" data-tab="system" onclick="switchPromoTab('system')">System Promotion</button>
        </div>
        <div class="filter-bar">
            <div class="search-wrap">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
                </svg>
                <input type="text" id="search-input"
                       placeholder="Search promotions..."
                       oninput="filterTable()" />
            </div>
            <select class="filter-select" id="filter-status" onchange="filterTable()">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="scheduled">Scheduled</option>
                <option value="expired">Expired</option>
            </select>
            <select class="filter-select" id="filter-cat" onchange="filterTable()">
                <option value="">All Categories</option>
                <option value="Keyboard">Keyboard</option>
                <option value="Keycap">Keycap</option>
                <option value="Switch">Switch</option>
                <option value="All Categories">All Categories</option>
            </select>
        </div>

        <!-- Table -->
        <table id="promo-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Type</th>
                    <th>Discount</th>
                    <th>Category</th>
                    <th>Duration</th>
                    <th>Status</th>
                    <th>Usage</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="promo-body">
                @{
                    var catIcons = new Dictionary<string, string> {
                        {"Keyboard","💾"}, {"Keycap","🎨"}, {"Switch","⚡"}, {"All Categories","📦"}
                    };
                }
                @foreach (var p in promotions)
                {
                    int pct = p.Limit > 0 ? p.Used * 100 / p.Limit : 0;
                    string statusClass = p.Status == "active" ? "status-active"
                                      : p.Status == "scheduled" ? "status-scheduled"
                                      : "status-expired";
                    string statusLabel = p.Status == "active" ? "✓ Active"
                                      : p.Status == "scheduled" ? "📅 Scheduled"
                                      : "✕ Expired";
                    string icon = catIcons.ContainsKey(p.Category) ? catIcons[p.Category] : "📦";
                    <tr data-name="@p.Name.ToLower()" data-code="@p.Code.ToLower()" data-status="@p.Status" data-cat="@p.Category" data-type="@p.Type" data-discount-type="@p.DiscountType" data-min-spend="@p.MinSpend" data-free-shipping="@p.IsFreeShipping" data-expiry="@p.ExpiryDate" data-limit="@p.Limit">
                        <td><span class="promo-name">@p.Name</span></td>
                        <td><span class="promo-code">@p.Code</span></td>
                        <td><span class="promo-type">@(p.Type == "coupon" ? "Coupon" : "System")</span></td>
                        <td><span class="discount-val">@p.Discount</span></td>
                        <td>
                            <span class="cat-badge">@icon @p.Category</span>
                        </td>
                        <td>
                            <div class="date-range">
                                <span>📅</span>
                                <span>@p.DateStart – @p.DateEnd</span>
                            </div>
                        </td>
                        <td>
                            <span class="status-badge @statusClass">@statusLabel</span>
                        </td>
                        <td>
                            <div class="usage-wrap">
                                <span class="usage-text">@p.Used / @p.Limit</span>
                                <div class="usage-track">
                                    <div class="usage-fill @(pct >= 90 ? "full" : "")" style="width:@pct%"></div>
                                </div>
                            </div>
                        </td>
                        <td class="action-cell">
                            <button class="btn-action" onclick="toggleDropdown(this)">•••</button>
                            <div class="dropdown">
                                <button onclick="editRow(this)">✏️ Edit</button>
                                <button onclick="duplicateRow(this)">📋 Duplicate</button>
                                <button class="danger" onclick="deleteRow(this)">🗑️ Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Empty state (hidden by default) -->
        <div class="empty" id="empty-state" style="display:none;">
            <div class="empty-icon">🔍</div>
            <div>No promotions found</div>
        </div>
    </div>
</div>

<!-- Toast notification -->
<div class="toast" id="toast"></div>

<script>
// ── Data store ──
const store = [
    @foreach (var p in promotions)
    {
        <text>{ name:"@p.Name", code:"@p.Code", discount:"@p.Discount", category:"@p.Category", dateStart:"@p.DateStart", dateEnd:"@p.DateEnd", status:"@p.Status", used:@p.Used, limit:@p.Limit },</text>
    }
];

// ── Close dropdowns on outside click ──
document.addEventListener('click', e => {
    if (!e.target.classList.contains('btn-action'))
        document.querySelectorAll('.dropdown.open').forEach(d => d.classList.remove('open'));
});

function toggleDropdown(btn) {
    const dd = btn.nextElementSibling;
    const isOpen = dd.classList.contains('open');
    document.querySelectorAll('.dropdown.open').forEach(d => d.classList.remove('open'));
    if (!isOpen) dd.classList.add('open');
}

// ── Filter ──
let currentPromoTab = 'coupon';

function switchPromoTab(tab) {
    currentPromoTab = tab;
    document.querySelectorAll('.promo-tabs .tab-item').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.tab === tab);
    });
    filterTable();
}

function filterTable() {
    const q      = document.getElementById('search-input').value.toLowerCase();
    const status = document.getElementById('filter-status').value;
    const cat    = document.getElementById('filter-cat').value;
    const rows   = document.querySelectorAll('#promo-body tr');
    let visible  = 0;

    rows.forEach(row => {
        const matchType = row.dataset.type === currentPromoTab;
        const matchQ   = !q      || row.dataset.name.includes(q) || row.dataset.code.includes(q);
        const matchSt  = !status || row.dataset.status === status;
        const matchCat = !cat    || row.dataset.cat === cat;
        const show = matchType && matchQ && matchSt && matchCat;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
    });

    document.getElementById('empty-state').style.display = visible === 0 ? 'block' : 'none';
}

// ── Modal ──
let editingRow = null;

function openModal(data = null) {
    const promo = data || {};
    if (!data) editingRow = null;
    document.getElementById('modal-title').textContent = data ? 'Edit Promotion' : 'Add Promotion';
    document.getElementById('f-type').value      = promo.type      || 'coupon';
    document.getElementById('f-name').value      = promo.name      || '';
    document.getElementById('f-code').value      = promo.code      || '';
    document.getElementById('f-discount').value  = promo.discount  || '';
    const discountTypeValue = promo.discountType === 'percent' ? 'percentage' : promo.discountType || 'percentage';
    document.getElementById('f-discount-type').value = discountTypeValue;
    document.getElementById('f-min-spend').value = promo.minSpend  || '';
    document.getElementById('f-free-shipping').checked = promo.isFreeShipping === true || promo.isFreeShipping === 'true';
    document.getElementById('f-category').value  = promo.category  || 'Keyboard';
    document.getElementById('f-limit').value     = promo.limit     || '';
    document.getElementById('f-start').value     = promo.dateStart || '';
    document.getElementById('f-end').value       = promo.dateEnd   || '';
    document.getElementById('f-expiry').value    = promo.expiry    || promo.dateEnd || '';
    document.getElementById('f-status').value    = promo.status    || 'active';
    selectedPromoItems = Array.isArray(promo.items) ? promo.items : [];
    refreshProductSelect();
    renderSelectedItems();
    togglePromotionFields();
    document.getElementById('modal').classList.add('open');
}

function closeModal() { document.getElementById('modal').classList.remove('open'); editingRow = null; }
function closeModalOutside(e) { if (e.target === document.getElementById('modal')) closeModal(); }

function editRow(btn) {
    const row = btn.closest('tr');
    editingRow = row;
    btn.closest('.dropdown').classList.remove('open');
    const cells = row.querySelectorAll('td');
    const dateText = cells[5].querySelector('.date-range span:last-child').textContent.split(' – ');
    const items = row.dataset.items ? JSON.parse(row.dataset.items) : [];
    openModal({
        type:      row.dataset.type || 'coupon',
        name:      cells[0].querySelector('.promo-name').textContent,
        code:      cells[1].querySelector('.promo-code').textContent,
        discount:  cells[3].querySelector('.discount-val').textContent,
        discountType: row.dataset.discountType || 'percent',
        minSpend:  row.dataset.minSpend || '',
        isFreeShipping: row.dataset.freeShipping === 'true',
        category:  row.dataset.cat,
        limit:     row.dataset.limit || '',
        dateStart: dateText[0]?.trim(),
        dateEnd:   dateText[1]?.trim(),
        expiry:    row.dataset.expiry || dateText[1]?.trim(),
        status:    row.dataset.status,
        items: items
    });
}

function togglePromotionFields() {
    const promoType = document.getElementById('f-type').value;
    const couponFields = document.getElementById('coupon-fields');
    const expiryField = document.getElementById('coupon-expiry-field');
    if (promoType === 'coupon') {
        couponFields.style.display = 'flex';
        expiryField.style.display = '';
    } else {
        couponFields.style.display = 'none';
        expiryField.style.display = 'none';
    }
}

const productCatalog = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(promoProducts.Select(p => new { id = p.ProductId, name = p.Name ?? string.Empty, category = p.CategoryName ?? "All Categories" })));
let selectedPromoItems = [];

function addSelectedItem() {
    const categoryDropdown = document.getElementById('f-category');
    const productDropdown = document.getElementById('f-product-select');
    const minQty = parseInt(document.getElementById('f-qty-min').value) || 0;
    const maxQty = parseInt(document.getElementById('f-qty-max').value) || 0;
    
    const category = categoryDropdown.value;
    const productId = productDropdown.value ? parseInt(productDropdown.value, 10) : null;
    
    if (!category) {
        showToast('Please select a category');
        return;
    }
    
    let product = null;
    if (productId) {
        product = productCatalog.find(p => p.id === productId);
        if (!product) return;
        // Check for duplicate product
        if (selectedPromoItems.some(item => item.product && item.product.id === productId)) {
            showToast('This product already added');
            return;
        }
    } else {
        // Check for duplicate category-only
        if (selectedPromoItems.some(item => !item.product && item.category === category)) {
            showToast('This category already added');
            return;
        }
    }
    
    selectedPromoItems.push({
        category: category,
        product: product,
        minQty: minQty,
        maxQty: maxQty
    });
    
    renderSelectedItems();
    productDropdown.value = '';
    document.getElementById('f-qty-min').value = '';
    document.getElementById('f-qty-max').value = '';
    showToast('✓ Item added');
}

function removeSelectedItem(index) {
    selectedPromoItems.splice(index, 1);
    renderSelectedItems();
}

function renderSelectedItems() {
    const container = document.getElementById('selected-items');
    container.innerHTML = '';
    
    selectedPromoItems.forEach((item, index) => {
        const itemDiv = document.createElement('div');
        itemDiv.className = 'selected-item';
        
        let itemLabel = item.category;
        if (item.product) {
            itemLabel = `${item.category} - ${item.product.name}`;
        }
        
        let qtyLabel = '';
        if (item.minQty || item.maxQty) {
            qtyLabel = ` (Min: ${item.minQty || 0}, Max: ${item.maxQty || 0})`;
        }
        
        itemDiv.innerHTML = `
            <div class="item-content">
                <span class="item-label">${itemLabel}</span>
                <span class="item-qty">${qtyLabel}</span>
            </div>
            <button type="button" class="remove-btn" onclick="removeSelectedItem(${index})" title="Remove">×</button>
        `;
        container.appendChild(itemDiv);
    });
    
    container.style.display = selectedPromoItems.length ? 'flex' : 'none';
}

function refreshProductSelect() {
    const category = document.getElementById('f-category').value;
    const select = document.getElementById('f-product-select');
    select.innerHTML = '<option value="" selected>Select product (optional)</option>';
    const filtered = category === 'All Categories'
        ? productCatalog
        : productCatalog.filter(p => p.category === category);

    filtered.forEach(product => {
        const option = document.createElement('option');
        option.value = product.id;
        option.textContent = `${product.name}`;
        select.appendChild(option);
    });
}

function duplicateRow(btn) {
    const row = btn.closest('tr');
    btn.closest('.dropdown').classList.remove('open');
    const cells = row.querySelectorAll('td');
    const name = cells[0].querySelector('.promo-name').textContent + ' (copy)';
    showToast(`📋 Duplicated "${cells[0].querySelector('.promo-name').textContent}"`);
    // In a real app: POST to server
}

function deleteRow(btn) {
    const row = btn.closest('tr');
    const name = row.querySelector('.promo-name').textContent;
    btn.closest('.dropdown').classList.remove('open');
    if (!confirm(`Delete promotion "${name}"?`)) return;
    row.style.transition = 'opacity .3s, transform .3s';
    row.style.opacity = '0';
    row.style.transform = 'translateX(20px)';
    setTimeout(() => { row.remove(); updateStats(); filterTable(); }, 300);
    showToast(`🗑️ Deleted "${name}"`);
}

// ── Save (add/edit) ──
function savePromo() {
    const type      = document.getElementById('f-type').value;
    const name      = document.getElementById('f-name').value.trim();
    const code      = document.getElementById('f-code').value.trim().toUpperCase();
    const discount  = document.getElementById('f-discount').value.trim();
    const discountType = document.getElementById('f-discount-type').value;
    const minSpend  = document.getElementById('f-min-spend').value.trim();
    const freeShipping = document.getElementById('f-free-shipping').checked;
    const cat       = document.getElementById('f-category').value;
    const limit     = parseInt(document.getElementById('f-limit').value) || 0;
    const start     = document.getElementById('f-start').value.trim();
    const end       = document.getElementById('f-end').value.trim();
    const expiry    = document.getElementById('f-expiry').value.trim();
    const status    = document.getElementById('f-status').value;
    const items     = selectedPromoItems;

    const missing = [];
    if (!name) missing.push('Promotion Name');
    if (!discount) missing.push('Discount Amount');
    if (!start) missing.push('Start Date');
    if (!end) missing.push('End Date');
    if (missing.length > 0) {
        alert('Please complete the required fields: ' + missing.join(', '));
        return;
    }
    if (type === 'coupon' && !code) {
        alert('Promotion code is required for coupon promotions');
        return;
    }
    if (items.length === 0) {
        alert('Please add at least one product or category');
        return;
    }

    const discountValue = parseFloat(discount.replace(/[^0-9.-]/g, ''));
    const minSpendValue = parseFloat(minSpend.replace(/[^0-9.-]/g, '')) || 0;
    if (isNaN(discountValue)) {
        alert('Please enter a valid discount amount');
        return;
    }

    const payload = {
        type,
        name,
        code,
        discountValue,
        discountType,
        minSpend: minSpendValue,
        freeShipping,
        category: cat,
        limit,
        startDate: start,
        endDate: end,
        expiry,
        status,
        items: items.map(item => ({
            category: item.category,
            productId: item.product ? item.product.id : null,
            minQty: item.minQty || 0,
            maxQty: item.maxQty || 0
        }))
    };

    fetch('@Url.Action("SavePromotion", "Admin")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
    })
    .then(response => response.json())
    .then(result => {
        if (!result.success) {
            showToast(result.message || 'Failed to save promotion');
            return;
        }

        const catIcons = { 'Keyboard':'💾', 'Keycap':'🎨', 'Switch':'⚡', 'All Categories':'📦' };
        const icon = catIcons[cat] ?? '📦';
        const statusMap = { active:'✓ Active', scheduled:'📅 Scheduled', expired:'✕ Expired' };
        const statusClass = { active:'status-active', scheduled:'status-scheduled', expired:'status-expired' };
        const displayType = type === 'coupon' ? 'Coupon' : 'System';
        const itemSummary = items.length ? `<div class="product-summary">${items.length} item(s)</div>` : '';

        if (editingRow) {
            const cells = editingRow.querySelectorAll('td');
            cells[0].querySelector('.promo-name').textContent = name;
            cells[1].querySelector('.promo-code').textContent = code;
            cells[2].querySelector('.promo-type').textContent = displayType;
            cells[3].querySelector('.discount-val').textContent = discount;
            cells[4].innerHTML = `<span class="cat-badge">${icon} ${cat}</span>${itemSummary}`;
            cells[5].innerHTML = `<div class="date-range"><span>📅</span><span>${start} – ${end}</span></div>`;
            const sb = cells[6].querySelector('.status-badge');
            editingRow.dataset.type = type;
            editingRow.dataset.discountType = discountType;
            editingRow.dataset.minSpend = minSpend;
            editingRow.dataset.freeShipping = freeShipping;
            editingRow.dataset.expiry = expiry;
            editingRow.dataset.limit = limit;
            editingRow.dataset.items = JSON.stringify(items);
            sb.className = `status-badge ${statusClass[status]}`;
            sb.textContent = statusMap[status];
            editingRow.dataset.name   = name.toLowerCase();
            editingRow.dataset.code   = code.toLowerCase();
            editingRow.dataset.status = status;
            editingRow.dataset.cat    = cat;
            showToast(`✏️ Updated "${name}"`);
        } else {
            const tbody = document.getElementById('promo-body');
            const tr = document.createElement('tr');
            tr.dataset.name   = name.toLowerCase();
            tr.dataset.code   = code.toLowerCase();
            tr.dataset.status = status;
            tr.dataset.cat    = cat;
            tr.dataset.type   = type;
            tr.dataset.discountType = discountType;
            tr.dataset.minSpend = minSpend;
            tr.dataset.freeShipping = freeShipping;
            tr.dataset.expiry = expiry;
            tr.dataset.limit = limit;
            tr.dataset.items = JSON.stringify(items);
            tr.innerHTML = `
                <td><span class="promo-name">${name}</span></td>
                <td><span class="promo-code">${code}</span></td>
                <td><span class="promo-type">${displayType}</span></td>
                <td><span class="discount-val">${discount}</span></td>
                <td><span class="cat-badge">${icon} ${cat}</span>${itemSummary}</td>
                <td><div class="date-range"><span>📅</span><span>${start} – ${end}</span></div></td>
                <td><span class="status-badge ${statusClass[status]}">${statusMap[status]}</span></td>
                <td>
                    <div class="usage-wrap">
                        <span class="usage-text">0 / ${limit}</span>
                        <div class="usage-track"><div class="usage-fill" style="width:0%"></div></div>
                    </div>
                </td>
                <td class="action-cell">
                    <button class="btn-action" onclick="toggleDropdown(this)">•••</button>
                    <div class="dropdown">
                        <button onclick="editRow(this)">✏️ Edit</button>
                        <button onclick="duplicateRow(this)">📋 Duplicate</button>
                        <button class="danger" onclick="deleteRow(this)">🗑️ Delete</button>
                    </div>
                </td>`;
            tbody.appendChild(tr);
            showToast(`✅ Added "${name}"`);
        }

        updateStats();
        closeModal();
        filterTable();
    })
    .catch(error => {
        console.error(error);
        showToast('Failed to save promotion');
    });
}

// ── Update stat cards ──
function updateStats() {
    const rows = document.querySelectorAll('#promo-body tr');
    let total = 0, active = 0, used = 0, limit = 0;
    rows.forEach(r => {
        total++;
        if (r.dataset.status === 'active') active++;
        const ut = (r.querySelector('.usage-text') || { textContent: '0 / 0' }).textContent || '0 / 0';
        const [u, l] = ut.split('/').map(s => parseInt(s.trim()) || 0);
        used += u; limit += l;
    });
    document.getElementById('stat-total').textContent  = total;
    document.getElementById('stat-active').textContent = active;
    document.getElementById('stat-used').textContent   = used;
    document.getElementById('stat-avg').textContent    = (limit > 0 ? Math.round(used * 100 / limit) : 0) + '%';
}

// ── Show toast ──
function showToast(message) {
    const toast = document.getElementById('toast');
    toast.textContent = message;
    toast.style.display = 'block';
    setTimeout(() => { toast.style.display = 'none'; }, 3000);
}

filterTable();

function getSelectedProductCount() {
    return selectedPromoProducts.length;
}

function getSelectedProductNames() {
    return selectedPromoProducts.map(p => p.name);
}
</script>
