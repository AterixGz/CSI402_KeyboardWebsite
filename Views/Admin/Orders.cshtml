@using System.Text.Json
@model KeyboardWebsiteProject.Models.AdminOrdersViewModel
@{
    ViewData["Title"] = "Orders";
    Layout = "_AdminLayout";
}

<div class="page">

    <!-- ── Top bar ── -->
    <div class="topbar">
        <div>
            <h1>Orders</h1>
            <p>Manage and track customer orders</p>
        </div>
        <button class="export-btn" onclick="exportOrders()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Export Orders
        </button>
    </div>

    <!-- ── Stat Cards ── -->
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-icon si-blue">
                <svg width="22" height="22" fill="none" stroke="#2563eb" stroke-width="1.8" viewBox="0 0 24 24">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 001.95-1.57L23 6H6"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">Total Orders</div>
                <div class="stat-value">1,248</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-orange">
                <svg width="22" height="22" fill="none" stroke="#f97316" stroke-width="1.8" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">Pending</div>
                <div class="stat-value">42</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-blue">
                <svg width="22" height="22" fill="none" stroke="#2563eb" stroke-width="1.8" viewBox="0 0 24 24">
                    <rect x="1" y="3" width="15" height="13" rx="1.5"/>
                    <path d="M16 8h4l3 5v3h-7V8z"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">Shipping</div>
                <div class="stat-value">86</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-green">
                <svg width="22" height="22" fill="none" stroke="#10b981" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">Completed</div>
                <div class="stat-value">1,105</div>
            </div>
        </div>
    </div>

    <!-- ── Filter bar ── -->
    <div class="filter-bar">
        <div class="search-wrap">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
            <input type="text" id="searchInput" placeholder="Search orders by ID or customer..." oninput="filterTable()" />
        </div>

        <select class="filter-select" id="statusFilter" onchange="filterTable()">
            <option value="">All Status</option>
            <option value="Completed">Completed</option>
            <option value="Pending">Pending</option>
            <option value="Shipping">Shipping</option>
            <option value="Cancelled">Cancelled</option>
        </select>

        <select class="filter-select" id="timeFilter" onchange="filterTable()">
            <option value="">All Time</option>
            <option value="today">Today</option>
            <option value="week">This Week</option>
            <option value="month">This Month</option>
        </select>

        <button class="more-btn">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <line x1="4" y1="6" x2="20" y2="6"/>
                <line x1="8" y1="12" x2="16" y2="12"/>
                <line x1="11" y1="18" x2="13" y2="18"/>
            </svg>
            More Filters
        </button>
    </div>

    <!-- ── Table ── -->
    <div class="table-card">
        <div class="table-header">All Orders</div>
        <table>
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Products</th>
                    <th>Items</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="ordersTable"></tbody>
        </table>

        <!-- Pagination -->
        <div class="pagination">
            <span id="pageInfo">Showing 1–8 of 12 orders</span>
            <div class="page-btns">
                <button class="pb" id="prevBtn" onclick="changePage(-1)">‹</button>
                <button class="pb active" id="p1" onclick="goPage(1)">1</button>
                <button class="pb" id="p2" onclick="goPage(2)">2</button>
                <button class="pb" id="nextBtn" onclick="changePage(1)">›</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast" id="toast">Orders exported successfully!</div>

<script>
    const orders = @Html.Raw(JsonSerializer.Serialize(Model.Orders, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));

    const PER_PAGE = 8;
    let currentPage = 1;
    let filtered = [...orders];

    function initials(o) { return o.first[0] + o.last[0]; }

    function badgeCls(s) {
        if (s === 'Completed') return 'badge-completed';
        if (s === 'Pending')   return 'badge-pending';
        if (s === 'Shipping')  return 'badge-shipping';
        return 'badge-cancelled';
    }

    function badgeIcon(s) {
        if (s === 'Completed')
            return `<svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
        if (s === 'Pending')
            return `<svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`;
        if (s === 'Shipping')
            return `<svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="1.5"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>`;
        return `<svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`;
    }

    function renderTable() {
        const start = (currentPage - 1) * PER_PAGE;
        const page  = filtered.slice(start, start + PER_PAGE);
        document.getElementById('ordersTable').innerHTML = page.map(o => `
            <tr>
                <td class="order-id">${o.id}</td>
                <td>
                    <div class="cust-cell">
                        <div class="av ${o.color}">${initials(o)}</div>
                        <div>
                            <div class="cust-name">${o.first} ${o.last}</div>
                            <div class="cust-email">${o.email}</div>
                        </div>
                    </div>
                </td>
                <td class="products-cell">${o.products}</td>
                <td>${o.items}</td>
                <td class="amount-cell">฿${o.amount.toLocaleString('th-TH')}</td>
                <td><span class="badge ${badgeCls(o.status)}">${badgeIcon(o.status)} ${o.status}</span></td>
                <td>
                    <div class="date-main">${o.date}</div>
                    <div class="date-sub">${o.time}</div>
                </td>
                <td><button class="axbtn" title="Options">···</button></td>
            </tr>
        `).join('');

        const total = filtered.length;
        const end   = Math.min(start + PER_PAGE, total);
        document.getElementById('pageInfo').textContent =
            `Showing ${start + 1}–${end} of ${total} orders`;

        const pages = Math.ceil(total / PER_PAGE);
        document.getElementById('p1').classList.toggle('active', currentPage === 1);
        document.getElementById('p2').classList.toggle('active', currentPage === 2);
        document.getElementById('p2').style.display = pages >= 2 ? '' : 'none';
        document.getElementById('prevBtn').disabled = currentPage === 1;
        document.getElementById('nextBtn').disabled = currentPage >= pages;
    }

    function filterTable() {
        const q      = document.getElementById('searchInput').value.toLowerCase();
        const status = document.getElementById('statusFilter').value;

        filtered = orders.filter(o => {
            const matchQ = !q ||
                o.id.toLowerCase().includes(q) ||
                `${o.first} ${o.last}`.toLowerCase().includes(q) ||
                o.email.toLowerCase().includes(q) ||
                o.products.toLowerCase().includes(q);
            const matchS = !status || o.status === status;
            return matchQ && matchS;
        });

        currentPage = 1;
        renderTable();
    }

    function changePage(d) { currentPage = Math.max(1, currentPage + d); renderTable(); }
    function goPage(p)     { currentPage = p; renderTable(); }

    function exportOrders() {
        const t = document.getElementById('toast');
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2600);
    }

    renderTable();
</script>
