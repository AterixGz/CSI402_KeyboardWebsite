@using System.Linq
@using System.Text.Json
@model KeyboardWebsiteProject.Models.AdminRolesViewModel

@{
    ViewData["Title"] = "Roles & Admin Management";
    Layout = "_AdminLayout";
}

<div class="page">

    <!-- ── Top bar ── -->
    <div class="topbar">
        <div>
            <h1>Roles &amp; Admin Management</h1>
            <p>Manage admin roles and user permissions</p>
        </div>
        <button class="create-btn" onclick="openCreateModal()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Create Role
        </button>
    </div>

    <!-- ── Stat cards ── -->
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-icon si-blue">
                <svg width="22" height="22" fill="none" stroke="#2563eb" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
            </div>
            <div>
                <div class="stat-value" id="statTotalRoles">@Model.Roles.Count</div>
                <div class="stat-label">Total Roles</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-green">
                <svg width="22" height="22" fill="none" stroke="#16a34a" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
                </svg>
            </div>
            <div>
                <div class="stat-value">@Model.AdminUsers.Count</div>
                <div class="stat-label">Total Admins</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-green">
                <svg width="22" height="22" fill="none" stroke="#16a34a" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <polyline points="9 12 11 14 15 10"/>
                </svg>
            </div>
            <div>
                <div class="stat-value">@Model.AdminUsers.Count</div>
                <div class="stat-label">Active Admins</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-red">
                <svg width="22" height="22" fill="none" stroke="#dc2626" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
            </div>
            <div>
                <div class="stat-value">@Model.AdminUsers.Count(u => u.RoleName == "Admin")</div>
                <div class="stat-label">Admin Accounts</div>
            </div>
        </div>
    </div>

    <!-- ── Tabs ── -->
    <div class="tabs">
        <div class="tab active" onclick="switchTab('roles', this)">Roles</div>
        <div class="tab" onclick="switchTab('admins', this)">Admin Users</div>
        <div class="tab" onclick="switchTab('permissions', this)">Permissions</div>
    </div>

    <!-- ── ROLES PANEL ── -->
    <div class="tab-panel active" id="panel-roles">
        <div class="search-wrap">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
            <input type="text" id="roleSearch" placeholder="Search roles..." oninput="filterRoles()" />
        </div>

        <div class="roles-grid" id="rolesGrid"></div>
    </div>

    <!-- ── ADMIN USERS PANEL ── -->
    <div class="tab-panel" id="panel-admins">
        <div class="table-card">
            <div class="table-toolbar">
                <div class="search-wrap">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
                    </svg>
                    <input type="text" placeholder="Search admins..." id="adminSearch" oninput="filterAdmins()" />
                </div>
                <button class="invite-btn" type="button" onclick="openInviteModal()">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                        <path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                        <circle cx="8.5" cy="7" r="4"/>
                        <line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
                    </svg>
                    Invite Admin
                </button>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Admin</th>
                        <th>Role</th>
                        <th>Last Active</th>
                        <th>Joined</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="adminsTable"></tbody>
            </table>
        </div>
    </div>

    <!-- ── PERMISSIONS PANEL ── -->
    <div class="tab-panel" id="panel-permissions">
        <!-- ── Permissions Table ── -->
        <div class="permissions-card">
            <div class="permissions-table-wrapper">
                <table class="permissions-table">
                    <thead id="permissionsTableHead"></thead>
                    <tbody id="permissionsTableBody"></tbody>
                </table>
            </div>
            <div class="permissions-actions">
                <button class="submit-btn" onclick="savePermissions()">Confirm & Save Permissions</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Permissions Modal ── -->
<div class="modal-overlay" id="permModal" onclick="closePermOutside(event)">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title" id="permModalTitle">Permissions</div>
            <button class="modal-close" onclick="closePermModal()">✕</button>
        </div>
        <div id="permModalBody"></div>
    </div>
</div>

<!-- ── Invite Admin Modal ── -->
<div class="modal-overlay" id="inviteModal" onclick="closeInviteOutside(event)">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">Invite Admin</div>
            <button class="modal-close" onclick="closeInviteModal()">✕</button>
        </div>
        <div class="mrow one">
            <div class="fg"><label>Email address</label><input type="email" id="inviteEmail" placeholder="admin@example.com" /></div>
        </div>
        <div class="mrow one">
            <div class="fg"><label>Select role</label><select id="inviteRole">
                <option value="">Choose role</option>
                @foreach (var role in Model.Roles.Where(r => r.RoleId != 4))
                {
                    <option value="@role.RoleId">@role.Name</option>
                }
            </select></div>
        </div>
        <div class="mrow one">
            <div class="fg"><label>Message (optional)</label><textarea id="inviteMessage" placeholder="Add a note or instructions..."></textarea></div>
        </div>
        <div class="modal-footer" style="justify-content:flex-end;">
            <button class="cancel-btn" onclick="closeInviteModal()">Cancel</button>
            <button class="submit-btn" type="button" onclick="sendInvite()">Send Invite</button>
        </div>
    </div>
</div>

<!-- ── Edit Admin Modal ── -->
<div class="modal-overlay" id="editAdminModal" onclick="closeEditAdminOutside(event)">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">Edit Admin</div>
            <button class="modal-close" onclick="closeEditAdminModal()">✕</button>
        </div>
        <input type="hidden" id="editUserId" />
        <div class="mrow one">
            <div class="fg"><label>Email</label><input type="email" id="editUserEmail" disabled /></div>
        </div>
        <div class="mrow one">
            <div class="fg"><label>Role</label><select id="editUserRole">
                <option value="">Choose role</option>
                @foreach (var role in Model.Roles.Where(r => r.RoleId != 4))
                {
                    <option value="@role.RoleId">@role.Name</option>
                }
            </select></div>
        </div>
        <div class="modal-footer" style="justify-content:flex-end;">
            <button class="cancel-btn" onclick="closeEditAdminModal()">Cancel</button>
            <button class="submit-btn" type="button" onclick="saveAdminEdit()">Save Changes</button>
        </div>
    </div>
</div>

<!-- ── Create Role Modal ── -->
<div class="modal-overlay" id="createModal" onclick="closeCreateOutside(event)">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">Create New Role</div>
            <button class="modal-close" onclick="closeCreateModal()">✕</button>
        </div>
        <div class="mrow one">
            <div class="fg"><label>Role Name</label><input type="text" id="crName" placeholder="e.g. Marketing Manager" /></div>
        </div>
        <div class="mrow one">
            <div class="fg"><label>Background Color</label><select id="crColor">
                    <option value="ri-blue">Blue</option>
                    <option value="ri-green">Green</option>
                    <option value="ri-red">Red</option>
                    <option value="ri-orange">Orange</option>
                    <option value="ri-gray">Gray</option>
                </select></div>
        </div>
        <div class="modal-footer">
            <button class="cancel-btn" onclick="closeCreateModal()">Cancel</button>
            <button class="submit-btn" onclick="createRole()">Create Role</button>
        </div>
    </div>
</div>

<!-- ── Edit Role Mockup Modal ── -->
<div class="modal-overlay" id="editRoleModal" onclick="closeEditRoleOutside(event)">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">Edit Role</div>
            <button class="modal-close" onclick="closeEditRoleModal()">✕</button>
        </div>
        <input type="hidden" id="editRoleId" />
        <div class="mrow one">
            <div class="fg"><label>Role Name</label><input type="text" id="editRoleName" placeholder="Enter role name" /></div>
        </div>
        <div class="modal-footer" style="justify-content:flex-end;">
            <button class="cancel-btn" onclick="closeEditRoleModal()">Cancel</button>
            <button class="submit-btn" type="button" onclick="saveRoleEdit()">Save</button>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast" id="toast">Action completed successfully!</div>

<script>
    /* ── DATA ── */
    const currentUserId = @(ViewContext.HttpContext.Session.GetInt32("UserId") ?? 0);
    const roles = @Html.Raw(JsonSerializer.Serialize(Model.Roles, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
    const admins = @Html.Raw(JsonSerializer.Serialize(Model.AdminUsers, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
    const permissions = @Html.Raw(JsonSerializer.Serialize(Model.Permissions, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));

    let filteredRoles = [...roles];
    let filteredAdmins = [...admins];

    /* ── Render Roles ── */
    function getRoleIconClass(name) {
        return name.toLowerCase() === 'admin' ? 'ri-red'
            : name.toLowerCase() === 'marketing' ? 'ri-blue'
            : name.toLowerCase() === 'stockmanager' ? 'ri-green'
            : name.toLowerCase() === 'customer' ? 'ri-orange'
            : 'ri-gray';
    }

    function getRoleDescription(name) {
        return name.toLowerCase() === 'admin' ? 'Full access to all system pages and settings'
            : name.toLowerCase() === 'marketing' ? 'Manage promotions and marketing workflows'
            : name.toLowerCase() === 'stockmanager' ? 'Monitor inventory and stock status'
            : name.toLowerCase() === 'customer' ? 'Customer account with order access only'
            : 'Role permissions and visibility';
    }

    function shieldIcon(stroke) {
        return `<svg width="20" height="20" fill="none" stroke="${stroke}" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`;
    }

    function renderRoles() {
        document.getElementById('rolesGrid').innerHTML = filteredRoles.map((r, i) => `
            <div class="role-card">
                <div class="role-card-top">
                    <div class="role-icon-name">
                        <div class="role-icon ${r.icon || getRoleIconClass(r.name)}">${shieldIcon('#000')}</div>
                        <div>
                            <div class="role-name">${r.name}</div>
                        </div>
                    </div>
                    <div class="role-card-menu" onclick="event.stopPropagation()">
                        <button class="role-menu-btn" type="button" onclick="toggleRoleMenu(${r.roleId})">···</button>
                        <div class="role-menu-dropdown" id="roleMenu-${r.roleId}">
                            <button type="button" class="role-menu-item" onclick="openEditRoleModal(${r.roleId})">Edit</button>
                            <button type="button" class="role-menu-item delete-btn" onclick="deleteRoleMock(${r.roleId})">Delete</button>
                        </div>
                    </div>
                </div>
                <div class="role-card-footer">
                    <div class="role-users">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
                        </svg>
                        ${r.userCount} users
                    </div>
                </div>
            </div>
        `).join('');
    }

    function filterRoles() {
        const q = document.getElementById('roleSearch').value.toLowerCase();
        filteredRoles = roles.filter(r => {
            const desc = getRoleDescription(r.name) || '';
            return r.name.toLowerCase().includes(q) || desc.toLowerCase().includes(q);
        });
        renderRoles();
    }

    /* ── Render Admins ── */
    function renderAdmins() {
        document.getElementById('adminsTable').innerHTML = filteredAdmins.map(a => `
            <tr>
                <td>
                    <div class="user-cell">
                        <div class="av ${a.avatarClass}">${a.initials}</div>
                        <div>
                            <div class="u-name">${a.firstName} ${a.lastName}</div>
                            <div class="u-email">${a.email}</div>
                        </div>
                    </div>
                </td>
                <td><span class="role-tag ${a.tagClass}">${a.roleName}</span></td>
                <td style="color:var(--text-muted);font-size:13px">${a.lastActive}</td>
                <td style="color:var(--text-muted);font-size:13px">${a.joinedAt}</td>
                <td>
                    <button class="axbtn action-btn" type="button" ${a.isOnlyAdmin ? 'disabled title="Cannot change role for the only Admin user"' : 'onclick="openEditAdminModal(' + a.userId + ')"'}>Edit</button>
                    <button class="axbtn delete-btn" type="button" ${a.userId === currentUserId ? 'disabled title="Cannot delete yourself"' : 'onclick="deleteAdminMock(' + a.userId + ')"'}>Delete</button>
                </td>
            </tr>
        `).join('');
    }

    function filterAdmins() {
        const q = document.getElementById('adminSearch').value.toLowerCase();
        filteredAdmins = admins.filter(a =>
            `${a.firstName} ${a.lastName} ${a.email} ${a.roleName}`.toLowerCase().includes(q)
        );
        renderAdmins();
    }

    /* ── Tabs ── */
    function switchTab(tab, el) {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        el.classList.add('active');
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        document.getElementById('panel-' + tab).classList.add('active');
    }

    /* ── Permissions Modal ── */
    function openPermModal(idx) {
        const role = roles[idx];
        document.getElementById('permModalTitle').textContent = `${role.name} — Permissions`;
        const rolePermissions = permissions.filter(p => p.roleIds.includes(role.roleId));
        let body = '';

        if (!rolePermissions.length) {
            body = '<div class="perm-section"><p>No permissions assigned to this role.</p></div>';
        } else {
            body = rolePermissions.map(p => `
                <div class="perm-item">
                    <div class="perm-name">${p.permissionName}</div>
                    <div class="perm-check perm-yes">
                        <svg width="12" height="12" fill="none" stroke="#16a34a" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                </div>
            `).join('');
        }

        document.getElementById('permModalBody').innerHTML = `<div class="perm-section"><h3>Assigned permissions</h3>${body}</div>`;
        document.getElementById('permModal').classList.add('open');
    }
    function closePermModal()         { document.getElementById('permModal').classList.remove('open'); }
    function closePermOutside(e)      { if (e.target === document.getElementById('permModal')) closePermModal(); }

    /* ── Create Role Modal ── */
    function openCreateModal()        { document.getElementById('createModal').classList.add('open'); }
    function closeCreateModal()       { document.getElementById('createModal').classList.remove('open'); }
    function closeCreateOutside(e)    { if (e.target === document.getElementById('createModal')) closeCreateModal(); }

    function createRole() {
        const name  = document.getElementById('crName').value.trim();
        const color = document.getElementById('crColor').value;
        if (!name) return;

        fetch('/Admin/CreateRole', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name })
        })
        .then(async res => {
            const result = await res.json();
            if (res.ok && result?.success) {
                showToast(result.message || 'Role created successfully.');
                closeCreateModal();
                setTimeout(() => location.reload(), 800);
            } else {
                showToast(result?.message || 'Failed to create role.');
            }
        })
        .catch(() => {
            showToast('Failed to create role.');
        });
    }

    function savePermissions() {
        const confirmed = confirm('ยืนยันการบันทึกการเปลี่ยนแปลงสิทธิ์สำหรับทุก Role ใช่หรือไม่?');
        if (!confirmed) return;

        const assignments = roles.map(role => {
            const permissionIds = Array.from(document.querySelectorAll(`.permission-check[data-role-id='${role.roleId}']`))
                .filter(cb => cb.checked)
                .map(cb => Number(cb.dataset.permissionId));

            return { roleId: role.roleId, permissionIds };
        });

        fetch('/Admin/UpdateRolePermissions', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ assignments })
        })
        .then(res => res.json())
        .then(result => {
            if (result?.success) {
                showToast('Permissions updated successfully!');
            } else {
                showToast(result?.message || 'Failed to save permissions.');
            }
        })
        .catch(() => {
            showToast('Failed to save permissions.');
        });
    }

    function showToast(msg) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2600);
    }

    function openInviteModal() {
        document.getElementById('inviteModal').classList.add('open');
        document.getElementById('inviteEmail').focus();
    }

    function closeInviteModal() {
        document.getElementById('inviteModal').classList.remove('open');
    }

    function closeInviteOutside(e) {
        if (e.target === document.getElementById('inviteModal')) {
            closeInviteModal();
        }
    }

    function openEditAdminModal(userId) {
        const admin = admins.find(a => a.userId === userId);
        if (!admin) {
            showToast('Admin user not found.');
            return;
        }

        if (admin.isOnlyAdmin) {
            showToast('Cannot change role for the only Admin user.');
            return;
        }

        document.getElementById('editUserId').value = admin.userId;
        document.getElementById('editUserEmail').value = admin.email;
        document.getElementById('editUserRole').value = roles.find(r => r.name.toLowerCase() === admin.roleName.toLowerCase())?.roleId || '';
        document.getElementById('editAdminModal').classList.add('open');
    }

    function closeEditAdminModal() {
        document.getElementById('editAdminModal').classList.remove('open');
    }

    function closeEditAdminOutside(e) {
        if (e.target === document.getElementById('editAdminModal')) {
            closeEditAdminModal();
        }
    }

    function saveAdminEdit() {
        const userId = parseInt(document.getElementById('editUserId').value, 10);
        const roleId = parseInt(document.getElementById('editUserRole').value, 10);

        if (!userId || !roleId) {
            showToast('Please select a valid role.');
            return;
        }

        const role = roles.find(r => r.roleId === roleId);
        if (!role) {
            showToast('Unable to save admin details.');
            return;
        }

        fetch('/Admin/UpdateAdminRole', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId, roleId })
        })
        .then(async res => {
            const result = await res.json();
            if (res.ok && result?.success) {
                const admin = admins.find(a => a.userId === userId);
                if (admin) {
                    admin.roleName = role.name;
                    admin.tagClass = role.name.trim().toLowerCase() === 'admin' ? 'rt-red'
                        : role.name.trim().toLowerCase() === 'marketing' ? 'rt-blue'
                        : role.name.trim().toLowerCase() === 'stockmanager' ? 'rt-green'
                        : role.name.trim().toLowerCase() === 'customer' ? 'rt-orange'
                        : 'rt-gray';
                    admin.avatarClass = role.name.trim().toLowerCase() === 'admin' ? 'av-blue'
                        : role.name.trim().toLowerCase() === 'marketing' ? 'av-green'
                        : role.name.trim().toLowerCase() === 'stockmanager' ? 'av-teal'
                        : role.name.trim().toLowerCase() === 'customer' ? 'av-orange'
                        : 'av-purple';
                }
                renderAdmins();
                closeEditAdminModal();
                showToast(result.message || 'Admin role updated successfully.');
            } else {
                showToast(result?.message || 'Failed to update admin role.');
            }
        })
        .catch(() => {
            showToast('Failed to update admin role.');
        });
    }

    function deleteAdminMock(userId) {
        if (userId === currentUserId) {
            showToast('You cannot delete yourself.');
            return;
        }

        const admin = admins.find(a => a.userId === userId);
        if (!admin) {
            showToast('Admin user not found.');
            return;
        }

        const confirmed = confirm(`Delete admin ${admin.email}?`);
        if (!confirmed) return;

        const index = admins.findIndex(a => a.userId === userId);
        if (index >= 0) {
            admins.splice(index, 1);
            filteredAdmins = filteredAdmins.filter(a => a.userId !== userId);
            renderAdmins();
            showToast('Admin user deleted.');
        }
    }

    function sendInvite() {
        const email = document.getElementById('inviteEmail').value.trim();
        const roleId = document.getElementById('inviteRole').value;
        const message = document.getElementById('inviteMessage').value.trim();

        if (!email || !roleId) {
            showToast('Please enter an email and select a role.');
            return;
        }

        fetch('/Admin/InviteAdmin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, roleId: Number(roleId), message })
        })
        .then(async res => {
            const text = await res.text();
            try {
                const result = JSON.parse(text);
                if (res.ok && result?.success) {
                    showToast(result.message || `Invitation processed for ${email}`);
                    closeInviteModal();
                    setTimeout(() => location.reload(), 900);
                } else {
                    showToast(result?.message || 'Failed to invite admin.');
                }
            } catch (err) {
                showToast('Unexpected server response.');
                console.error('InviteAdmin response parse error:', err, text);
            }
        })
        .catch(error => {
            console.error('InviteAdmin fetch error:', error);
            showToast('Failed to send invite.');
        });
    }

    function openEditRoleModal(roleId) {
        const role = roles.find(r => r.roleId === roleId);
        if (!role) {
            showToast('Role not found.');
            return;
        }

        closeAllRoleMenus();
        document.getElementById('editRoleId').value = role.roleId;
        document.getElementById('editRoleName').value = role.name;
        document.getElementById('editRoleModal').classList.add('open');
    }

    function closeEditRoleModal() {
        document.getElementById('editRoleModal').classList.remove('open');
    }

    function closeEditRoleOutside(e) {
        if (e.target === document.getElementById('editRoleModal')) {
            closeEditRoleModal();
        }
    }

    function toggleRoleMenu(roleId) {
        closeAllRoleMenus();
        const menu = document.getElementById(`roleMenu-${roleId}`);
        if (menu) {
            menu.classList.toggle('open');
        }
    }

    function closeAllRoleMenus() {
        document.querySelectorAll('.role-menu-dropdown.open').forEach(menu => menu.classList.remove('open'));
    }

    document.addEventListener('click', closeAllRoleMenus);

    function saveRoleEdit() {
        const roleId = parseInt(document.getElementById('editRoleId').value, 10);
        const roleName = document.getElementById('editRoleName').value.trim();

        if (!roleId || !roleName) {
            showToast('Please enter a valid role name.');
            return;
        }

        fetch('/Admin/UpdateRole', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ roleId, name: roleName })
        })
        .then(async res => {
            const result = await res.json();
            if (res.ok && result?.success) {
                showToast(result.message || 'Role updated successfully.');
                closeEditRoleModal();
                setTimeout(() => location.reload(), 800);
            } else {
                showToast(result?.message || 'Failed to update role.');
            }
        })
        .catch(() => {
            showToast('Failed to update role.');
        });
    }

    function deleteRoleMock(roleId) {
        const role = roles.find(r => r.roleId === roleId);
        if (!role) {
            showToast('Role not found.');
            return;
        }

        const confirmed = confirm(`Delete role ${role.name}?`);
        if (!confirmed) return;

        fetch('/Admin/DeleteRole', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ roleId })
        })
        .then(async res => {
            const result = await res.json();
            if (res.ok && result?.success) {
                showToast(result.message || 'Role deleted successfully.');
                setTimeout(() => location.reload(), 800);
            } else {
                showToast(result?.message || 'Failed to delete role.');
            }
        })
        .catch(() => {
            showToast('Failed to delete role.');
        });
    }

    function prettyMenuName(code) {
        const mapping = {
            products: 'Products',
            orders: 'Orders',
            users: 'Users',
            settings: 'Settings',
            promotions: 'Promotions',
            customers: 'Customers',
            general: 'General'
        };
        return mapping[code.toLowerCase()] || code.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
    }

    /* ── Render Permissions ── */
    function renderPermissions() {
        document.getElementById('permissionsTableHead').innerHTML = `
            <tr>
                <th>Page / Feature</th>
                ${roles.map(r => `
                    <th class="role-header">
                        <div class="role-name">${r.name}</div>
                    </th>
                `).join('')}
            </tr>
        `;

        let rows = '';
        let currentMenu = '';

        permissions.forEach(p => {
            const menu = p.menuCode || 'general';
            if (menu !== currentMenu) {
                currentMenu = menu;
                rows += `<tr class="permission-group"><td colspan="${roles.length + 1}" class="permission-group-label">${prettyMenuName(menu)}</td></tr>`;
            }

            rows += `
                <tr>
                    <td class="feature-name">${p.permissionName}</td>
                    ${roles.map(role => `
                        <td>
                            <input type="checkbox" class="permission-check" data-role-id="${role.roleId}" data-permission-id="${p.permissionId}" ${p.roleIds.includes(role.roleId) ? 'checked' : ''} />
                        </td>
                    `).join('')}
                </tr>
            `;
        });

        document.getElementById('permissionsTableBody').innerHTML = rows;
    }

    /* ── Init ── */
    renderRoles();
    renderAdmins();
    renderPermissions();
</script>
