@{
    ViewData["Title"] = "Products";
    Layout = "_AdminLayout";
}

<div class="page">

    <!-- ── Top bar ── -->
    <div class="topbar">
        <div>
            <h1>Products</h1>
            <p>Manage your keyboard and keycap inventory</p>
        </div>
        <button class="add-btn" onclick="openModal()">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Add Product
        </button>
    </div>

    <!-- ── Stat cards ── -->
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-icon si-blue">
                <svg width="22" height="22" fill="none" stroke="#2563eb" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">Total Products</div>
                <div class="stat-value" id="statTotal">@ViewBag.TotalProducts</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-green">
                <svg width="22" height="22" fill="none" stroke="#16a34a" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">In Stock</div>
                <div class="stat-value">@ViewBag.InStockCount</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-orange">
                <svg width="22" height="22" fill="none" stroke="#ea580c" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">Low Stock</div>
                <div class="stat-value">@ViewBag.LowStockCount</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-red">
                <svg width="22" height="22" fill="none" stroke="#dc2626" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
            </div>
            <div>
                <div class="stat-label">Out of Stock</div>
                <div class="stat-value">@ViewBag.OutOfStockCount</div>
            </div>
        </div>
    </div>

    <!-- ── Filter bar ── -->
    <div class="filter-bar">
        <div class="search-wrap">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
            <input type="text" id="searchInput" placeholder="Search products..." oninput="filterTable()" />
        </div>

        <select class="filter-select" id="catFilter" onchange="filterTable()">
            <option value="">All Categories</option>
            @{
                var categories = ViewBag.Categories as List<string>;
                if (categories != null)
                {
                    foreach (var category in categories)
                    {
                        <option value="@category">@category</option>
                    }
                }
            }
        </select>

        <select class="filter-select" id="statusFilter" onchange="filterTable()">
            <option value="">All Status</option>
            <option value="In Stock">In Stock</option>
            <option value="Low Stock">Low Stock</option>
            <option value="Out of Stock">Out of Stock</option>
        </select>

        <div class="filter-bar-right">
            <button class="icon-btn">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/>
                </svg>
                More Filters
            </button>
            <button class="icon-btn" onclick="exportProducts()">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                Export
            </button>
        </div>
    </div>

    <!-- ── Table card ── -->
    <div class="table-card">
        <div class="table-header">All Products</div>
        <table>
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="productsTable"></tbody>
        </table>

        <div class="pagination">
            <span id="pageInfo">Showing 1–8 of 14 products</span>
            <div class="page-btns">
                <button class="pb" id="prevBtn" onclick="changePage(-1)">‹</button>
                <button class="pb active" id="p1" onclick="goPage(1)">1</button>
                <button class="pb" id="p2" onclick="goPage(2)">2</button>
                <button class="pb" id="nextBtn" onclick="changePage(1)">›</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Add Product Modal ── -->
<div class="modal-overlay" id="modalOverlay" onclick="closeModalOutside(event)">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">Add New Product</div>
            <button class="modal-close" onclick="closeModal()">✕</button>
        </div>
        <div class="mrow one">
            <div class="fg"><label>Product Name</label><input type="text" id="mName" placeholder="e.g. Keychron K2 Pro" /></div>
        </div>
        <div class="mrow two">
            <div class="fg"><label>SKU</label><input type="text" id="mSku" placeholder="e.g. KB-K2P-001" /></div>
            <div class="fg">
                <label>Category</label>
                <select id="mCat">
                    <option value="Mechanical Keyboard">Mechanical Keyboard</option>
                    <option value="Custom Keyboard">Custom Keyboard</option>
                    <option value="Keycaps">Keycaps</option>
                    <option value="Switches">Switches</option>
                    <option value="Accessories">Accessories</option>
                </select>
            </div>
        </div>
        <div class="mrow two">
            <div class="fg"><label>Price (฿)</label><input type="number" id="mPrice" placeholder="0" min="0" /></div>
            <div class="fg"><label>Stock Quantity</label><input type="number" id="mStock" placeholder="0" min="0" /></div>
        </div>
        <div class="mrow one">
            <div class="fg"><label>Description (optional)</label><textarea id="mDesc" placeholder="Brief product description..."></textarea></div>
        </div>
        <div class="modal-footer">
            <button class="cancel-btn" onclick="closeModal()">Cancel</button>
            <button class="submit-btn" onclick="addProduct()">Add Product</button>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast" id="toast">Product added successfully!</div>

<!-- ── Edit Product Modal ── -->
<div class="modal-overlay" id="editModalOverlay" onclick="closeEditModal(event)">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">Edit Product</div>
            <button class="modal-close" onclick="closeEditModal()">✕</button>
        </div>
        <div class="mrow one">
            <div class="fg"><label>Product Name</label><input type="text" id="eName" placeholder="e.g. Keychron K2 Pro" /></div>
        </div>
        <div class="mrow two">
            <div class="fg"><label>Brand</label><input type="text" id="eBrand" placeholder="e.g. Keychron" /></div>
            <div class="fg">
                <label>Category</label>
                <select id="eCat">
                    <option value="Mechanical Keyboard">Mechanical Keyboard</option>
                    <option value="Custom Keyboard">Custom Keyboard</option>
                    <option value="Keycaps">Keycaps</option>
                    <option value="Switches">Switches</option>
                    <option value="Accessories">Accessories</option>
                </select>
            </div>
        </div>
        <div class="mrow two">
            <div class="fg"><label>Price (฿)</label><input type="number" id="ePrice" placeholder="0" min="0" /></div>
            <div class="fg"><label>Stock Quantity</label><input type="number" id="eStock" placeholder="0" min="0" /></div>
        </div>
        <div class="mrow one">
            <div class="fg"><label>Image URL</label><input type="text" id="eImage" placeholder="~/image/product.png" /></div>
        </div>
        <div class="mrow one">
            <div class="fg"><label>Description (optional)</label><textarea id="eDesc" placeholder="Brief product description..."></textarea></div>
        </div>
        <div class="modal-footer">
            <button class="cancel-btn" onclick="closeEditModal()">Cancel</button>
            <button class="delete-btn" onclick="deleteProduct()" style="margin-right: auto;">Delete Product</button>
            <button class="submit-btn" onclick="updateProduct()">Save Changes</button>
        </div>
    </div>
</div>



<script>
    // รับข้อมูลจาก Model ที่ส่งมาจาก Controller
    const products = @Html.Raw(Json.Serialize(Model ?? new List<KeyboardWebsiteProject.Models.Product>()));

    const PER_PAGE = 8;
    let currentPage = 1;
    let filtered = [...products];

    function getStatus(stock) {
        if (stock === 0) return 'Out of Stock';
        if (stock <= 10) return 'Low Stock';
        return 'In Stock';
    }

    function statusCls(stock) {
        if (stock === 0) return 'badge-out';
        if (stock <= 10) return 'badge-low';
        return 'badge-instock';
    }

    function renderTable() {
        const start = (currentPage - 1) * PER_PAGE;
        const page  = filtered.slice(start, start + PER_PAGE);

        document.getElementById('productsTable').innerHTML = page.map(p => `
            <tr>
                <td>
                    <div class="prod-cell">
                        <div class="prod-thumb">
                            <img src="${p.imageUrl}" alt="${p.name}" style="width: 40px; height: 40px; object-fit: cover; border-radius: 6px;" />
                        </div>
                        <div>
                            <div class="prod-name">${p.name}</div>
                            <div class="prod-sub">Product ID: ${p.productId}</div>
                        </div>
                    </div>
                </td>
                <td class="sku-cell">SKU-${p.productId}</td>
                <td class="cat-cell">${p.categoryName || 'Uncategorized'}</td>
                <td class="price-cell">฿${p.price.toLocaleString('th-TH')}</td>
                <td class="stock-cell">${p.stockQuantity}</td>
                <td><span class="badge ${statusCls(p.stockQuantity)}">${getStatus(p.stockQuantity)}</span></td>
                <td class="action-cell">
                    <button class="btn-action" onclick="toggleDropdown(this)" data-product='${JSON.stringify(p)}'>•••</button>
                    <div class="dropdown">
                        <button onclick="editProduct(this)">✏️ Edit</button>
                        <button class="danger" onclick="deleteProductAction(this)">🗑️ Delete</button>
                    </div>
                </td>
            </tr>
        `).join('');

        const total = filtered.length;
        const end   = Math.min(start + PER_PAGE, total);
        document.getElementById('pageInfo').textContent =
            `Showing ${start + 1}–${end} of ${total} products`;

        const pages = Math.ceil(total / PER_PAGE);
        document.getElementById('p1').classList.toggle('active', currentPage === 1);
        document.getElementById('p2').classList.toggle('active', currentPage === 2);
        document.getElementById('p2').style.display = pages >= 2 ? '' : 'none';
        document.getElementById('prevBtn').disabled = currentPage === 1;
        document.getElementById('nextBtn').disabled = currentPage >= pages;
    }

    function filterTable() {
        const q   = document.getElementById('searchInput').value.toLowerCase();
        const cat = document.getElementById('catFilter').value;
        const st  = document.getElementById('statusFilter').value;

        filtered = products.filter(p => {
            const pStatus = getStatus(p.stockQuantity);
            const matchQ  = !q  || p.name.toLowerCase().includes(q);
            const matchC  = !cat || p.categoryName === cat;
            const matchS  = !st || pStatus === st;
            return matchQ && matchC && matchS;
        });

        currentPage = 1;
        renderTable();
    }

    function changePage(d) { currentPage = Math.max(1, currentPage + d); renderTable(); }
    function goPage(p)     { currentPage = p; renderTable(); }

    // ── Modal ──
    function openModal()  { document.getElementById('modalOverlay').classList.add('open'); }
    function closeModal() { document.getElementById('modalOverlay').classList.remove('open'); }
    function closeModalOutside(e) { if (e.target === document.getElementById('modalOverlay')) closeModal(); }

    function addProduct() {
        const name  = document.getElementById('mName').value.trim();
        const sku   = document.getElementById('mSku').value.trim();
        const price = parseFloat(document.getElementById('mPrice').value) || 0;
        const stock = parseInt(document.getElementById('mStock').value) || 0;
        
        if (!name || !sku) {
            alert('Please fill in all required fields');
            return;
        }

        // เพิ่มข้อมูลลงใน array ในหน้า (ในจริงควรส่งไปบันทึกลงฐานข้อมูล)
        products.unshift({ 
            productId: Math.max(...products.map(p => p.productId)) + 1,
            name, 
            price, 
            stockQuantity: stock,
            imageUrl: '~/image/default.png'
        });
        
        document.getElementById('statTotal').textContent = products.length;
        filterTable();
        closeModal();
        ['mName','mSku','mPrice','mStock','mDesc'].forEach(id => document.getElementById(id).value = '');

        const toast = document.getElementById('toast');
        toast.textContent = 'Product added successfully!';
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2600);
    }

    function exportProducts() {
        const toast = document.getElementById('toast');
        toast.textContent = 'Products exported successfully!';
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2600);
    }

    // ── Action Menu Toggle ──
    let currentEditProduct = null;

    function toggleDropdown(btn) {
        const dd = btn.nextElementSibling;
        const isOpen = dd.classList.contains('open');
        document.querySelectorAll('.dropdown.open').forEach(d => d.classList.remove('open'));
        if (!isOpen) {
            dd.classList.add('open');
            currentEditProduct = JSON.parse(btn.dataset.product);
        }
    }

    function editProduct(btn) {
        btn.closest('.dropdown').classList.remove('open');
        openEditModal();
    }

    function deleteProductAction(btn) {
        btn.closest('.dropdown').classList.remove('open');
        deleteProductQuick();
    }

    function openEditModal() {
        if (!currentEditProduct) return;
        
        document.getElementById('eName').value = currentEditProduct.name || '';
        document.getElementById('eBrand').value = currentEditProduct.brandName || '';
        document.getElementById('eCat').value = currentEditProduct.categoryName || '';
        document.getElementById('ePrice').value = currentEditProduct.price || '';
        document.getElementById('eStock').value = currentEditProduct.stockQuantity || '';
        document.getElementById('eImage').value = currentEditProduct.imageUrl || '';
        document.getElementById('eDesc').value = currentEditProduct.description || '';
        
        document.getElementById('editModalOverlay').classList.add('open');
    }

    function closeEditModal(event) {
        if (event && event.target !== document.getElementById('editModalOverlay')) return;
        document.getElementById('editModalOverlay').classList.remove('open');
        currentEditProduct = null;
    }

    function updateProduct() {
        if (!currentEditProduct) return;

        const name = document.getElementById('eName').value.trim();
        const price = parseFloat(document.getElementById('ePrice').value) || 0;
        const stock = parseInt(document.getElementById('eStock').value) || 0;

        if (!name) {
            alert('Please fill in product name');
            return;
        }

        // Update local array
        const idx = products.findIndex(p => p.productId === currentEditProduct.productId);
        if (idx !== -1) {
            products[idx] = {
                ...products[idx],
                name: name,
                brandName: document.getElementById('eBrand').value.trim(),
                categoryName: document.getElementById('eCat').value,
                price: price,
                stockQuantity: stock,
                imageUrl: document.getElementById('eImage').value.trim(),
                description: document.getElementById('eDesc').value.trim()
            };
        }

        filterTable();
        closeEditModal();

        const toast = document.getElementById('toast');
        toast.textContent = 'Product updated successfully!';
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2600);
    }

    function deleteProductQuick() {
        if (confirm('Are you sure you want to delete this product?')) {
            deleteProduct();
        }
    }

    function deleteProduct() {
        if (!currentEditProduct) return;

        if (!confirm('Are you sure you want to delete this product? This action cannot be undone.')) {
            return;
        }

        products = products.filter(p => p.productId !== currentEditProduct.productId);
        document.getElementById('statTotal').textContent = products.length;
        
        filterTable();
        closeEditModal();

        const toast = document.getElementById('toast');
        toast.textContent = 'Product deleted successfully!';
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2600);
    }

    // Close dropdowns when clicking outside
    document.addEventListener('click', e => {
        if (!e.target.classList.contains('btn-action'))
            document.querySelectorAll('.dropdown.open').forEach(d => d.classList.remove('open'));
    });

    renderTable();
</script>
