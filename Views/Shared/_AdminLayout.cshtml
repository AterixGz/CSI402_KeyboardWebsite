@{
    ViewData["Title"] = ViewData["Title"] ?? "Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KeyCraft - @ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" />
    @if (ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard")
    {
        <link rel="stylesheet" href="~/css/Admin/Dashboard.css" />
    }
    @if (ViewContext.RouteData.Values["action"]?.ToString() == "Settings")
    {
        <link rel="stylesheet" href="~/css/Admin/Settings.css" />
    }
    @if (ViewContext.RouteData.Values["action"]?.ToString() == "Customers")
    {
        <link rel="stylesheet" href="~/css/Admin/Customers.css" />
    }
    @if (ViewContext.RouteData.Values["action"]?.ToString() == "Orders")
    {
        <link rel="stylesheet" href="~/css/Admin/Orders.css" />
    }
    @if (ViewContext.RouteData.Values["action"]?.ToString() == "Products")
    {
        <link rel="stylesheet" href="~/css/Admin/Products.css" />
    }
    @if (ViewContext.RouteData.Values["action"]?.ToString() == "Roles")
    {
        <link rel="stylesheet" href="~/css/Admin/Roles.css" />
    }
    @if (ViewContext.RouteData.Values["action"]?.ToString() == "Promotions")
    {
        <link rel="stylesheet" href="~/css/Admin/Promotions.css" />
    }
</head>
<body>

<!-- SIDEBAR -->
<aside class="sidebar">
    <div class="sidebar-logo">
        <div class="logo-wrapper">
            <img src="~/image/Brand.png" alt="KeyCraft" class="logo-image" />
            <span class="admin-badge">Admin</span>
        </div>
    </div>
    <nav>
        <a asp-controller="Admin" asp-action="Dashboard" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
            <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M3 4a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H4a1 1 0 01-1-1V4zm8 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V4zM3 12a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H4a1 1 0 01-1-1v-4zm8 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
            Dashboard
        </a>
        <a asp-controller="Admin" asp-action="Customers" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Customers" ? "active" : "")">
            <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
            Customers
        </a>
        <a asp-controller="Admin" asp-action="Orders" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Orders" ? "active" : "")">
            <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4zM18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z"/></svg>
            Orders
        </a>
        <a asp-controller="Admin" asp-action="Products" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "active" : "")">
            <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4z" clip-rule="evenodd"/></svg>
            Products
        </a>
        <a asp-controller="Admin" asp-action="Categories" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Categories" ? "active" : "")">
            <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M4 3a1 1 0 00-1 1v3h14V4a1 1 0 00-1-1H4zm0 6v7a1 1 0 001 1h10a1 1 0 001-1V9H4zm2 2h2v3H6v-3zm4 0h2v3h-2v-3z"/></svg>
            Categories
        </a>
        <a asp-controller="Admin" asp-action="Promotions" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Promotions" ? "active" : "")">
            <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4z" clip-rule="evenodd"/></svg>
            Promotions
        </a>
        <a asp-controller="Admin" asp-action="Roles" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Roles" ? "active" : "")">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="6.5"/><path d="M21 2l-9.6 9.6"/><path d="M15.5 7.5l3 3"/></svg>
            Roles
        </a>
        <a asp-controller="Admin" asp-action="Settings" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")">
            <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
            Settings
        </a>
    </nav>
    <div class="sidebar-bottom">
        <div class="user-profile">
            <div class="user-avatar">AD</div>
            <div class="user-info">
                <div class="name">Admin User</div>
                <div class="email">admin@KeyCraft.com</div>
            </div>
        </div>
        <a asp-controller="Home" asp-action="Index" class="exit-admin">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h7v-2H4V6h6V4H3zm10.293 2.293a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 01-1.414-1.414L14.586 11H8a1 1 0 110-2h6.586l-1.293-1.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                Home Page
        </a>
    </div>
</aside>

<!-- MAIN CONTENT -->
<main class="main">
    @RenderBody()
</main>

</body>
</html>
