@{
    ViewData["Title"] = "โปรไฟล์ของฉัน";

    // ── Users (authentication data) ────────────────────────────────────
    dynamic user = ViewBag.User ?? new {
        UserId       = 0,
        RoleName     = "สมาชิก",
        Username     = "",
        Email        = "",
        Phone        = ""
    };

    // ── User_Profiles (profile data) ───────────────────────────────────
    dynamic profile = ViewBag.Profile ?? new {
        ProfileId   = 0,
        FirstName   = "สมาชิก",
        LastName    = "ใหม่",
        DisplayName = "",
        BirthDate   = (DateTime?)null,
        AvatarUrl   = "",
        Bio         = ""
    };

    // ── Stats ──────────────────────────────────────────────────────────
    int orderCount  = ViewBag.OrderCount ?? 0;
    int wishCount   = ViewBag.WishCount ?? 0;
    int addressCount = ViewBag.AddressCount ?? 0;

    // ── User_Addresses ─────────────────────────────────────────────────
    var addresses = ViewBag.Addresses as IEnumerable<dynamic> ?? Array.Empty<dynamic>();

    // ── Wishlists (from database) ─────────────────────────────────────
    var wishlists = ViewBag.Wishlists as IEnumerable<dynamic> ?? Array.Empty<dynamic>();

    // ── Reviews (Mock Data from Reviews table) ──────────────────────────
    var reviews = new dynamic[]
    {
        new {
            ReviewId = 1,
            ProductName = "Delux Pro RGB Mechanical Keyboard",
            Rating = 5,
            Comment = "คีย์บอร์ดแปลกดีมาก ฟิลดี มีไฟ RGB เพิ่มอีกหนึ่งคุณค่า ส่งเร็วด้วย",
            ReviewDate = "10 มี.ค. 2569",
            Helpful = 24
        },
        new {
            ReviewId = 2,
            ProductName = "Cherry MX Switch 3 Pack",
            Rating = 4,
            Comment = "สวิตช์คุณภาพดี ราคาไม่แพง อยากได้สีอื่นอีก",
            ReviewDate = "5 มี.ค. 2569",
            Helpful = 12
        },
        new {
            ReviewId = 3,
            ProductName = "GMK Oceanic Keycap Set",
            Rating = 5,
            Comment = "วัสดุดี สีสวย เหมาะสำหรับผู้ที่ชอบสี ocean blue",
            ReviewDate = "1 มี.ค. 2569",
            Helpful = 8
        },
    };


    // ── Recent Orders ──────────────────────────────────────────────────
    var orders = ViewBag.RecentOrders as IEnumerable<dynamic> ?? Array.Empty<dynamic>();

    // ── Helpers ────────────────────────────────────────────────────────
    string FullName(dynamic p) {
        var fn = (string)(p.FirstName ?? "");
        var ln = (string)(p.LastName  ?? "");
        return (fn + " " + ln).Trim();
    }

    string DisplayText(dynamic value)
    {
        var text = value as string;
        return string.IsNullOrWhiteSpace(text) ? "ไม่มีข้อมูล" : text;
    }

    string DisplayLabel(dynamic p) {
        var dn = p.DisplayName as string;
        if (!string.IsNullOrWhiteSpace(dn)) return dn;

        var fn = p.FirstName as string;
        var ln = p.LastName as string;
        if (!string.IsNullOrWhiteSpace(fn) || !string.IsNullOrWhiteSpace(ln))
        {
            return ($"{fn} {ln}").Trim();
        }

        return "ไม่มีข้อมูล";
    }

    string Initials(dynamic p) {
        var fn = p.FirstName as string ?? string.Empty;
        var ln = p.LastName as string ?? string.Empty;
        if (fn.Length > 0 && ln.Length > 0) return $"{fn[0]}{ln[0]}";
        if (fn.Length > 0) return fn[0].ToString();
        if (ln.Length > 0) return ln[0].ToString();
        return "?";
    }

    string StatusLabel(string s) => s switch {
        "delivered" => "จัดส่งแล้ว",
        "shipping"  => "กำลังจัดส่ง",
        "pending"   => "รอดำเนินการ",
        "cancelled" => "ยกเลิก",
        _           => s
    };

    string StatusClass(string s) => s switch {
        "delivered" => "delivered",
        "shipping"  => "shipping",
        "pending"   => "pending",
        "cancelled" => "cancelled",
        _           => ""
    };

    string StatusIcon(string s) => s switch {
        "delivered" => "✓",
        "shipping"  => "⟳",
        "pending"   => "⏱",
        "cancelled" => "✕",
        _           => "•"
    };

    var menuItems = new[]
    {
        new { Icon = "", Label = "ข้อมูลส่วนตัว",       Count = 0,           Href = "#info-card" },
        new { Icon = "", Label = "คำสั่งซื้อของฉัน", Count = orderCount,  Href = "#orders"    },
        new { Icon = "", Label = "รายการโปรด",        Count = wishCount,   Href = "#wishlist"  },
        new { Icon = "", Label = "ที่อยู่จัดส่ง",     Count = addressCount,Href = "#addresses" },
        new { Icon = "", Label = "รีวิวของฉัน",        Count = 0,           Href = "#reviews"   },
        new { Icon = "", Label = "ตั้งค่าบัญชี",      Count = 0,           Href = "#settings"  },
    };
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – KEYMECH</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&family=DM+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Account/Profile.css" />
</head>
<body>

<!-- Toast -->
<div class="toast" id="toast"></div>

<div class="page">
    <div class="layout">

        <!-- ══ LEFT COLUMN ══════════════════════════════════════════════ -->
        <div class="left-col">
            <div class="card" style="margin-bottom:20px;">

                <!-- Avatar + name -->
                <div class="profile-card">
                    <div class="avatar-wrap">
                        <div class="avatar" id="avatar-display">
                            @if (!string.IsNullOrEmpty((string)profile.AvatarUrl))
                            {
                                <img src="@profile.AvatarUrl" alt="avatar" />
                            }
                            else
                            {
                                @Initials(profile)
                            }
                        </div>
                        <label class="avatar-edit-btn" for="avatar-input" title="เปลี่ยนรูปโปรไฟล์">✏️</label>
                        <input type="file" id="avatar-input" accept="image/*" style="display:none"
                               onchange="previewAvatar(this)" />
                    </div>

                    <!-- display_name หรือ first_name + last_name -->
                    <div class="profile-name" id="display-name">@DisplayLabel(profile)</div>

                    <!-- username + role จาก Users + Roles -->
                    <div class="profile-meta">
                        <span class="profile-username">@DisplayText(user.Username)</span>
                        <span class="role-badge">@user.RoleName</span>
                    </div>

                    @if (!string.IsNullOrEmpty((string)profile.Bio))
                    {
                        <div class="profile-bio">@profile.Bio</div>
                    }
                </div>

                <!-- Stats row (Orders + Wishlist) -->
                <div class="stats-row">
                    <div class="stat-item">
                        <div class="stat-num">@orderCount</div>
                        <div class="stat-label">คำสั่งซื้อ</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-num">@wishCount</div>
                        <div class="stat-label">รายการโปรด</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-num">@addressCount</div>
                        <div class="stat-label">ที่อยู่</div>
                    </div>
                </div>

                <!-- Side menu -->
                <div class="side-menu">
                    @foreach (var item in menuItems)
                    {
                        var sectionId = item.Href.TrimStart('#');
                        <a class="menu-item" href="javascript:void(0)" onclick="switchSection('@sectionId'); this.parentElement.querySelectorAll('.menu-item').forEach(el => el.style.background = ''); this.style.background = '#f0f0f0'; return false;">
                            <span class="menu-icon">@item.Icon</span>
                            <span class="menu-label">@item.Label</span>
                            @if (item.Count > 0)
                            {
                                <span class="menu-count">@item.Count</span>
                            }
                            <span class="menu-arrow">›</span>
                        </a>
                    }
                </div>

                <!-- Logout -->
                <div class="logout-row">
                    <button class="btn-logout" onclick="confirmLogout()">
                        <span>↪</span>
                        <span>ออกจากระบบ</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- ══ RIGHT COLUMN ══════════════════════════════════════════════ -->
        <div class="right-col">

            <!-- ── Personal Info (Users + User_Profiles) ─────────────── -->
            <div class="card section-card content-section" id="info-card">
                <div class="section-header">
                    <span class="section-title">ข้อมูลส่วนตัว</span>
                    <button class="btn-edit" onclick="toggleEdit('info')">แก้ไข</button>
                </div>

                <!-- Display mode -->
                <div class="info-grid" id="info-display">
                    <!-- จาก User_Profiles -->
                    <div class="info-item">
                        <div class="info-label">ชื่อจริง</div>
                        <div class="info-value" id="iv-firstname">@DisplayText(profile.FirstName)</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">นามสกุล</div>
                        <div class="info-value" id="iv-lastname">@DisplayText(profile.LastName)</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">ชื่อที่แสดง (Display Name)</div>
                        <div class="info-value" id="iv-displayname">
                            @DisplayText(profile.DisplayName)
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">วันเกิด</div>
                        <div class="info-value" id="iv-birthdate">
                            @(profile.BirthDate != null
                                ? ((DateTime)profile.BirthDate).ToString("dd MMM yyyy")
                                : "ไม่มีข้อมูล")
                        </div>
                    </div>
                    <!-- จาก Users -->
                    <div class="info-item">
                        <div class="info-label">ชื่อผู้ใช้ (Username)</div>
                        <div class="info-value" id="iv-username">@DisplayText(user.Username)</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">อีเมล</div>
                        <div class="info-value" id="iv-email">@DisplayText(user.Email)</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">เบอร์โทรศัพท์</div>
                        <div class="info-value" id="iv-phone">@DisplayText(user.Phone)</div>
                    </div>
                    <!-- Bio ยาว full width -->
                    <div class="info-item info-item--full">
                        <div class="info-label">Bio</div>
                        <div class="info-value" id="iv-bio" style="white-space:pre-line;">
                            @DisplayText(profile.Bio)
                        </div>
                    </div>
                </div>

                <!-- Edit form -->
                <div class="edit-form" id="edit-form-info">
                    <div class="edit-grid">
                        <div class="field">
                            <label>ชื่อจริง <span class="req">*</span></label>
                            <input id="ef-firstname" type="text" value="@profile.FirstName" />
                        </div>
                        <div class="field">
                            <label>นามสกุล <span class="req">*</span></label>
                            <input id="ef-lastname" type="text" value="@profile.LastName" />
                        </div>
                        <div class="field">
                            <label>ชื่อที่แสดง (Display Name)</label>
                            <input id="ef-displayname" type="text" value="@profile.DisplayName"
                                   placeholder="ปล่อยว่างเพื่อใช้ชื่อ-นามสกุล" />
                        </div>
                        <div class="field">
                            <label>วันเกิด</label>
                            <input id="ef-birthdate" type="date"
                                   value="@(profile.BirthDate != null ? ((DateTime)profile.BirthDate).ToString("yyyy-MM-dd") : "")" />
                        </div>
                        <div class="field">
                            <label>Username</label>
                            <input id="ef-username" type="text" value="@user.Username" />
                        </div>
                        <div class="field">
                            <label>อีเมล <span class="req">*</span></label>
                            <input id="ef-email" type="email" value="@user.Email" />
                        </div>
                        <div class="field">
                            <label>เบอร์โทรศัพท์</label>
                            <input id="ef-phone" type="tel" value="@user.Phone" />
                        </div>
                        <div class="field field--full">
                            <label>Bio</label>
                            <textarea id="ef-bio" rows="3">@profile.Bio</textarea>
                        </div>
                    </div>
                    <div class="edit-actions">
                        <button class="btn-cancel-edit" onclick="toggleEdit('info')">ยกเลิก</button>
                        <button class="btn-save" onclick="saveInfo()">บันทึก</button>
                    </div>
                </div>
            </div>

            <!-- ── User_Addresses ─────────────────────────────────────── -->
            <div class="card section-card content-section" id="addresses" style="display:none;">
                <div class="section-header">
                    <span class="section-title">ที่อยู่จัดส่ง</span>
                    <button class="btn-edit" onclick="toggleEdit('addr')">+ เพิ่มที่อยู่</button>
                </div>

                @if (!addresses.Any())
                {
                    <div class="empty-state">
                        <span class="empty-icon">📍</span>
                        <p>ยังไม่มีที่อยู่จัดส่ง</p>
                    </div>
                }
                else
                {
                    @foreach (var addr in addresses)
                    {
                        <div class="address-row @(addr.IsDefault ? "address-row--default" : "")">
                            <div class="address-body">
                                <div class="address-receiver">
                                    @addr.ReceiverName
                                    @if (addr.IsDefault)
                                    {
                                        <span class="default-badge">ค่าเริ่มต้น</span>
                                    }
                                </div>
                                <div class="address-phone">@addr.PhoneNumber</div>
                                <div class="address-line">
                                    @{ 
                                        var addressParts = new List<string>();
                                        var line1 = addr.AddressLine1 as string;
                                        var subDistrict = addr.SubDistrict as string;
                                        var district = addr.District as string;
                                        var province = addr.Province as string;
                                        var postal = addr.PostalCode as string;

                                        if (!string.IsNullOrWhiteSpace(line1)) addressParts.Add(line1);
                                        if (!string.IsNullOrWhiteSpace(subDistrict)) addressParts.Add(subDistrict);
                                        if (!string.IsNullOrWhiteSpace(district)) addressParts.Add(district);

                                        var provincePostal = string.Empty;
                                        if (!string.IsNullOrWhiteSpace(province)) provincePostal = province;
                                        if (!string.IsNullOrWhiteSpace(postal)) provincePostal = string.IsNullOrWhiteSpace(provincePostal)
                                            ? postal
                                            : $"{provincePostal} {postal}";

                                        if (!string.IsNullOrWhiteSpace(provincePostal)) addressParts.Add(provincePostal);
                                    }
                                    @string.Join(", ", addressParts)
                                </div>
                            </div>
                            <div class="address-actions">
                                <button class="btn-text" type="button"
                                    onclick="openEditAddressModal(this)"
                                    data-addressid="@addr.AddressId"
                                    data-receiver="@addr.ReceiverName"
                                    data-phone="@addr.PhoneNumber"
                                    data-line1="@addr.AddressLine1"
                                    data-subdistrict="@addr.SubDistrict"
                                    data-district="@addr.District"
                                    data-province="@addr.Province"
                                    data-postal="@addr.PostalCode"
                                    data-default="@(addr.IsDefault.ToString().ToLower())">
                                    แก้ไข
                                </button>
                                @if (!addr.IsDefault)
                                {
                                    <button class="btn-text btn-text--muted" type="button"
                                        onclick="setDefaultAddress(@addr.AddressId, this)">
                                        ตั้งเป็นค่าเริ่มต้น
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }

                <!-- Add address form -->
                <div class="edit-form" id="edit-form-addr">
                    <div class="edit-grid">
                        <div class="field">
                            <label>ชื่อผู้รับ <span class="req">*</span></label>
                            <input id="af-receiver" type="text" placeholder="ชื่อ-นามสกุลผู้รับ" />
                        </div>
                        <div class="field">
                            <label>เบอร์โทรผู้รับ <span class="req">*</span></label>
                            <input id="af-phone" type="tel" placeholder="0xx-xxx-xxxx" />
                        </div>
                        <div class="field field--full">
                            <label>บ้านเลขที่ / ถนน / ซอย <span class="req">*</span></label>
                            <input id="af-line1" type="text" placeholder="เช่น 123/4 ถ.สุขุมวิท" />
                        </div>
                        <div class="field">
                            <label>แขวง / ตำบล <span class="req">*</span></label>
                            <input id="af-subdistrict" type="text" />
                        </div>
                        <div class="field">
                            <label>เขต / อำเภอ <span class="req">*</span></label>
                            <input id="af-district" type="text" />
                        </div>
                        <div class="field">
                            <label>จังหวัด <span class="req">*</span></label>
                            <input id="af-province" type="text" />
                        </div>
                        <div class="field">
                            <label>รหัสไปรษณีย์ <span class="req">*</span></label>
                            <input id="af-postal" type="text" maxlength="5" />
                        </div>
                        <div class="field field--full">
                            <label class="checkbox-label">
                                <input id="af-default" type="checkbox" />
                                ตั้งเป็นที่อยู่ค่าเริ่มต้น
                            </label>
                        </div>
                    </div>
                    <div class="edit-actions">
                        <button class="btn-cancel-edit" onclick="toggleEdit('addr')">ยกเลิก</button>
                        <button class="btn-save" onclick="saveAddress()">บันทึกที่อยู่</button>
                    </div>
                </div>
            </div>

            <!-- Edit address popup -->
            <div id="addressEditModal" class="modal-overlay" style="display:none;">
                <div class="modal-box">
                    <div class="section-header" style="padding: 16px 20px; margin-bottom: 10px;">
                        <span class="section-title">แก้ไขที่อยู่จัดส่ง</span>
                        <button class="modal-close-btn" type="button" onclick="closeEditAddressModal()">✕</button>
                    </div>
                    <div class="edit-form open" style="padding: 0 20px 20px; border: none; box-shadow: none;">
                        <input type="hidden" id="em-address-id" />
                        <div class="edit-grid">
                            <div class="field">
                                <label>ชื่อผู้รับ <span class="req">*</span></label>
                                <input id="em-receiver" type="text" placeholder="ชื่อ-นามสกุลผู้รับ" />
                            </div>
                            <div class="field">
                                <label>เบอร์โทรผู้รับ <span class="req">*</span></label>
                                <input id="em-phone" type="tel" placeholder="0xx-xxx-xxxx" />
                            </div>
                            <div class="field field--full">
                                <label>บ้านเลขที่ / ถนน / ซอย <span class="req">*</span></label>
                                <input id="em-line1" type="text" placeholder="เช่น 123/4 ถ.สุขุมวิท" />
                            </div>
                            <div class="field">
                                <label>แขวง / ตำบล <span class="req">*</span></label>
                                <input id="em-subdistrict" type="text" />
                            </div>
                            <div class="field">
                                <label>เขต / อำเภอ <span class="req">*</span></label>
                                <input id="em-district" type="text" />
                            </div>
                            <div class="field">
                                <label>จังหวัด <span class="req">*</span></label>
                                <input id="em-province" type="text" />
                            </div>
                            <div class="field">
                                <label>รหัสไปรษณีย์ <span class="req">*</span></label>
                                <input id="em-postal" type="text" maxlength="5" />
                            </div>
                            <div class="field field--full">
                                <label class="checkbox-label">
                                    <input id="em-default" type="checkbox" />
                                    ตั้งเป็นที่อยู่ค่าเริ่มต้น
                                </label>
                            </div>
                        </div>
                        <div id="em-error" class="field-error" style="display:none; margin-top: 10px;"></div>
                        <div class="edit-actions" style="margin-top: 16px;">
                            <button class="btn-cancel-edit" type="button" onclick="closeEditAddressModal()">ยกเลิก</button>
                            <button class="btn-save" type="button" onclick="saveEditedAddress()">บันทึกการเปลี่ยนแปลง</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Wishlist ──────────────────────────────────────────── -->
            <div class="card content-section" id="wishlist" style="display:none;">
                <div class="section-header">
                    <span class="section-title">รายการโปรด</span>
                    <span style="font-size: 12px; color: #6b7280;">@wishlists.Count() รายการ</span>
                </div>

                @if (!wishlists.Any())
                {
                    <div class="empty-state">
                        <span class="empty-icon">🤍</span>
                        <p>ยังไม่มีรายการโปรด</p>
                    </div>
                }
                else
                {
                    <div style="padding: 16px 22px;">
                        @foreach (var wish in wishlists)
                        {
                            <div class="wishlist-item" data-product-id="@wish.ProductId" style="display: grid; grid-template-columns: 80px 1fr auto; gap: 14px; padding: 14px 0; border-bottom: 1px solid #e5e7eb; align-items: center;">
                                <!-- Image -->
                                <div style="width: 80px; height: 80px; background: #f9fafb; border-radius: 8px; overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <img src="@(wish.ImageUrl ?? "~/image/default.png")" alt="@wish.ProductName" style="width:100%; height:100%; object-fit:cover;" />
                                </div>
                                
                                <!-- Info -->
                                <div>
                                    <div style="font-weight: 600; font-size: 14px; margin-bottom: 4px;">@wish.ProductName</div>
                                    <div style="color: #6b7280; font-size: 12px; margin-bottom: 6px;">@wish.Category</div>
                                    <div>
                                        <span style="font-weight: 700; color: #1f2937;">฿@wish.Price.ToString("N0")</span>
                                        @if (!wish.InStock)
                                        {
                                            <span style="margin-left: 8px; background: #fee2e2; color: #dc2626; font-size: 10px; padding: 2px 8px; border-radius: 20px;">สินค้าหมด</span>
                                        }
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div style="display: flex; flex-direction: column; gap: 6px;">
                                    <button onclick="addToCartFromWishlist(@wish.ProductId, this)" style="background: #16a34a; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; font-family: inherit;">
                                        🛒 เพิ่มลงตะกร้า
                                    </button>
                                    <button onclick="removeFromWishlist(@wish.ProductId, this)" style="background: #fee2e2; color: #dc2626; border: none; padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; font-family: inherit;">
                                        ลบออก
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- ── Reviews ───────────────────────────────────────────── -->
            <div class="card content-section" id="reviews" style="display:none;">
                <div class="section-header">
                    <span class="section-title">รีวิวของฉัน</span>
                    <span style="font-size: 12px; color: #6b7280;">@reviews.Count() รายการ</span>
                </div>

                @if (!reviews.Any())
                {
                    <div class="empty-state">
                        <span class="empty-icon">⭐</span>
                        <p>ยังไม่มีรีวิว</p>
                    </div>
                }
                else
                {
                    <div style="padding: 0;">
                        @foreach (var review in reviews)
                        {
                            <div style="padding: 18px 22px; border-bottom: 1px solid #e5e7eb;">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
                                    <div>
                                        <div style="font-weight: 700; font-size: 14px;">@review.ProductName</div>
                                        <div style="color: #6b7280; font-size: 12px; margin-top: 2px;">@review.ReviewDate</div>
                                    </div>
                                    <div style="text-align: right;">
                                        <div style="font-size: 14px; font-weight: 700;">
                                            @for (int i = 0; i < review.Rating; i++)
                                            {
                                                <span style="color: #ca8a04;">⭐</span>
                                            }
                                            @for (int i = review.Rating; i < 5; i++)
                                            {
                                                <span style="color: #d1d5db;">⭐</span>
                                            }
                                        </div>
                                        <span style="font-size: 11px; color: #6b7280;">(@review.Rating/5)</span>
                                    </div>
                                </div>
                                <div style="color: #374151; font-size: 13px; line-height: 1.5; margin-bottom: 10px;">
                                    @review.Comment
                                </div>
                                <div style="display: flex; gap: 12px; font-size: 12px; color: #6b7280;">
                                    <button style="background: none; border: none; color: #2563eb; cursor: pointer; padding: 0; font-family: inherit; font-weight: 500;" onclick="alert('❤️ ขอบคุณสำหรับความเห็น')">👍 ประโยชน์ (@review.Helpful)</button>
                                    <button style="background: none; border: none; color: #dc2626; cursor: pointer; padding: 0; font-family: inherit; font-weight: 500;" onclick="alert('✏️ แก้ไขรีวิว')">แก้ไข</button>
                                    <button style="background: none; border: none; color: #dc2626; cursor: pointer; padding: 0; font-family: inherit; font-weight: 500;" onclick="alert('🗑️ ลบรีวิว')">ลบ</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- ── Settings ──────────────────────────────────────────── -->
            <div class="card content-section" id="settings" style="display:none;">
                <div class="section-header">
                    <span class="section-title">ตั้งค่าบัญชี</span>
                </div>

                <div style="padding: 24px 22px;">
                    <!-- Notification Settings -->
                    <div style="margin-bottom: 28px;">
                        <div style="font-weight: 700; font-size: 14px; margin-bottom: 12px;">📬 การแจ้งเตือน</div>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                                <input type="checkbox" checked style="width: 18px; height: 18px; cursor: pointer;" />
                                <span style="font-size: 14px;">รับการแจ้งเตือนเกี่ยวกับคำสั่งซื้อ</span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                                <input type="checkbox" checked style="width: 18px; height: 18px; cursor: pointer;" />
                                <span style="font-size: 14px;">รับการแจ้งเตือนเกี่ยวกับส่วนลด & โปรโมชั่น</span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                                <input type="checkbox" style="width: 18px; height: 18px; cursor: pointer;" />
                                <span style="font-size: 14px;">رับอีเมลข่าวสาร</span>
                            </label>
                        </div>
                    </div>

                    <!-- Privacy Settings -->
                    <div style="margin-bottom: 28px; padding-top: 20px; border-top: 1px solid #e5e7eb;">
                        <div style="font-weight: 700; font-size: 14px; margin-bottom: 12px;">🔒 ความเป็นส่วนตัว</div>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                                <input type="checkbox" checked style="width: 18px; height: 18px; cursor: pointer;" />
                                <span style="font-size: 14px;">อนุญาตให้คนอื่นเห็นโปรไฟล์ของฉัน</span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                                <input type="checkbox" style="width: 18px; height: 18px; cursor: pointer;" />
                                <span style="font-size: 14px;">อนุญาตให้แสดงรีวิวของฉันแบบสาธารณะ</span>
                            </label>
                        </div>
                    </div>

                    <!-- Account Settings -->
                    <div style="margin-bottom: 28px; padding-top: 20px; border-top: 1px solid #e5e7eb;">
                        <div style="font-weight: 700; font-size: 14px; margin-bottom: 12px;">⚙️ บัญชี</div>
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <button onclick="alert('🔐 เปลี่ยนรหัสผ่าน')" style="text-align: left; background: none; border: 1px solid #e5e7eb; padding: 10px 12px; border-radius: 6px; cursor: pointer; font-family: inherit; color: #1f2937; transition: background 0.15s;">
                                🔐 เปลี่ยนรหัสผ่าน
                            </button>
                            <button onclick="alert('⚠️ ยืนยันการเชื่อมต่อ 2FA')" style="text-align: left; background: none; border: 1px solid #e5e7eb; padding: 10px 12px; border-radius: 6px; cursor: pointer; font-family: inherit; color: #1f2937; transition: background 0.15s;">
                                ✅ ยืนยันตัวตน 2FA (ยังไม่เปิด)
                            </button>
                            <button onclick="alert('⚠️ การลบบัญชี')" style="text-align: left; background: none; border: 1px solid #fee2e2; padding: 10px 12px; border-radius: 6px; cursor: pointer; font-family: inherit; color: #dc2626; transition: background 0.15s;">
                                🗑️ ลบบัญชี
                            </button>
                        </div>
                    </div>

                    <div style="padding-top: 20px; border-top: 1px solid #e5e7eb; font-size: 12px; color: #6b7280;">
                        <strong>เวอร์ชันแอปพลิเคชัน:</strong> 1.0.0 | <strong>อัปเดตครั้งล่าสุด:</strong> 1 เม.ย. 2569
                    </div>
                </div>
            </div>

            <!-- ── Orders (recent) ────────────────────────────────────── -->
            <div class="card content-section" id="orders" style="display:none;">
                <div class="orders-header">
                    <span class="orders-title">คำสั่งซื้อล่าสุด</span>
                    <a class="view-all" href="#">ดูทั้งหมด ›</a>
                </div>

                @foreach (var order in orders)
                {
                    <div class="order-row" onclick="window.location.href='#order-@order.OrderId'">
                        <div class="order-icon">📦</div>
                        <div class="order-meta">
                            <div class="order-id">@order.OrderId</div>
                            <div class="order-date">
                                @order.OrderDate · @order.ItemCount รายการ
                                @if (!string.IsNullOrEmpty((string)order.CouponCode))
                                {
                                    <span class="coupon-tag">🏷 @order.CouponCode</span>
                                }
                            </div>
                        </div>
                        <div class="order-right">
                            @if ((decimal)order.DiscountAmount > 0)
                            {
                                <div class="order-subtotal">฿@order.Subtotal.ToString("N0")</div>
                            }
                            <div class="order-price">฿@order.TotalAmount.ToString("N0")</div>
                            <span class="status-badge @StatusClass(order.Status)">
                                @StatusIcon(order.Status) @StatusLabel(order.Status)
                            </span>
                        </div>
                    </div>
                }
            </div>

        </div><!-- /right-col -->
    </div><!-- /layout -->
</div><!-- /page -->

<script>
// ── Switch Sections (Tabs) ──────────────────────────────────────────────────
function switchSection(sectionId) {
    // Hide all content sections
    const sections = document.querySelectorAll('.content-section');
    sections.forEach(sec => sec.style.display = 'none');
    
    // Show selected section
    const selected = document.getElementById(sectionId);
    if (selected) {
        selected.style.display = 'block';
        // Scroll to top of the section
        selected.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
}

// Set initial section on page load
document.addEventListener('DOMContentLoaded', function() {
    // Show info section by default
    switchSection('info-card');
    // Highlight first menu item
    const firstMenuItem = document.querySelector('.menu-item');
    if (firstMenuItem) {
        firstMenuItem.style.background = '#f0f0f0';
    }
});

// ── Toggle edit panels ──────────────────────────────────────────────────────
function toggleEdit(key) {
    const id = key === 'info' ? 'edit-form-info' : 'edit-form-addr';
    const form = document.getElementById(id);
    form.classList.toggle('open');
}

// ── Save personal info (User_Profiles + Users) ──────────────────────────────
function saveInfo() {
    const firstName   = document.getElementById('ef-firstname').value.trim();
    const lastName    = document.getElementById('ef-lastname').value.trim();
    const displayName = document.getElementById('ef-displayname').value.trim();
    const birthdate   = document.getElementById('ef-birthdate').value;
    const username    = document.getElementById('ef-username').value.trim();
    const email       = document.getElementById('ef-email').value.trim();
    const phone       = document.getElementById('ef-phone').value.trim();
    const bio         = document.getElementById('ef-bio').value.trim();

    if (!firstName || !lastName || !email) {
        alert('กรุณากรอกชื่อจริง นามสกุล และอีเมลให้ครบถ้วน');
        return;
    }

    // Update display values
    document.getElementById('iv-firstname').textContent   = firstName || 'ไม่มีข้อมูล';
    document.getElementById('iv-lastname').textContent    = lastName || 'ไม่มีข้อมูล';
    document.getElementById('iv-displayname').textContent = displayName || 'ไม่มีข้อมูล';
    document.getElementById('iv-username').textContent    = username || 'ไม่มีข้อมูล';
    document.getElementById('iv-email').textContent       = email || 'ไม่มีข้อมูล';
    document.getElementById('iv-phone').textContent       = phone || 'ไม่มีข้อมูล';
    document.getElementById('iv-bio').textContent         = bio || 'ไม่มีข้อมูล';

    if (birthdate) {
        const d = new Date(birthdate);
        document.getElementById('iv-birthdate').textContent =
            d.toLocaleDateString('th-TH', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    // Update displayed name in sidebar
    const label = displayName || `${firstName} ${lastName}`;
    document.getElementById('display-name').textContent = label;

    document.getElementById('edit-form-info').classList.remove('open');
    showToast('✅ บันทึกข้อมูลเรียบร้อยแล้ว');

    // POST to UpdateProfile and UpdateUser
    fetch('/Account/UpdateProfile', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: new URLSearchParams({
            firstName: firstName,
            lastName: lastName,
            displayName: displayName,
            birthdate: birthdate,
            bio: bio
        })
    }).then(response => response.json())
    .then(data => {
        if (!data.success) {
            showToast('❌ ' + data.message);
        }
    }).catch(error => {
        console.error('Error:', error);
        showToast('❌ เกิดข้อผิดพลาดในการบันทึกข้อมูล');
    });

    fetch('/Account/UpdateUser', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: new URLSearchParams({
            username: username,
            email: email,
            phone: phone
        })
    }).then(response => response.json())
    .then(data => {
        if (!data.success) {
            showToast('❌ ' + data.message);
        }
    }).catch(error => {
        console.error('Error:', error);
        showToast('❌ เกิดข้อผิดพลาดในการบันทึกข้อมูล');
    });
}

// ── Edit address popup helpers ──────────────────────────────────────
function openEditAddressModal(button) {
    const data = button.dataset;
    document.getElementById('em-address-id').value = data.addressid || '';
    document.getElementById('em-receiver').value = data.receiver || '';
    document.getElementById('em-phone').value = data.phone || '';
    document.getElementById('em-line1').value = data.line1 || '';
    document.getElementById('em-subdistrict').value = data.subdistrict || '';
    document.getElementById('em-district').value = data.district || '';
    document.getElementById('em-province').value = data.province || '';
    document.getElementById('em-postal').value = data.postal || '';
    document.getElementById('em-default').checked = data.default === 'true';
    document.getElementById('em-error').style.display = 'none';
    document.getElementById('addressEditModal').style.display = 'flex';
}

function closeEditAddressModal() {
    document.getElementById('addressEditModal').style.display = 'none';
}

function saveEditedAddress() {
    const addressId = document.getElementById('em-address-id').value;
    const receiver = document.getElementById('em-receiver').value.trim();
    const phone = document.getElementById('em-phone').value.trim();
    const line1 = document.getElementById('em-line1').value.trim();
    const subdistrict = document.getElementById('em-subdistrict').value.trim();
    const district = document.getElementById('em-district').value.trim();
    const province = document.getElementById('em-province').value.trim();
    const postal = document.getElementById('em-postal').value.trim();
    const isDefault = document.getElementById('em-default').checked;
    const errorEl = document.getElementById('em-error');

    if (!receiver || !phone || !line1 || !subdistrict || !district || !province || !postal) {
        errorEl.textContent = 'กรุณากรอกข้อมูลที่อยู่ให้ครบถ้วน';
        errorEl.style.display = 'block';
        return;
    }

    fetch('/Account/UpdateAddress', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded'
        },
        body: new URLSearchParams({
            addressId,
            receiver,
            phone,
            line1,
            subdistrict,
            district,
            province,
            postal,
            isDefault
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            errorEl.textContent = data.message || 'เกิดข้อผิดพลาดในการบันทึกที่อยู่';
            errorEl.style.display = 'block';
        }
    })
    .catch(error => {
        console.error(error);
        errorEl.textContent = 'เกิดข้อผิดพลาดในการเชื่อมต่อ';
        errorEl.style.display = 'block';
    });
}

function setDefaultAddress(addressId, button) {
    if (!addressId) return;
    button.disabled = true;
    fetch('/Account/SetDefaultAddress', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded'
        },
        body: new URLSearchParams({
            addressId: addressId
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            showToast('❌ ' + (data.message || 'ไม่สามารถตั้งเป็นค่าเริ่มต้นได้'));
            button.disabled = false;
        }
    })
    .catch(error => {
        console.error(error);
        showToast('❌ เกิดข้อผิดพลาดในการตั้งที่อยู่ค่าเริ่มต้น');
        button.disabled = false;
    });
}

// ── Save new address (User_Addresses) ──────────────────────────────────────
function saveAddress() {
    const receiver   = document.getElementById('af-receiver').value.trim();
    const phone      = document.getElementById('af-phone').value.trim();
    const line1      = document.getElementById('af-line1').value.trim();
    const subdistrict= document.getElementById('af-subdistrict').value.trim();
    const district   = document.getElementById('af-district').value.trim();
    const province   = document.getElementById('af-province').value.trim();
    const postal     = document.getElementById('af-postal').value.trim();
    const isDefault  = document.getElementById('af-default').checked;

    if (!receiver || !phone || !line1 || !subdistrict || !district || !province || !postal) {
        alert('กรุณากรอกข้อมูลที่อยู่ให้ครบถ้วน');
        return;
    }

    document.getElementById('edit-form-addr').classList.remove('open');
    showToast('✅ บันทึกที่อยู่เรียบร้อยแล้ว');

    // POST to AddAddress
    fetch('/Account/AddAddress', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: new URLSearchParams({
            receiver: receiver,
            phone: phone,
            line1: line1,
            subdistrict: subdistrict,
            district: district,
            province: province,
            postal: postal,
            isDefault: isDefault
        })
    }).then(response => response.json())
    .then(data => {
        if (data.success) {
            // Reload page to show new address
            location.reload();
        } else {
            showToast('❌ ' + data.message);
        }
    }).catch(error => {
        console.error('Error:', error);
        showToast('❌ เกิดข้อผิดพลาดในการบันทึกที่อยู่');
    });
}

function addToCartFromWishlist(productId, button) {
    if (!productId) return;
    button.disabled = true;
    fetch('/Home/AddToCart', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: new URLSearchParams({
            productId: productId,
            quantity: 1
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showToast('✅ เพิ่มสินค้าลงตะกร้าเรียบร้อยแล้ว');
        } else {
            showToast('❌ ' + data.message);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showToast('❌ เกิดข้อผิดพลาดในการเพิ่มสินค้าลงตะกร้า');
    })
    .finally(() => {
        button.disabled = false;
    });
}

function removeFromWishlist(productId, button) {
    if (!productId) return;
    button.disabled = true;
    fetch('/Home/RemoveFromWishlist', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: new URLSearchParams({
            productId: productId
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showToast('✅ ลบรายการโปรดเรียบร้อยแล้ว');
            location.reload();
        } else {
            showToast('❌ ' + data.message);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showToast('❌ เกิดข้อผิดพลาดในการลบรายการโปรด');
    })
    .finally(() => {
        button.disabled = false;
    });
}

// ── Avatar preview ─────────────────────────────────────────────────────────
function previewAvatar(input) {
    if (!input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = e => {
        const el = document.getElementById('avatar-display');
        el.innerHTML = `<img src="${e.target.result}" alt="avatar"
            style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />`;
    };
    reader.readAsDataURL(input.files[0]);

    // Upload avatar
    const formData = new FormData();
    formData.append('avatar', input.files[0]);

    fetch('/Account/UpdateAvatar', {
        method: 'POST',
        body: formData
    }).then(response => response.json())
    .then(data => {
        if (data.success) {
            showToast('✅ อัปโหลดรูปโปรไฟล์เรียบร้อยแล้ว');
        } else {
            showToast('❌ ' + data.message);
        }
    }).catch(error => {
        console.error('Error:', error);
        showToast('❌ เกิดข้อผิดพลาดในการอัปโหลดรูปภาพ');
    });
}

// ── Logout ─────────────────────────────────────────────────────────────────
function confirmLogout() {
    if (confirm('ออกจากระบบใช่หรือไม่?')) {
        window.location.href = '/Account/Logout';
    }
}

// ── Toast ──────────────────────────────────────────────────────────────────
function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.display = 'block';
    clearTimeout(t._t);
    t._t = setTimeout(() => t.style.display = 'none', 3000);
}
</script>

</body>
</html>
