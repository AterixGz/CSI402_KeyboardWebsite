@model RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - KeyCraft</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Account/Register.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>

    <div class="auth-container">
        <div class="auth-split">
             <!-- Left Side: Form (On Register, form is Left in image) -->
             <div class="auth-form-side">
                <div class="mb-3">
                    <a href="/" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Home
                    </a>
                </div>
                <div class="auth-logo">
                    <span class="brand-icon"><i class="bi bi-keyboard"></i></span> KeyCraft
                </div>

                <h2 class="auth-title">Create your account</h2>
                <p class="auth-subtitle">Already have an account? <a href="/Account/Login" class="auth-link">Sign in</a></p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>เกิดข้อผิดพลาด!</strong>
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Register" asp-controller="Account" method="post">
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label" asp-for="FirstName">First name</label>
                            <input type="text" class="form-control-auth" asp-for="FirstName" placeholder="John" required>
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                         <div class="col-6">
                            <label class="form-label" asp-for="LastName">Last name</label>
                            <input type="text" class="form-control-auth" asp-for="LastName" placeholder="Doe" required>
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Email">Email</label>
                        <input type="email" class="form-control-auth" asp-for="Email" placeholder="you@example.com" required>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    
                     <div class="mb-3">
                        <label class="form-label" asp-for="Username">Username</label>
                        <input type="text" class="form-control-auth" asp-for="Username" placeholder="keycapenthusiast" required>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Password">Password</label>
                        <div class="position-relative">
                            <input type="password" class="form-control-auth" asp-for="Password" placeholder="••••••••" required>
                            <i class="bi bi-eye position-absolute top-50 end-0 translate-middle-y me-3 text-secondary" style="cursor: pointer;" onclick="togglePassword(this)"></i>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    
                     <div class="mb-4">
                        <label class="form-label" asp-for="ConfirmPassword">Confirm password</label>
                        <div class="position-relative">
                            <input type="password" class="form-control-auth" asp-for="ConfirmPassword" placeholder="••••••••" required>
                            <i class="bi bi-eye position-absolute top-50 end-0 translate-middle-y me-3 text-secondary" style="cursor: pointer;" onclick="togglePassword(this)"></i>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-2 form-check">
                        <input type="checkbox" class="form-check-input bg-dark border-secondary" id="marketing" asp-for="MarketingOptIn">
                        <label class="form-check-label text-secondary small" for="marketing">Send me updates about new group buys, restocks, and exclusive deals</label>
                    </div>
                     <div class="mb-4 form-check">
                        <input type="checkbox" class="form-check-input bg-dark border-secondary" id="terms" asp-for="AgreeToTerms" required>
                        <label class="form-check-label text-secondary small" for="terms">I agree to the <a href="#" class="text-success">Terms of Service</a> and <a href="#" class="text-success">Privacy Policy</a></label>
                        <span asp-validation-for="AgreeToTerms" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mb-4">Create account</button>

                     <div class="auth-divider">Or sign up with</div>

                    <div class="row g-3">
                        <div class="col-6">
                            <button type="button" class="social-btn">
                                <i class="bi bi-google"></i> Google
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="social-btn">
                                <i class="bi bi-github"></i> GitHub
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Right Side: Visual -->
             <div class="auth-visual">
                <!-- Abstract visual representing community/nodes -->
                <div class="position-relative mb-5">
                    <div style="width: 150px; height: 150px; border: 1px dashed var(--border-color); border-radius: 20px; position: relative;">
                         <div style="position: absolute; top: -20px; left: -20px; width: 40px; height: 40px; background: rgba(157,142,195,0.2); border-radius: 8px; color: var(--accent-purple); display: flex; align-items: center; justify-content: center; font-weight: bold;">A</div>
                         <div style="position: absolute; bottom: -20px; right: -20px; width: 40px; height: 40px; background: rgba(0,223,154,0.2); border-radius: 8px; color: var(--primary-color); display: flex; align-items: center; justify-content: center; font-weight: bold;">S</div>
                         <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 60px; height: 80px; background: var(--primary-color); border-radius: 10px 10px 4px 4px;"></div>
                         <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, 20px); width: 80px; height: 10px; background: #333; border-radius: 4px;"></div>
                    </div>
                </div>

                <h1 class="auth-visual-title">Join the <span style="color: var(--accent-purple);">Community</span></h1>
                <p class="auth-visual-desc">Get early access to exclusive group buys, connect with fellow enthusiasts, and build your dream keyboard setup.</p>
                
                <div class="d-flex flex-column gap-3 w-100" style="max-width: 400px;">
                    <div class="feature-row">
                        <div class="feature-icon"><i class="bi bi-check-lg"></i></div>
                        <div>
                            <h6 class="mb-0">Early Group Buy Access</h6>
                            <small class="text-secondary">Be first in line for limited drops</small>
                        </div>
                    </div>
                    <div class="feature-row">
                        <div class="feature-icon purple"><i class="bi bi-check-lg"></i></div>
                        <div>
                            <h6 class="mb-0">Exclusive Discounts</h6>
                            <small class="text-secondary">Member-only deals and offers</small>
                        </div>
                    </div>
                     <div class="feature-row">
                        <div class="feature-icon"><i class="bi bi-check-lg"></i></div>
                        <div>
                            <h6 class="mb-0">Order Tracking</h6>
                            <small class="text-secondary">Real-time updates on your orders</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function togglePassword(icon) {
            const input = icon.parentElement.querySelector('input');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.add('bi-eye');
                icon.classList.remove('bi-eye-slash');
            }
        }
    </script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
