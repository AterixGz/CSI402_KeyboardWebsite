@model List<KeyboardWebsiteProject.Models.CartItem>
@{
    ViewData["Title"] = "Shopping Cart";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shopping Cart</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Home/Cart.css" />
</head>
<body>
<div class="page">

    <!-- ── Top bar ── -->
    <div class="topbar">
        <div>
            <h1>Shopping Cart</h1>
            @{ var itemCount = Model?.Sum(x => x.Quantity) ?? 0; }
            <p id="itemCount">@itemCount item(s) in your cart</p>
            @if (TempData["CartMessage"] != null)
            {
                <p style="color: #16a34a; margin-top: 8px;">@TempData["CartMessage"]</p>
            }
            @if (ViewBag.ErrorMessage != null)
            {
                <p style="color: #b91c1c; margin-top: 8px;">@ViewBag.ErrorMessage</p>
            }
        </div>
        <form method="post" asp-action="ClearCart" asp-controller="Home">
            <button type="submit" class="clear-btn">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/>
                </svg>
                Clear Cart
            </button>
        </form>
    </div>

    <!-- ── Two-column layout ── -->
    <div class="layout">

        <!-- LEFT: Cart items -->
        <div>
            @if (Model == null || !Model.Any())
            {
                <div class="cart-card">
                    <p>Your cart is empty.</p>
                    <a href="/Shop" class="continue">Continue Shopping</a>
                </div>
            }
            else
            {
                foreach (var item in Model)
                {
                    <div class="cart-card" style="margin-bottom: 16px;">
                        <div class="cart-item">
                            <img class="item-thumb" src="@Url.Content(item.ImageUrl)" alt="@item.Name" style="object-fit: cover;" />
                            <div class="item-info">
                                <div class="item-name">@item.Name</div>
                                <div class="item-desc">@item.CategoryName • @item.BrandName</div>
                                <div class="item-cat">Price: ฿@item.Price.ToString("0.00")</div>
                            </div>
                            <form method="post" asp-action="RemoveFromCart" asp-controller="Home">
                                <input type="hidden" name="cartId" value="@item.CartId" />
                                <button type="submit" class="item-del" title="Remove item">✕</button>
                            </form>
                        </div>

                        <div class="item-footer">
                            <form method="post" asp-action="UpdateQuantity" asp-controller="Home" style="display: flex; gap: 12px;">
                                <input type="hidden" name="cartId" value="@item.CartId" />
                                <div class="qty">
                                    <button type="submit" name="newQuantity" value="@(item.Quantity - 1)" class="qty-btn" @(item.Quantity <= 1 ? "disabled" : "")>−</button>
                                    <div class="qty-num">@item.Quantity</div>
                                    <button type="submit" name="newQuantity" value="@(item.Quantity + 1)" class="qty-btn" @(item.Quantity >= item.StockQuantity ? "disabled" : "")>+</button>
                                </div>
                            </form>
                            <div class="item-price">฿@item.Total.ToString("0.00")</div>
                        </div>
                    </div>
                }
            }

            <a href="/Shop" class="continue">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path d="M19 12H5M12 5l-7 7 7 7"/>
                </svg>
                Continue Shopping
            </a>
        </div>

        <!-- RIGHT: Delivery Address & Order summary -->
        <div class="summary">
            <!-- ── Delivery Address ── -->
            <div style="background: #f9fafb; border-radius: 12px; padding: 16px; margin-bottom: 20px; border: 1px solid #e5e7eb; cursor: pointer; transition: all 0.2s; position: relative;" onclick="openAddressModal()" id="addressDisplay" onmouseover="this.style.background='#f3f4f6'; this.style.borderColor='#d1d5db';" onmouseout="this.style.background='#f9fafb'; this.style.borderColor='#e5e7eb';">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <h3 style="margin: 0; font-size: 15px; font-weight: 600; color: #1f2937;">📍 Delivery Address</h3>
                    <span style="color: #3b82f6; font-size: 18px;">✎</span>
                </div>
                
                <div style="color: #1f2937; font-size: 14px;">
                    <div style="font-weight: 600; margin-bottom: 6px;" id="selectedName">นาย สมชาย ใจดี</div>
                    <div style="color: #6b7280; font-size: 13px; line-height: 1.6;">
                        <span id="selectedAddress">123 ซอยสุขสวัสดิ์</span><br />
                        <span id="selectedDistrict">ขลุง</span>, <span id="selectedProvince">ฉะเชิงเทรา</span> <span id="selectedPostal">24000</span><br />
                        <span style="margin-top: 4px; display: inline-block;">โทร: <span id="selectedPhone">098-765-4321</span></span>
                    </div>
                </div>
            </div>

            <!-- ── Order Summary ── -->
            <h2>Order Summary</h2>

            @{ var subtotal = Model?.Sum(i => i.Total) ?? 0m; }
            @if (Model == null || !Model.Any())
            {
                <p>Your cart is empty.</p>
            }
            else
            {
                <div class="sum-row"><span class="sum-lbl">Subtotal</span><span class="sum-val">฿@subtotal.ToString("0.00")</span></div>
                <div class="sum-row"><span class="sum-lbl">Shipping</span><span class="sum-val free">Free</span></div>
                <div class="total-row"><span class="total-lbl">Total</span><span class="total-val">฿@subtotal.ToString("0.00")</span></div>
                <form method="post" asp-action="Checkout" asp-controller="Home">
                    <button class="checkout-btn" type="submit">Proceed to Checkout</button>
                </form>
            }

            <div class="trust">
                <div class="trust-item"><span>🚚</span>Fast Shipping</div>
                <div class="trust-item"><span>🔒</span>Secure Payment</div>
            </div>
        </div>

    </div>
</div>

<!-- ── Address Selection Modal ── -->
<div id="addressModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 2000; justify-content: center; align-items: center;">
    <div style="background: white; padding: 28px; border-radius: 12px; max-width: 450px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); width: 90%; max-height: 90vh; overflow-y: auto;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="margin: 0; font-size: 18px; font-weight: 700;">Select Delivery Address</h2>
            <button type="button" onclick="closeAddressModal()" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #6b7280;">✕</button>
        </div>

        <div id="addressList" style="display: flex; flex-direction: column; gap: 12px;">
            <!-- Address items will be generated by JavaScript -->
        </div>
    </div>
</div>

<script>
    // Mock address data
    const mockAddresses = [
        {
            id: 1,
            name: "นาย สมชาย ใจดี",
            phone: "098-765-4321",
            address: "123 ซอยสุขสวัสดิ์",
            district: "ขลุง",
            province: "ฉะเชิงเทรา",
            postal: "24000",
            isDefault: true
        },
        {
            id: 2,
            name: "นางสาว มณฑา บุญมี",
            phone: "089-123-4567",
            address: "456 ถนนรัชดาภิเษก",
            district: "ลาดกระบัง",
            province: "กรุงเทพฯ",
            postal: "10520",
            isDefault: false
        },
        {
            id: 3,
            name: "นาย ปรัชญา เจริงรัตน์",
            phone: "087-654-3210",
            address: "789 ซอยเทพลีลา",
            district: "ดอนเมือง",
            province: "กรุงเทพฯ",
            postal: "10210",
            isDefault: false
        }
    ];

    function openAddressModal() {
        const modal = document.getElementById('addressModal');
        const addressList = document.getElementById('addressList');
        
        // Generate address items
        addressList.innerHTML = mockAddresses.map(addr => `
            <div onclick="selectAddress(${addr.id})" style="padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; cursor: pointer; transition: all 0.2s;" 
                 onmouseover="this.style.borderColor='#3b82f6'; this.style.background='#f0f9ff';"
                 onmouseout="this.style.borderColor='#e5e7eb'; this.style.background='white';">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
                    <div>
                        <div style="font-weight: 600; font-size: 14px; color: #1f2937;">${addr.name}</div>
                        <div style="font-size: 12px; color: #6b7280; margin-top: 2px;">โทร: ${addr.phone}</div>
                    </div>
                    ${addr.isDefault ? '<span style="background: #dbeafe; color: #1e40af; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600;">Default</span>' : ''}
                </div>
                <div style="font-size: 13px; color: #374151; line-height: 1.5;">
                    ${addr.address}<br />
                    ${addr.district}, ${addr.province} ${addr.postal}
                </div>
            </div>
        `).join('');
        
        // Display as flex to center
        modal.style.display = 'flex';
    }

    function closeAddressModal() {
        document.getElementById('addressModal').style.display = 'none';
    }

    function selectAddress(addressId) {
        const address = mockAddresses.find(a => a.id === addressId);
        if (address) {
            // Update display
            document.getElementById('selectedName').textContent = address.name;
            document.getElementById('selectedPhone').textContent = address.phone;
            document.getElementById('selectedAddress').textContent = address.address;
            document.getElementById('selectedDistrict').textContent = address.district;
            document.getElementById('selectedProvince').textContent = address.province;
            document.getElementById('selectedPostal').textContent = address.postal;
            
            // Close modal
            closeAddressModal();
        }
    }

    // Close modal when clicking outside
    document.getElementById('addressModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeAddressModal();
        }
    });
</script>
</body>
</html>
