@model List<KeyboardWebsiteProject.Models.CartItem>
@{
    ViewData["Title"] = "Shopping Cart";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shopping Cart</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Home/Cart.css" />
</head>
<body>
<div class="page">

    <!-- ── Top bar ── -->
    <div class="topbar">
        <div>
            <h1>Shopping Cart</h1>
            @{ var itemCount = Model?.Sum(x => x.Quantity) ?? 0; }
            <p id="itemCount">@itemCount item(s) in your cart</p>
            @if (TempData["CartMessage"] != null)
            {
                <p style="color: #16a34a; margin-top: 8px;">@TempData["CartMessage"]</p>
            }
            @if (ViewBag.ErrorMessage != null)
            {
                <p style="color: #b91c1c; margin-top: 8px;">@ViewBag.ErrorMessage</p>
            }
        </div>
        <form method="post" asp-action="ClearCart" asp-controller="Home">
            <button type="submit" class="clear-btn">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/>
                </svg>
                Clear Cart
            </button>
        </form>
    </div>

    <!-- ── Two-column layout ── -->
    <div class="layout">

        <!-- LEFT: Cart items -->
        <div>
            @if (Model == null || !Model.Any())
            {
                <div class="cart-card">
                    <p>Your cart is empty.</p>
                    <a href="/Shop" class="continue">Continue Shopping</a>
                </div>
            }
            else
            {
                foreach (var item in Model)
                {
                    <div class="cart-card" style="margin-bottom: 16px;">
                        <div class="cart-item">
                            <img class="item-thumb" src="@item.ImageUrl" alt="@item.Name" style="object-fit: cover;" />
                            <div class="item-info">
                                <div class="item-name">@item.Name</div>
                                <div class="item-desc">@item.CategoryName • @item.BrandName</div>
                                <div class="item-cat">Price: ฿@item.Price.ToString("0.00")</div>
                            </div>
                            <form method="post" asp-action="RemoveFromCart" asp-controller="Home">
                                <input type="hidden" name="cartId" value="@item.CartId" />
                                <button type="submit" class="item-del" title="Remove item">✕</button>
                            </form>
                        </div>

                        <div class="item-footer">
                            <form method="post" asp-action="UpdateQuantity" asp-controller="Home" style="display: flex; gap: 12px;">
                                <input type="hidden" name="cartId" value="@item.CartId" />
                                <div class="qty">
                                    <button type="submit" name="newQuantity" value="@(item.Quantity - 1)" class="qty-btn" @(item.Quantity <= 1 ? "disabled" : "")>−</button>
                                    <div class="qty-num">@item.Quantity</div>
                                    <button type="submit" name="newQuantity" value="@(item.Quantity + 1)" class="qty-btn" @(item.Quantity >= item.StockQuantity ? "disabled" : "")>+</button>
                                </div>
                            </form>
                            <div class="item-price">฿@item.Total.ToString("0.00")</div>
                        </div>
                    </div>
                }
            }

            <a href="/Shop" class="continue">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path d="M19 12H5M12 5l-7 7 7 7"/>
                </svg>
                Continue Shopping
            </a>
        </div>

        <!-- RIGHT: Order summary -->
        <div class="summary">
            <h2>Order Summary</h2>

            @{ var subtotal = Model?.Sum(i => i.Total) ?? 0m; }
            @if (Model == null || !Model.Any())
            {
                <p>Your cart is empty.</p>
            }
            else
            {
                <div class="sum-row"><span class="sum-lbl">Subtotal</span><span class="sum-val">฿@subtotal.ToString("0.00")</span></div>
                <div class="sum-row"><span class="sum-lbl">Shipping</span><span class="sum-val free">Free</span></div>
                <div class="total-row"><span class="total-lbl">Total</span><span class="total-val">฿@subtotal.ToString("0.00")</span></div>
                <button class="checkout-btn" onclick="location.href='@Url.Action("Checkout","Home")'" type="button">Proceed to Checkout</button>
            }

            <div class="trust">
                <div class="trust-item"><span>🚚</span>Fast Shipping</div>
                <div class="trust-item"><span>🔒</span>Secure Payment</div>
            </div>
        </div>

    </div>
</div>

<script>
</script>
</body>
</html>
