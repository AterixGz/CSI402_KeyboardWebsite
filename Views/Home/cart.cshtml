@model List<KeyboardWebsiteProject.Models.CartItem>
@{
    ViewData["Title"] = "Shopping Cart";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shopping Cart</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Home/Cart.css" />
</head>
<body>
<div class="page">

    <!-- ── Top bar ── -->
    <div class="topbar">
        <div>
            <h1>Shopping Cart</h1>
            @{ var itemCount = Model?.Sum(x => x.Quantity) ?? 0; }
            <p id="itemCount">@itemCount item(s) in your cart</p>
            @if (TempData["CartMessage"] != null)
            {
                <p style="color: #16a34a; margin-top: 8px;">@TempData["CartMessage"]</p>
            }
            @if (ViewBag.ErrorMessage != null)
            {
                <p style="color: #b91c1c; margin-top: 8px;">@ViewBag.ErrorMessage</p>
            }
        </div>
        <form id="clearCartForm" method="post" asp-action="ClearCart" asp-controller="Home">
            <button type="button" class="clear-btn" onclick="confirmClearCart()">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/>
                </svg>
                Clear Cart
            </button>
        </form>
    </div>

    <!-- ── Two-column layout ── -->
    <div class="layout">

        <!-- LEFT: Cart items -->
        <div>
            @if (Model == null || !Model.Any())
            {
                <div class="cart-card">
                    <p>Your cart is empty.</p>
                </div>
            }
            else
            {
                foreach (var item in Model)
                {
                    <div class="cart-card" style="margin-bottom: 16px;">
                        <div class="cart-item">
                            <input type="checkbox" class="item-checkbox" data-cart-id="@item.CartId" @(item.IsSelected ? "checked" : "") />
                            <img class="item-thumb" src="@Url.Content(item.ImageUrl)" alt="@item.Name" style="object-fit: cover;" />
                            <div class="item-info">
                                <div class="item-name">@item.Name</div>
                                <div class="item-desc">@item.CategoryName • @item.BrandName</div>
                                <div class="item-cat">Price: ฿@item.Price.ToString("0.00")</div>
                            </div>
                            <form method="post" asp-action="RemoveFromCart" asp-controller="Home">
                                <input type="hidden" name="cartId" value="@item.CartId" />
                                <button type="submit" class="item-del" title="Remove item">✕</button>
                            </form>
                        </div>

                        <div class="item-footer">
                            <form method="post" asp-action="UpdateQuantity" asp-controller="Home" style="display: flex; gap: 12px;">
                                <input type="hidden" name="cartId" value="@item.CartId" />
                                <div class="qty">
                                    <button type="submit" name="newQuantity" value="@(item.Quantity - 1)" class="qty-btn" @(item.Quantity <= 1 ? "disabled" : "")>−</button>
                                    <div class="qty-num">@item.Quantity</div>
                                    <button type="submit" name="newQuantity" value="@(item.Quantity + 1)" class="qty-btn" @(item.Quantity >= item.StockQuantity ? "disabled" : "")>+</button>
                                </div>
                            </form>
                            <div class="item-price">฿@item.Total.ToString("0.00")</div>
                        </div>
                    </div>
                }
            }

            <a href="/Home/Shop" class="continue">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path d="M19 12H5M12 5l-7 7 7 7"/>
                </svg>
                Continue Shopping
            </a>
        </div>

        <!-- RIGHT: Delivery Address & Order summary -->
        <div class="summary">
            <!-- ── Delivery Address ── -->
            <div class="address-display" onclick="openAddressModal()" id="addressDisplay">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <h3 style="margin: 0; font-size: 15px; font-weight: 600; color: #1f2937;">📍 Delivery Address</h3>
                    <span class="address-edit-icon">✎</span>
                </div>
                
                <div style="color: #1f2937; font-size: 14px;">
                    <div style="font-weight: 600; margin-bottom: 6px;" id="selectedName">@((ViewBag.SelectedUserAddress as KeyboardWebsiteProject.Models.UserAddress)?.ReceiverName ?? "No address selected")</div>
                    <div style="color: #6b7280; font-size: 13px; line-height: 1.6;">
                        <span id="selectedAddress">@((ViewBag.SelectedUserAddress as KeyboardWebsiteProject.Models.UserAddress)?.AddressLine1 ?? "-")</span><br />
                        <span id="selectedDistrict">@((ViewBag.SelectedUserAddress as KeyboardWebsiteProject.Models.UserAddress)?.District ?? "-")</span>, <span id="selectedProvince">@((ViewBag.SelectedUserAddress as KeyboardWebsiteProject.Models.UserAddress)?.Province ?? "-")</span> <span id="selectedPostal">@((ViewBag.SelectedUserAddress as KeyboardWebsiteProject.Models.UserAddress)?.PostalCode ?? "-")</span><br />
                        <span style="margin-top: 4px; display: inline-block;">Phone: <span id="selectedPhone">@((ViewBag.SelectedUserAddress as KeyboardWebsiteProject.Models.UserAddress)?.PhoneNumber ?? "-")</span></span>
                    </div>
                </div>
                <div id="addressError" class="address-error">Please add a shipping address before checkout.</div>
            </div>

            <!-- ── Order Summary ── -->
            <h2>Order Summary</h2>

            @{ var subtotal = Model?.Sum(i => i.Total) ?? 0m; }
            @if (Model == null || !Model.Any())
            {
                <p>Your cart is empty.</p>
            }
            else
            {
                <div class="selected-summary-box">
                    <div class="selected-summary-text">
                        📦 Selected: <span id="selectedCount">0</span> / @Model.Count item(s)
                    </div>
                </div>
                <div id="promotionMatches" class="promo-match-list" style="margin-bottom: 14px; font-size: 13px; color: #111827;"></div>
                <div class="sum-row"><span class="sum-lbl">Subtotal</span><span class="sum-val" id="selectedSubtotal">฿0.00</span></div>
                <div id="promoDiscountRow" class="sum-row" style="display:none;"><span class="sum-lbl">Promotion Discount</span><span class="sum-val" id="promoDiscountValue">-฿0.00</span></div>
                <div id="subtotalAfterPromoRow" class="sum-row" style="display:none;"><span class="sum-lbl">Subtotal after Promotion</span><span class="sum-val" id="subtotalAfterPromoValue">฿0.00</span></div>
                <div id="appliedPromotionRow" class="sum-row" style="display:none;"><span class="sum-lbl">Applied Promotion</span><span class="sum-val" id="appliedPromotionName"></span></div>
                <div class="promo-label">Have a coupon?</div>
                <div class="promo-row">
                    <div class="promo-ico">🏷️</div>
                    <input id="couponCode" class="promo-input" type="text" placeholder="Enter coupon code" />
                    <button type="button" class="promo-apply" onclick="applyCoupon()">Apply</button>
                </div>
                <div id="couponMessage" class="promo-hint" style="display:none; margin-top: 10px;"></div>
                <div id="appliedCouponsList" class="applied-coupons" style="display:none; margin-top: 12px;"></div>
                <div class="sum-row"><span class="sum-lbl">Shipping</span><span class="sum-val" id="shippingValue">฿150.00</span></div>
                <div id="discountRow" class="sum-row" style="display:none;"><span class="sum-lbl">Coupon Discount</span><span class="sum-val" id="discountValue">-฿0.00</span></div>
                <div class="total-row"><span class="total-lbl">Total</span><span class="total-val" id="selectedTotal">฿0.00</span></div>
                <button class="checkout-btn" type="button" onclick="proceedToCheckout()">Proceed to Checkout</button>
            }

            <div class="trust">
                <div class="trust-item"><span>🚚</span>Fast Shipping</div>
                <div class="trust-item"><span>🔒</span>Secure Payment</div>
            </div>
        </div>

    </div>
</div>

<!-- ── Confirm Clear Cart Modal ── -->
<div id="confirmClearModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 2000; justify-content: center; align-items: center;">
    <div style="background: white; padding: 28px; border-radius: 12px; max-width: 400px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); text-align: center;">
        <div style="margin-bottom: 20px;">
            <div style="font-size: 48px; margin-bottom: 12px;">⚠️</div>
            <h2 style="margin: 0 0 8px 0; font-size: 18px; font-weight: 700; color: #1f2937;">Confirm Clear Cart</h2>
            <p style="margin: 0; color: #6b7280; font-size: 14px;">Are you sure you want to clear your cart? This action cannot be undone.</p>
        </div>
        <div style="display: flex; gap: 12px; justify-content: center;">
            <button type="button" onclick="closeClearModal()" style="padding: 10px 24px; border: 1px solid #d1d5db; background: white; border-radius: 6px; font-weight: 600; cursor: pointer; color: #374151; transition: all 0.2s;">Cancel</button>
            <button type="button" onclick="submitClearCart()" style="padding: 10px 24px; border: none; background: #ef4444; border-radius: 6px; font-weight: 600; cursor: pointer; color: white; transition: all 0.2s;">Confirm Clear All</button>
        </div>
    </div>
</div>

<!-- ── Address Selection Modal ── -->
<div id="addressModal" class="address-modal">
    <div class="address-modal-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="margin: 0; font-size: 18px; font-weight: 700;">Select Delivery Address</h2>
            <button type="button" onclick="closeAddressModal()" class="modal-close-btn">✕</button>
        </div>

        <div id="addressList" class="address-list">
            <!-- Address items will be generated by JavaScript -->
        </div>
    </div>
</div>

<script>
    // Cart items data from Razor model
    const cartItemsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize<object>(
        Model != null
            ? Model.Select(x => new {
                cartId = x.CartId,
                productId = x.ProductId,
                categoryId = x.CategoryId,
                categoryName = (x.CategoryName ?? string.Empty).Trim(),
                quantity = x.Quantity,
                total = x.Total
            })
            : new object[0],
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
    ));

    const systemPromotions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize<object>(
        ViewBag.SystemPromotions ?? new List<KeyboardWebsiteProject.Models.CartPromotion>(),
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
    ));

    // Initialize checkboxes
    function initializeCheckboxes() {
        const checkboxes = document.querySelectorAll('.item-checkbox');
        checkboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const cartId = parseInt(this.getAttribute('data-cart-id'));
                    const isSelected = this.checked;
                    updateCartSelection(cartId, isSelected);
                    updateOrderSummary();
                });
            });
            updateOrderSummary();
        }

        function updateOrderSummary() {
            const selectedCheckboxes = document.querySelectorAll('.item-checkbox:checked');
            const selectedCount = selectedCheckboxes.length;
            
            let selectedSubtotal = 0;
            selectedCheckboxes.forEach(checkbox => {
                const cartId = parseInt(checkbox.getAttribute('data-cart-id'));
                const item = cartItemsData.find(x => x.cartId === cartId);
                if (item) {
                    selectedSubtotal += item.total;
                }
            });

            const selectedItems = getSelectedItems();
            const matchedPromotions = getMatchedPromotions(selectedItems, selectedSubtotal);
            const freeShippingPromos = matchedPromotions.filter(promo => promo.isFreeShipping);
            const discountPromos = matchedPromotions.filter(promo => (promo.discountAmount || 0) > 0 && !promo.isFreeShipping);
            const { bestDiscountPromotion, bestFreeShippingPromotion } = getBestPromotions(matchedPromotions);
            const selectedPromotion = getSelectedPromotion(discountPromos, bestDiscountPromotion);
            const selectedFreeShippingPromotion = getSelectedFreeShippingPromotion(freeShippingPromos, bestFreeShippingPromotion);
            const selectedPromotionDiscount = selectedPromotion && selectedPromotion.discountAmount ? selectedPromotion.discountAmount : 0;
            const promotionDiscount = Math.max(0, Math.min(selectedSubtotal, selectedPromotionDiscount));
            const hasFreeShipping = Boolean(selectedFreeShippingPromotion);
            const shippingFee = selectedItems.length === 0 ? 0 : (hasFreeShipping ? 0 : 150);

            document.getElementById('selectedCount').textContent = selectedCount;
            document.getElementById('selectedSubtotal').textContent = '฿' + selectedSubtotal.toFixed(2);

            const promoDiscountRow = document.getElementById('promoDiscountRow');
            const promoDiscountValue = document.getElementById('promoDiscountValue');
            if (promotionDiscount > 0) {
                promoDiscountValue.textContent = `-฿${promotionDiscount.toFixed(2)}`;
                promoDiscountRow.style.display = 'flex';
            } else {
                promoDiscountRow.style.display = 'none';
            }

            const shippingValueEl = document.getElementById('shippingValue');
            shippingValueEl.textContent = shippingFee === 0 ? 'Free' : `฿${shippingFee.toFixed(2)}`;
            shippingValueEl.classList.toggle('free', shippingFee === 0);

            const subtotalAfterPromotion = selectedSubtotal - promotionDiscount;
            const subtotalAfterPromoRow = document.getElementById('subtotalAfterPromoRow');
            const subtotalAfterPromoValue = document.getElementById('subtotalAfterPromoValue');
            if (promotionDiscount > 0) {
                subtotalAfterPromoValue.textContent = `฿${subtotalAfterPromotion.toFixed(2)}`;
                subtotalAfterPromoRow.style.display = 'flex';
            } else {
                subtotalAfterPromoRow.style.display = 'none';
            }

            const couponDiscount = renderCouponSummary(subtotalAfterPromotion);
            const totalBeforeShipping = subtotalAfterPromotion - couponDiscount;
            const total = Math.max(0, totalBeforeShipping + shippingFee);

            document.getElementById('selectedTotal').textContent = `฿${total.toFixed(2)}`;

            const appliedPromotionRow = document.getElementById('appliedPromotionRow');
            const appliedPromotionName = document.getElementById('appliedPromotionName');
            const appliedPromoNames = [];
            if (selectedPromotion) {
                appliedPromoNames.push(selectedPromotion.name || 'Promotion applied');
            }
            if (selectedFreeShippingPromotion) {
                appliedPromoNames.push(selectedFreeShippingPromotion.name || 'Free shipping promotion');
            }
            if (appliedPromoNames.length > 0) {
                appliedPromotionName.textContent = appliedPromoNames.join(' + ');
                appliedPromotionRow.style.display = 'flex';
            } else {
                appliedPromotionRow.style.display = 'none';
            }

            updatePromotionMatches(selectedItems, selectedSubtotal);
        }

        async function updateCartSelection(cartId, isSelected) {
            try {
                const response = await fetch('/Home/UpdateCartSelection', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ cartId, isSelected })
                });
                const result = await response.json();
                if (!result.success) {
                    console.error('Failed to update selection:', result.message);
                }
            } catch (error) {
                console.error('Failed to update selection:', error);
            }
        }

        let couponLookupCache = {};
        let appliedCoupons = [];
        let selectedDiscountPromotionId = null;
        let selectedFreeShippingPromotionId = null;

        function selectDiscountPromotion(promoId) {
            selectedDiscountPromotionId = promoId;
            updateOrderSummary();
        }

        function selectFreeShippingPromotion(promoId) {
            selectedFreeShippingPromotionId = promoId;
            updateOrderSummary();
        }

        function proceedToCheckout() {
            const selectedCheckboxes = document.querySelectorAll('.item-checkbox:checked');
            const addressDisplay = document.getElementById('addressDisplay');
            const addressError = document.getElementById('addressError');
            const selectedName = document.getElementById('selectedName').textContent.trim();
            const selectedAddress = document.getElementById('selectedAddress').textContent.trim();
            const subtotal = parseFloat(document.getElementById('selectedSubtotal').textContent.replace(/[^0-9.-]+/g, '')) || 0;

            const noAddress = selectedName === 'No address selected' || selectedAddress === '-' || selectedAddress.length === 0;

            if (noAddress) {
                addressError.style.display = 'block';
                addressDisplay.classList.add('error');
                addressDisplay.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            addressError.style.display = 'none';
            addressDisplay.classList.remove('error');

            if (selectedCheckboxes.length === 0) {
                alert('กรุณาเลือกอย่างน้อย 1 รายการสินค้าก่อนชำระเงิน');
                return;
            }


            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Home/Checkout';
            form.style.display = 'none';

            const addressInput = document.createElement('input');
            addressInput.type = 'hidden';
            addressInput.name = 'addressId';
            addressInput.value = selectedAddressId || '';
            form.appendChild(addressInput);

            if (appliedCoupons.length > 0) {
                const couponInput = document.createElement('input');
                couponInput.type = 'hidden';
                couponInput.name = 'couponCode';
                couponInput.value = appliedCoupons[0].code;
                form.appendChild(couponInput);
            }

            if (selectedDiscountPromotionId != null) {
                const discountPromoInput = document.createElement('input');
                discountPromoInput.type = 'hidden';
                discountPromoInput.name = 'discountPromotionId';
                discountPromoInput.value = selectedDiscountPromotionId;
                form.appendChild(discountPromoInput);
            }

            if (selectedFreeShippingPromotionId != null) {
                const freeShippingPromoInput = document.createElement('input');
                freeShippingPromoInput.type = 'hidden';
                freeShippingPromoInput.name = 'freeShippingPromotionId';
                freeShippingPromoInput.value = selectedFreeShippingPromotionId;
                form.appendChild(freeShippingPromoInput);
            }

            document.body.appendChild(form);
            form.submit();
        }

        async function applyCoupon() {
            const codeInput = document.getElementById('couponCode');
            const couponMessage = document.getElementById('couponMessage');
            const subtotal = parseFloat(document.getElementById('selectedSubtotal').textContent.replace(/[^0-9.-]+/g, '')) || 0;
            const code = codeInput.value.trim().toUpperCase();

            if (!code) {
                couponMessage.textContent = 'กรุณากรอกรหัสคูปอง';
                couponMessage.style.color = '#b91c1c';
                couponMessage.style.display = 'block';
                return;
            }

            if (appliedCoupons.length >= 1) {
                couponMessage.textContent = 'ระบบรองรับคูปองได้เพียง 1 ใบเท่านั้น';
                couponMessage.style.color = '#b91c1c';
                couponMessage.style.display = 'block';
                return;
            }

            if (appliedCoupons.some(c => c.code === code)) {
                couponMessage.textContent = `คุณใช้คูปอง ${code} ไปแล้ว`;
                couponMessage.style.color = '#b91c1c';
                couponMessage.style.display = 'block';
                return;
            }

            let couponData = couponLookupCache[code];
            if (!couponData) {
                try {
                    const response = await fetch(`/Home/GetCoupon?code=${encodeURIComponent(code)}`);
                    const result = await response.json();
                    if (!result.success) {
                        couponMessage.textContent = result.message || 'คูปองไม่ถูกต้อง โปรดลองอีกครั้ง';
                        couponMessage.style.color = '#b91c1c';
                        couponMessage.style.display = 'block';
                        return;
                    }
                    couponData = result.coupon;
                    couponLookupCache[code] = couponData;
                } catch (error) {
                    couponMessage.textContent = 'เกิดข้อผิดพลาดขณะตรวจสอบคูปอง';
                    couponMessage.style.color = '#b91c1c';
                    couponMessage.style.display = 'block';
                    return;
                }
            }

            const coupon = buildCouponFromServer(couponData);
            if (!coupon) {
                couponMessage.textContent = 'ประเภทคูปองไม่รองรับ';
                couponMessage.style.color = '#b91c1c';
                couponMessage.style.display = 'block';
                return;
            }

            appliedCoupons.push(coupon);
            updateOrderSummary();
            codeInput.value = '';
        }

        function buildCouponFromServer(couponData) {
            const type = couponData.discountType;
            const value = parseFloat(couponData.discountValue);
            if (type === 'percentage') {
                return {
                    code: couponData.code.toUpperCase(),
                    discountType: 'percentage',
                    discountValue: value,
                    text: `ลด ${value}%`
                };
            }
            if (type === 'fixed') {
                return {
                    code: couponData.code.toUpperCase(),
                    discountType: 'fixed',
                    discountValue: value,
                    text: `ลดทันที ฿${value.toFixed(2)}`
                };
            }
            return null;
        }

        function getCouponAmount(coupon, subtotal) {
            if (coupon.discountType === 'percentage') {
                return Math.min(subtotal * coupon.discountValue / 100, subtotal);
            }
            if (coupon.discountType === 'fixed') {
                return Math.min(coupon.discountValue, subtotal);
            }
            return 0;
        }

        function removeCoupon(code) {
            appliedCoupons = appliedCoupons.filter(coupon => coupon.code !== code);
            updateOrderSummary();
        }

        function renderAppliedCouponsList() {
            const listContainer = document.getElementById('appliedCouponsList');
            if (!listContainer) return;

            if (appliedCoupons.length === 0) {
                listContainer.style.display = 'none';
                listContainer.innerHTML = '';
                return;
            }

            listContainer.style.display = 'flex';
            listContainer.style.flexWrap = 'wrap';
            listContainer.innerHTML = appliedCoupons.map(coupon => `
                <span class="coupon-chip" style="display:inline-flex; align-items:center; gap:8px; background:#eef2ff; color:#1e3a8a; border-radius:999px; padding:8px 12px; margin:4px; font-size:13px;">
                    ${coupon.code} - ${coupon.text}
                    <button type="button" onclick="removeCoupon('${coupon.code}')" style="background:none; border:none; color:#1e3a8a; font-weight:700; cursor:pointer;">✕</button>
                </span>
            `).join('');
        }

        function renderCouponSummary(subtotal) {
            const couponMessage = document.getElementById('couponMessage');
            const discountRow = document.getElementById('discountRow');
            const discountValue = document.getElementById('discountValue');

            if (appliedCoupons.length === 0) {
                discountRow.style.display = 'none';
                couponMessage.style.display = 'none';
                const appliedCouponsList = document.getElementById('appliedCouponsList');
                if (appliedCouponsList) {
                    appliedCouponsList.style.display = 'none';
                }
                renderAppliedCouponsList();
                return 0;
            }

            const codes = appliedCoupons.map(c => c.code).join(', ');
            const totalDiscount = Math.min(subtotal, appliedCoupons.reduce((sum, coupon) => sum + getCouponAmount(coupon, subtotal), 0));

            if (totalDiscount > 0) {
                discountValue.textContent = `-฿${totalDiscount.toFixed(2)}`;
                discountRow.style.display = 'flex';
            } else {
                discountRow.style.display = 'none';
            }

            couponMessage.textContent = `ใช้คูปอง: ${codes} | ${appliedCoupons.map(c => c.text).join(', ')}`;
            couponMessage.style.color = '#16a34a';
            couponMessage.style.display = 'block';
            renderAppliedCouponsList();
            return totalDiscount;
        }

        function getSelectedItems() {
            return Array.from(document.querySelectorAll('.item-checkbox:checked'))
                .map(checkbox => {
                    const cartId = parseInt(checkbox.getAttribute('data-cart-id'));
                    const item = cartItemsData.find(item => item.cartId === cartId);
                    return item ? { ...item, categoryId: item.categoryId ?? null, categoryName: (item.categoryName || '').trim() } : null;
                })
                .filter(item => item);
        }

        function getMatchedPromotions(selectedItems, subtotal) {
            return systemPromotions.filter(promo => isPromotionEligible(promo, selectedItems, subtotal));
        }

        function getBestPromotions(promotions) {
            const bestDiscountPromotion = promotions
                .filter(promo => promo && (promo.discountAmount || 0) > 0)
                .reduce((best, promo) => {
                    if (!best) return promo;
                    return (promo.discountAmount || 0) > (best.discountAmount || 0) ? promo : best;
                }, null);

            const bestFreeShippingPromotion = promotions
                .filter(promo => promo && promo.isFreeShipping)
                .reduce((best, promo) => {
                    if (!best) return promo;
                    return (promo.discountAmount || 0) > (best.discountAmount || 0) ? promo : best;
                }, null);

            return { bestDiscountPromotion, bestFreeShippingPromotion };
        }

        function getSelectedPromotion(promotions, defaultDiscountPromo) {
            if (!promotions || promotions.length === 0) return null;

            const selected = promotions.find(promo => promo && promo.promotionId === selectedDiscountPromotionId);
            if (selected) {
                return selected;
            }

            if (defaultDiscountPromo) {
                selectedDiscountPromotionId = defaultDiscountPromo.promotionId;
                return defaultDiscountPromo;
            }

            const fallbackPromo = promotions[0];
            selectedDiscountPromotionId = fallbackPromo ? fallbackPromo.promotionId : null;
            return fallbackPromo;
        }

        function getSelectedFreeShippingPromotion(promotions, defaultFreeShippingPromo) {
            if (!promotions || promotions.length === 0) return null;

            const selected = promotions.find(promo => promo && promo.promotionId === selectedFreeShippingPromotionId);
            if (selected) {
                return selected;
            }

            if (defaultFreeShippingPromo) {
                selectedFreeShippingPromotionId = defaultFreeShippingPromo.promotionId;
                return defaultFreeShippingPromo;
            }

            const fallbackPromo = promotions[0];
            selectedFreeShippingPromotionId = fallbackPromo ? fallbackPromo.promotionId : null;
            return fallbackPromo;
        }

        function findBestPromotion(promotions) {
            if (!promotions || promotions.length === 0) return null;
            return promotions.reduce((best, promo) => {
                const currentValue = (promo.discountAmount || 0) + (promo.isFreeShipping ? 150 : 0);
                const bestValue = (best.discountAmount || 0) + (best.isFreeShipping ? 150 : 0);
                return currentValue > bestValue ? promo : best;
            }, promotions[0]);
        }

        function isPromotionEligible(promotion, selectedItems, subtotal) {
            if (!promotion || !promotion.isActive) return false;
            if (subtotal < (promotion.minSpend || 0)) return false;
            if (!promotion.requirements || promotion.requirements.length === 0) return true;

            return promotion.requirements.every(req => {
                const productId = req.productId;
                const categoryName = (req.categoryName || '').trim();
                const requiredQty = req.minQuantity || 0;

                if (productId != null) {
                    const item = selectedItems.find(i => i.productId === productId);
                    return item && item.quantity >= requiredQty;
                }

                if (req.categoryId != null) {
                    const totalQty = selectedItems
                        .filter(i => i.categoryId === req.categoryId)
                        .reduce((sum, item) => sum + item.quantity, 0);
                    return totalQty >= requiredQty;
                }

                if (categoryName && categoryName.toLowerCase() !== 'all categories') {
                    const normalizedCategory = categoryName.toLowerCase();
                    const totalQty = selectedItems
                        .filter(i => (i.categoryName || '').trim().toLowerCase() === normalizedCategory)
                        .reduce((sum, item) => sum + item.quantity, 0);
                    return totalQty >= requiredQty;
                }

                const totalQty = selectedItems.reduce((sum, item) => sum + item.quantity, 0);
                return totalQty >= requiredQty;
            });
        }

        function updatePromotionMatches(selectedItems, subtotal) {
            const promotionMatches = document.getElementById('promotionMatches');
            if (!promotionMatches) return;

            if (!selectedItems.length) {
                promotionMatches.innerHTML = '<div class="promo-hint">เลือกสินค้าที่ต้องการเพื่อดูโปรโมชั่นที่ตรงกับสินค้า</div>';
                return;
            }

            const matched = systemPromotions.filter(promo => isPromotionEligible(promo, selectedItems, subtotal));
            if (!matched.length) {
                promotionMatches.innerHTML = '<div class="promo-hint">ไม่มีโปรโมชั่นที่ตรงกับสินค้าที่เลือกในขณะนี้</div>';
                return;
            }

            const freeShippingPromos = matched
                .filter(promo => promo.isFreeShipping)
                .sort((a, b) => ((b.discountAmount || 0) - (a.discountAmount || 0)));
            const discountPromos = matched
                .filter(promo => !promo.isFreeShipping && (promo.discountAmount || 0) > 0)
                .sort((a, b) => ((b.discountAmount || 0) - (a.discountAmount || 0)));
            const otherPromos = matched
                .filter(promo => !promo.isFreeShipping && !(promo.discountAmount || 0));

            const defaultDiscount = getBestPromotions(discountPromos).bestDiscountPromotion || (discountPromos.length ? discountPromos[0] : null);
            if (!selectedDiscountPromotionId || !discountPromos.some(promo => promo.promotionId === selectedDiscountPromotionId)) {
                selectedDiscountPromotionId = defaultDiscount ? defaultDiscount.promotionId : null;
            }

            const defaultFreeShipping = freeShippingPromos.length ? freeShippingPromos[0] : null;
            if (!selectedFreeShippingPromotionId || !freeShippingPromos.some(promo => promo.promotionId === selectedFreeShippingPromotionId)) {
                selectedFreeShippingPromotionId = defaultFreeShipping ? defaultFreeShipping.promotionId : null;
            }

            const renderPromoCard = (promo, isSelected, inputHandler) => {
                const conditionParts = [];
                if (promo.minSpend && promo.minSpend > 0) {
                    conditionParts.push(`min spend ฿${promo.minSpend.toFixed(2)}`);
                }
                if (promo.requirements && promo.requirements.length) {
                    const requirementParts = promo.requirements.map(req => {
                        if (req.productId != null) {
                            return `product ${req.productId} ≥ ${req.minQuantity}`;
                        }
                        if (req.categoryName && req.categoryName.toLowerCase() !== 'all categories') {
                            return `${req.categoryName} ≥ ${req.minQuantity}`;
                        }
                        return `any product ≥ ${req.minQuantity}`;
                    });
                    conditionParts.push(...requirementParts);
                }
                const conditions = conditionParts.length
                    ? conditionParts.join(' · ')
                    : 'Applies to selected items';

                return `
                    <label class="promo-match-card${isSelected ? ' promo-selected' : ''}" style="display:block; background:#ecfdf5; border:1px solid ${isSelected ? '#16a34a' : '#a7f3d0'}; padding:12px; border-radius:10px; margin-bottom:8px; cursor:pointer;">
                        <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
                            <div style="font-weight:600; color:#14532d;">${promo.name}</div>
                            ${promo.discountAmount > 0 || promo.isFreeShipping ? `<input type="radio" name="${inputHandler === 'free' ? 'selectedFreeShippingPromotion' : 'selectedDiscountPromotion'}" value="${promo.promotionId}" ${isSelected ? 'checked' : ''} onchange="${inputHandler === 'free' ? 'selectFreeShippingPromotion' : 'selectDiscountPromotion'}(${promo.promotionId})" />` : ''}
                        </div>
                        <div style="font-size:13px; color:#334155; margin-top:6px;">${promo.discountAmount > 0 ? `฿${promo.discountAmount.toFixed(2)} off` : promo.isFreeShipping ? 'Free shipping' : 'Special promotion'}</div>
                        <div style="font-size:12px; color:#475569; margin-top:6px;">${promo.isFreeShipping ? 'Free shipping' : 'Applies to selected items'}</div>
                        <div style="font-size:12px; color:#475569; margin-top:4px;">${conditions}</div>
                    </label>
                `;
            };

            let html = '';
            if (freeShippingPromos.length) {
                html += '<div class="promo-section-label">Free shipping promotions</div>';
                html += freeShippingPromos.map(promo => renderPromoCard(promo, promo.promotionId === selectedFreeShippingPromotionId, 'free')).join('');
            }
            if (discountPromos.length) {
                html += '<div class="promo-section-label">Discount promotions</div>';
                html += discountPromos.map(promo => renderPromoCard(promo, promo.promotionId === selectedDiscountPromotionId, 'discount')).join('');
            }
            if (otherPromos.length) {
                html += '<div class="promo-section-label">Other promotions</div>';
                html += otherPromos.map(promo => renderPromoCard(promo, promo.promotionId === selectedDiscountPromotionId, 'discount')).join('');
            }

            promotionMatches.innerHTML = html;
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', initializeCheckboxes);

    const userAddresses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ViewBag.UserAddresses ?? new List<KeyboardWebsiteProject.Models.UserAddress>(),
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
    ));

    function openAddressModal() {
        const modal = document.getElementById('addressModal');
        const addressList = document.getElementById('addressList');
        
        if (!userAddresses || userAddresses.length === 0) {
            addressList.innerHTML = `
                <div class="address-modal-message">
                    No saved addresses found.
                </div>
                <div class="address-modal-actions">
                    <a href="/Account/Profile" class="profile-link">Add Address in Profile</a>
                </div>
            `;
            modal.style.display = 'flex';
            return;
        }

        addressList.innerHTML = userAddresses.map(addr => `
            <div onclick="selectAddress(${addr.addressId})" class="address-card">
                <div class="address-card-header">
                    <div>
                        <div class="address-card-name">${addr.receiverName ?? 'Unnamed'}</div>
                        <div class="address-card-phone">Phone: ${addr.phoneNumber ?? '-'}</div>
                    </div>
                    ${addr.isDefault ? '<span class="address-default-badge">Default</span>' : ''}
                </div>
                <div class="address-card-body">
                    ${addr.addressLine1 ?? '-'}<br />
                    ${addr.district ?? '-'}, ${addr.province ?? '-'} ${addr.postalCode ?? '-'}
                </div>
            </div>
        `).join('');
        
        modal.style.display = 'flex';
    }

    function closeAddressModal() {
        document.getElementById('addressModal').style.display = 'none';
    }

    let selectedAddressId = @((ViewBag.SelectedUserAddress as KeyboardWebsiteProject.Models.UserAddress)?.AddressId ?? 0);

    function selectAddress(addressId) {
        const address = userAddresses.find(a => a.addressId === addressId);
        if (address) {
            selectedAddressId = address.addressId;
            document.getElementById('selectedName').textContent = address.receiverName || 'Unnamed';
            document.getElementById('selectedPhone').textContent = address.phoneNumber || '-';
            document.getElementById('selectedAddress').textContent = address.addressLine1 || '-';
            document.getElementById('selectedDistrict').textContent = address.district || '-';
            document.getElementById('selectedProvince').textContent = address.province || '-';
            document.getElementById('selectedPostal').textContent = address.postalCode || '-';
            document.getElementById('addressError').style.display = 'none';
            document.getElementById('addressDisplay').style.borderColor = '#e5e7eb';
            document.getElementById('addressDisplay').style.background = '#f9fafb';
            closeAddressModal();
        }
    }

    // Close modal when clicking outside
    document.getElementById('addressModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeAddressModal();
        }
    });

    // Clear cart confirmation
    function confirmClearCart() {
        document.getElementById('confirmClearModal').style.display = 'flex';
    }

    function closeClearModal() {
        document.getElementById('confirmClearModal').style.display = 'none';
    }

    function submitClearCart() {
        document.getElementById('clearCartForm').submit();
    }

    // Close clear modal when clicking outside
    document.getElementById('confirmClearModal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeClearModal();
        }
    });
</script>

</body>
</html>
