@{
    ViewData["Title"] = "Premium Keyboards";
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="hero-subtitle">The Enthusiast Collection</span>
                <h1 class="hero-title fw-bold">Craft Your <span class="text-gradient-purple">Perfect</span><br>Typing Experience</h1>
                <p class="hero-desc">Discover purely aesthetic mechanical keyboards, artisan keycaps, and ultra-smooth switches designed for the dedicated enthusiast.</p>
                <div class="d-flex gap-3 mb-5">
                    <a href="#" class="btn btn-primary">Shop Keyboards</a>
                    <a href="#" class="btn btn-outline-light">View Group Buys</a>
                </div>
                
                <div class="d-flex gap-5 text-secondary">
                    <div>
                        <h4 class="mb-1 text-white">50+</h4>
                        <small>Premium Brands</small>
                    </div>
                    <div>
                        <h4 class="mb-1 text-white">24h</h4>
                        <small>Dispatch</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mt-5 mt-lg-0">
                <!-- Keyboard Image -->
                <div class="keyboard-visual-img">
                    <img src="~/image/Screenshot%202026-02-23%20142530.png" alt="Keyboard Visual" class="w-100" style="border-radius: 16px;" />
                    <div class="float-badge">
                        <div class="status-dot"></div>
                        <div>
                            <h6 class="mb-0 text-white" style="font-size: 0.9rem;">Restocked</h6>
                            <small class="text-secondary" style="font-size: 0.75rem;">GB - Zoom75</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Categories -->
<div class="container py-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="cat-card">
                <div class="cat-icon">
                    <i class="bi bi-keyboard"></i>
                </div>
                <h3 class="cat-title">Keyboards</h3>
                <p class="cat-meta">Custom & Pre-built</p>
                <a href="#" class="cat-link">Browse Collection <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
        <div class="col-md-4">
             <div class="cat-card">
                <div class="cat-icon">
                    <i class="bi bi-grid-3x3-gap"></i>
                </div>
                <h3 class="cat-title">Keycaps</h3>
                <p class="cat-meta">GMK, PBT, Artisan</p>
                <a href="#" class="cat-link">Browse Sets <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
        <div class="col-md-4">
             <div class="cat-card">
                <div class="cat-icon">
                    <i class="bi bi-cpu"></i>
                </div>
                <h3 class="cat-title">Switches</h3>
                <p class="cat-meta">Linear, Tactile, Clicky</p>
                <a href="#" class="cat-link">Find Your Sound <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>

<!-- Bottom CTA -->
<div class="cta-section">
    <div class="container">
        <h2 class="display-5 mb-3 cta-title">Ready to build your <span style="color: #6d6494;">dream setup</span>?</h2>
        <p class="text-secondary mb-5 mx-auto" style="max-width: 600px;">Join thousands of enthusiasts who trust KBShop for premium mechanical keyboard components.</p>
        <div class="d-flex justify-content-center gap-3">
             <a href="#" class="btn btn-primary">Create Account</a>
             <a href="#" class="btn-login" style="margin-right: 0;">Sign In</a>
        </div>
    </div>
</div>
