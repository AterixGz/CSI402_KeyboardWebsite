@model List<KeyboardWebsiteProject.Models.Product>

@{
    ViewData["Title"] = "Premium Keyboards";
    var firstCarouselProduct = Model?.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.ImageUrl));
}

<link rel="stylesheet" href="~/css/Home/index.css" />

<!-- Hero Section -->
<div class="hero-section fade-in-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="hero-subtitle">The Enthusiast Collection</span>
                <h1 class="hero-title fw-bold">Craft Your <span class="text-gradient-purple">Perfect</span><br>Typing Experience</h1>
                <p class="hero-desc">Discover purely aesthetic mechanical keyboards, artisan keycaps, and ultra-smooth switches designed for the dedicated enthusiast.</p>
                <div class="d-flex gap-3 mb-5">
                    <a asp-controller="Home" asp-action="Shop" asp-route-category="Mechanical Keyboard" class="btn btn-primary">Shop Keyboards</a>
                    <a asp-controller="Home" asp-action="Shop" asp-route-category="Keycaps" class="btn btn-outline-light">View Accessories</a>
                </div>
                
                <div class="d-flex gap-5 text-secondary">
                    <div>
                        <h4 class="mb-1">50+</h4>
                        <small>Premium Brands</small>
                    </div>
                    <div>
                        <h4 class="mb-1">24h</h4>
                        <small>Dispatch</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mt-5 mt-lg-0">
                <!-- Keyboard Carousel -->
                <div class="keyboard-visual-img carousel-wrapper">
                    <a id="heroCarouselLink" href="@(firstCarouselProduct != null ? Url.Action("ProductDetails", "Home", new { id = firstCarouselProduct.ProductId }) : "#")" class="carousel-link">
                        <img id="heroCarouselImage" src="~/image/Screenshot%202026-02-23%20142530.png" alt="Keyboard Visual" class="w-100 carousel-image" />
                    </a>
                    <div class="carousel-info">
                        <span id="heroCarouselBadge" class="carousel-badge">Restocked</span>
                        <div class="carousel-text">
                            <h5 id="heroCarouselTitle">Zoom75 Mechanical Keyboard</h5>
                            <p id="heroCarouselCategory" class="text-secondary mb-0">Premium build for typing and gaming</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Categories -->
<div class="container py-5 fade-in-section">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="cat-card">
                <div class="cat-icon">
                    <i class="bi bi-keyboard"></i>
                </div>
                <h3 class="cat-title">Keyboards</h3>
                <p class="cat-meta">Custom & Pre-built</p>
                <a asp-controller="Home" asp-action="Shop" asp-route-category="Mechanical Keyboard" class="cat-link">Browse Collection <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
        <div class="col-md-4">
             <div class="cat-card">
                <div class="cat-icon">
                    <i class="bi bi-grid-3x3-gap"></i>
                </div>
                <h3 class="cat-title">Keycaps</h3>
                <p class="cat-meta">GMK, PBT, Artisan</p>
                <a asp-controller="Home" asp-action="Shop" asp-route-category="Keycaps" class="cat-link">Browse Sets <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
        <div class="col-md-4">
             <div class="cat-card">
                <div class="cat-icon">
                    <i class="bi bi-cpu"></i>
                </div>
                <h3 class="cat-title">Switches</h3>
                <p class="cat-meta">Linear, Tactile, Clicky</p>
                <a asp-controller="Home" asp-action="Shop" asp-route-category="Switches" class="cat-link">Find Your Sound <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>

<!-- Featured Products Section -->
<div class="container py-5 fade-in-section">
    <div class="text-center mb-5">
        <h2 class="display-6 fw-bold mb-2">Featured Products</h2>
        <p class="text-secondary">Discover our most popular keyboards and accessories</p>
    </div>
    
    @if (Model != null && Model.Count > 0)
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="product-card" data-product-url="@Url.Action("ProductDetails", "Home", new { id = product.ProductId })" onclick="window.location.href=this.dataset.productUrl">
                        <div class="product-image">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@Url.Content(product.ImageUrl)" alt="@product.Name" class="w-100" />
                            }
                            else
                            {
                                <div style="width: 100%; height: 100%; background: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #999;">
                                    <i class="bi bi-image" style="font-size: 3rem;"></i>
                                </div>
                            }
                            <span class="product-badge">@(product.StockQuantity > 0 ? "In Stock" : "Sold Out")</span>
                        </div>
                        <div class="product-body">
                            <h5 class="product-title">@product.Name</h5>
                            <p class="product-category">@product.CategoryName</p>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="product-price">฿@product.Price.ToString("0.00")</span>
                                <div class="product-rating">
                                    @if (product.ReviewCount > 0)
                                    {
                                        var roundedStars = (int)Math.Round(product.AverageRating);
                                        for (int i = 1; i <= 5; i++)
                                        {
                                            var starClass = i <= roundedStars ? "bi-star-fill" : "bi-star";
                                            <i class="bi @starClass"></i>
                                        }
                                        <small class="text-secondary ms-2">(@product.ReviewCount)</small>
                                    }
                                    else
                                    {
                                        <small class="text-secondary">No reviews</small>
                                    }
                                </div>
                            </div>
                            <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@product.ProductId" class="btn btn-primary w-100">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a asp-controller="Home" asp-action="Shop" class="btn btn-outline-dark btn-lg">View All Products</a>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            <p class="mb-0" style="font-size: 1.1rem; color: #666;">ตอนนี้ยังไม่มีสินค้า</p>
        </div>
    }
</div>

<!-- Bottom CTA -->
<div class="cta-section fade-in-section">
    <div class="container">
        <h2 class="display-5 mb-3 cta-title">Ready to build your <span style="color: #6d6494;">dream setup</span>?</h2>
        <p class="text-secondary mb-5 mx-auto" style="max-width: 600px;">Join thousands of enthusiasts who trust KeyCraft for premium mechanical keyboard components.</p>
        <div class="d-flex justify-content-center gap-3">
             <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Create Account</a>
             <a asp-controller="Account" asp-action="Login" class="btn-login" style="margin-right: 0;">Sign In</a>
        </div>
    </div>
</div>

@{
    var carouselItems = (Model ?? new List<KeyboardWebsiteProject.Models.Product>())
        .Where(p => !string.IsNullOrWhiteSpace(p.ImageUrl))
        .Select(p => new {
            ImageUrl = Url.Content(p.ImageUrl),
            Title = p.Name ?? string.Empty,
            Category = p.CategoryName ?? string.Empty,
            Badge = p.StockQuantity > 0 ? "In Stock" : "Sold Out",
            ProductUrl = Url.Action("ProductDetails", "Home", new { id = p.ProductId })
        })
        .Take(5)
        .ToList();
}
<script>
    // Scroll-based fade-in animation
    document.addEventListener('DOMContentLoaded', function() {
        const sections = document.querySelectorAll('.fade-in-section');
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                // When element comes into view
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    // Optional: Stop observing after first visibility
                    observer.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.1, // Trigger when 10% of element is visible
            rootMargin: '0px 0px -50px 0px' // Start animation a bit before it comes into full view
        });
        
        sections.forEach(section => {
            observer.observe(section);
        });

        const carouselData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(carouselItems));
        const carouselImage = document.getElementById('heroCarouselImage');
        const carouselLink = document.getElementById('heroCarouselLink');
        const carouselTitle = document.getElementById('heroCarouselTitle');
        const carouselCategory = document.getElementById('heroCarouselCategory');
        const carouselBadge = document.getElementById('heroCarouselBadge');
        let carouselIndex = 0;

        if (carouselData && carouselData.length > 0) {
            function showCarouselItem(index) {
                const item = carouselData[index];
                if (!item) return;

                carouselImage.style.opacity = '0';
                setTimeout(() => {
                    carouselImage.src = item.ImageUrl;
                    carouselImage.alt = item.Title || 'Keyboard Product';
                    carouselTitle.textContent = item.Title || 'Featured Keyboard';
                    carouselCategory.textContent = item.Category || 'Mechanical Keyboard';
                    carouselBadge.textContent = item.Badge || 'Featured';
                    if (carouselLink && item.ProductUrl) {
                        carouselLink.href = item.ProductUrl;
                    }
                    carouselImage.style.opacity = '1';
                }, 300);
            }

            showCarouselItem(carouselIndex);
            setInterval(() => {
                carouselIndex = (carouselIndex + 1) % carouselData.length;
                showCarouselItem(carouselIndex);
            }, 4000);
        }
    });
</script>
