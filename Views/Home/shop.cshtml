@{
    ViewData["Title"] = "Shop All Products";
    var products = ViewBag.Products as List<KeyboardWebsiteProject.Models.Product> ?? new List<KeyboardWebsiteProject.Models.Product>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shop All Products</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Home/Shop.css" />
</head>
<body>

<!-- ── PAGE HEADER ── -->
<header class="page-header">
    <div class="page-header-left">
        <h1>Shop All Products</h1>
        <p>Browse our collection of premium keyboards, keycaps, switches, and accessories.</p>
    </div>
    <div style="padding: 28px 0;">
        <div class="search-box">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" placeholder="Search products…" id="searchInput" />
        </div>
    </div>
</header>

<div class="shop-layout">

    <!-- ── SIDEBAR ── -->
    <aside class="sidebar">
        <h2>Filters</h2>

        <div class="filter-section">
            <h3>Category</h3>
            <div class="tag-group">
                <span class="tag" onclick="toggleTag(this)">Keyboards</span>
                <span class="tag" onclick="toggleTag(this)">Keycaps</span>
                <span class="tag" onclick="toggleTag(this)">Switches</span>
                <span class="tag" onclick="toggleTag(this)">Accessories</span>
            </div>
        </div>

        <div class="filter-section">
            <h3>Price Range</h3>
            <div class="price-range-wrap">
                <input type="range" min="0" max="19800" value="19800" id="priceRange" oninput="document.getElementById('priceMax').textContent='฿'+this.value" />
                <div class="price-labels">
                    <span>฿0</span>
                    <span>to</span>
                    <span id="priceMax">฿19,800</span>
                </div>
            </div>
        </div>

        <div class="filter-section">
            <h3>Switch Type</h3>
            <div class="tag-group">
                <span class="tag" onclick="toggleTag(this)">Linear</span>
                <span class="tag" onclick="toggleTag(this)">Tactile</span>
                <span class="tag" onclick="toggleTag(this)">Clicky</span>
            </div>
        </div>

        <div class="filter-section">
            <h3>Keycap Profile</h3>
            <div class="tag-group">
                <span class="tag" onclick="toggleTag(this)">Cherry</span>
                <span class="tag" onclick="toggleTag(this)">MT3</span>
                <span class="tag" onclick="toggleTag(this)">KAT</span>
                <span class="tag" onclick="toggleTag(this)">SA</span>
                <span class="tag" onclick="toggleTag(this)">DSA</span>
            </div>
        </div>

        <div class="filter-section">
            <h3>Keyboard Layout</h3>
            <div class="tag-group">
                <span class="tag" onclick="toggleTag(this)">60%</span>
                <span class="tag" onclick="toggleTag(this)">65%</span>
                <span class="tag" onclick="toggleTag(this)">75%</span>
                <span class="tag" onclick="toggleTag(this)">TKL</span>
                <span class="tag" onclick="toggleTag(this)">Full-size</span>
            </div>
        </div>

        <div class="filter-section">
            <h3>Brand</h3>
            <div class="checkbox-list-fade">
                <div class="checkbox-list" id="brandList">
                    <label><input type="checkbox" /> Angry Miao</label>
                    <label><input type="checkbox" /> CableMod</label>
                    <label><input type="checkbox" /> CannonKeys</label>
                    <label><input type="checkbox" /> Drop</label>
                    <label><input type="checkbox" /> GMK</label>
                    <label><input type="checkbox" /> Gateron</label>
                    <label><input type="checkbox" /> Gazzew</label>
                    <label><input type="checkbox" /> Mode</label>
                    <label><input type="checkbox" /> Zoom</label>
                </div>
            </div>
        </div>

        <div class="filter-section">
            <h3>Availability</h3>
            <div class="checkbox-list">
                <label><input type="checkbox" /> In Stock Only</label>
                <label><input type="checkbox" /> New Arrivals</label>
            </div>
        </div>
    </aside>

    <!-- ── MAIN ── -->
    <main class="main-content">
        <div class="toolbar">
            <span class="product-count">@products.Count products</span>
            <div class="toolbar-right">
                <div class="view-toggle">
                    <button class="view-btn" title="List view">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    </button>
                    <button class="view-btn active" title="Grid view">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                    </button>
                </div>
                <select class="sort-select">
                    <option>Featured</option>
                    <option>Price: Low to High</option>
                    <option>Price: High to Low</option>
                    <option>Newest</option>
                </select>
            </div>
        </div>

        <div class="product-grid" id="productGrid">
            @if (products != null && products.Count > 0)
            {
                @foreach (var product in products)
                {
                    <div class="product-card" onclick="navigateToProduct(@product.ProductId, '@product.Name', '@product.Price.ToString("0.00")', '@product.Description')">
                        <div class="card-image">
                            @if (product.StockQuantity == 0)
                            {
                                <span class="badge badge-sold">Sold Out</span>
                            }
                            else if (product.StockQuantity <= 5)
                            {
                                <span class="badge badge-few">@product.StockQuantity left</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl) && !product.ImageUrl.Contains("~/image/default.png"))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" />
                            }
                            else
                            {
                                <svg class="kbd-placeholder" width="160" height="100" viewBox="0 0 160 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="4" y="18" width="152" height="64" rx="8" stroke="#10b981" stroke-width="2"/>
                                    @for (int r = 0; r < 3; r++) {
                                        @for (int c = 0; c < 14; c++) {
                                            <rect x="@(12+c*10)" y="@(28+r*12)" width="8" height="8" rx="1.5" fill="#10b981" opacity="0.5"/>
                                        }
                                    }
                                    <rect x="12" y="64" width="24" height="8" rx="1.5" fill="#10b981" opacity="0.5"/>
                                    <rect x="40" y="64" width="76" height="8" rx="1.5" fill="#10b981" opacity="0.5"/>
                                    <rect x="120" y="64" width="28" height="8" rx="1.5" fill="#10b981" opacity="0.5"/>
                                </svg>
                            }
                        </div>
                        <div class="card-body">
                            <div class="card-name">@product.Name</div>
                            <div class="card-desc">@product.CategoryName - @product.BrandName</div>
                            <div class="card-footer">
                                <span class="card-price">฿@product.Price.ToString("0.00")</span>
                                <button class="add-btn" title="Add to cart">+</button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="grid-column: 1/-1; padding: 40px; text-align: center; color: #6b7280;">
                    <p>No products available at the moment.</p>
                </div>
            }

        </div><!-- /product-grid -->
    </main>
</div><!-- /shop-layout -->

<script>
    function toggleTag(el) {
        el.classList.toggle('active');
    }

    // Navigate to product details
    function navigateToProduct(id, name, price, description) {
        const params = new URLSearchParams({
            id: id,
            name: name,
            price: price,
            description: description
        });
        window.location.href = `/Home/ProductDetails?${params.toString()}`;
    }

    // Simple client-side search
    document.getElementById('searchInput').addEventListener('input', function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll('.product-card').forEach(card => {
            const name = card.querySelector('.card-name').textContent.toLowerCase();
            card.style.display = name.includes(q) ? '' : 'none';
        });
    });
</script>
</body>
</html>
