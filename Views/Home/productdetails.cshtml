                    <rect x="426" y="58" width="58" height="24" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                    <!-- Row 3 -->
                    <rect x="22" y="88" width="44" height="24" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                    <rect x="72" y="88" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
