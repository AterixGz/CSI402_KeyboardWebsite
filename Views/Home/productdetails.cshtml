@model KeyboardWebsiteProject.Models.Product

@{
    ViewData["Title"] = Model?.Name ?? "Product Details";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – KeyCraft</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Home/Productdetails.css" />
</head>
<body>

<!-- TOAST -->
<div class="toast" id="toast">✓ Added to cart!</div>

<div class="page">

    <!-- ── HERO ── -->
    <section class="hero">

        <!-- Gallery -->
        <div class="gallery">
            <div class="gallery-main">
                @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                {
                    <!-- Product Image -->
                    <img id="mainProductImage" src="@Url.Content(Model.ImageUrl)" alt="@Model?.Name" />
                }
                else
                {
                    <!-- Fallback SVG keyboard illustration -->
                    <svg class="kb-placeholder" viewBox="0 0 520 190" xmlns="http://www.w3.org/2000/svg">
                        <rect x="8" y="16" width="504" height="158" rx="14" fill="#202020" stroke="#333" stroke-width="1.5"/>
                        <!-- Row 1 -->
                        <rect x="22" y="28" width="32" height="24" rx="5" fill="#F5C842"/>
                        <rect x="60" y="28" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="90" y="28" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="120" y="28" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="150" y="28" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="180" y="28" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="210" y="28" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="240" y="28" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="270" y="28" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="300" y="28" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="330" y="28" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="360" y="28" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="390" y="28" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="420" y="28" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="454" y="28" width="30" height="24" rx="5" fill="#F5C842"/>
                        <!-- Row 2 -->
                        <rect x="22" y="58" width="38" height="24" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="66" y="58" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="96" y="58" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="126" y="58" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="156" y="58" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="186" y="58" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="216" y="58" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="246" y="58" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="276" y="58" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="306" y="58" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="336" y="58" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="366" y="58" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="396" y="58" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="426" y="58" width="58" height="24" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                        <!-- Row 3 -->
                        <rect x="22" y="88" width="44" height="24" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="72" y="88" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="102" y="88" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="132" y="88" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="162" y="88" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="192" y="88" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="222" y="88" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="252" y="88" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="282" y="88" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="312" y="88" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="342" y="88" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="372" y="88" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="402" y="88" width="82" height="24" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                        <!-- Row 4 -->
                        <rect x="22" y="118" width="56" height="24" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="84" y="118" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="114" y="118" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="144" y="118" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="174" y="118" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="204" y="118" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="234" y="118" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="264" y="118" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="294" y="118" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="324" y="118" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="354" y="118" width="56" height="24" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="420" y="118" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="450" y="118" width="24" height="24" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <!-- Spacebar row -->
                        <rect x="22"  y="148" width="30" height="20" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="58"  y="148" width="30" height="20" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="94"  y="148" width="30" height="20" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="130" y="148" width="192" height="20" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="328" y="148" width="24" height="20" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="358" y="148" width="24" height="20" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="388" y="148" width="24" height="20" rx="5" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="418" y="148" width="24" height="20" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <rect x="448" y="148" width="24" height="20" rx="5" fill="#2c2c2c" stroke="#3a3a3a" stroke-width="1"/>
                        <!-- RGB glow strip -->
                        <defs>
                            <linearGradient id="rgb" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%"   stop-color="#ff4444" stop-opacity=".6"/>
                                <stop offset="33%"  stop-color="#F5C842" stop-opacity=".6"/>
                                <stop offset="66%"  stop-color="#44ff88" stop-opacity=".6"/>
                                <stop offset="100%" stop-color="#4488ff" stop-opacity=".6"/>
                            </linearGradient>
                        </defs>
                        <rect x="8" y="169" width="504" height="4" rx="2" fill="url(#rgb)" opacity=".7"/>
                    </svg>
                }
            </div>
            <div class="thumbs">
                @{ 
                    var thumbs = Model?.ImageUrls ?? new List<string>();
                    if (thumbs.Count == 0 && !string.IsNullOrEmpty(Model?.ImageUrl))
                    {
                        thumbs.Add(Model.ImageUrl);
                    }
                    int thumbIndex = 0;
                }
                @foreach (var imageUrl in thumbs)
                {
                    var activeClass = thumbIndex == 0 ? "active" : "";
                    <div class="thumb @activeClass" onclick="selThumb(this)" data-image-url="@Url.Content(imageUrl)">
                        <img src="@Url.Content(imageUrl)" alt="@Model?.Name thumbnail @thumbIndex" />
                    </div>
                    thumbIndex++;
                }
            </div>
        </div>

        <!-- Product Info -->
        <div class="info">
            <span class="brand-label">@Model?.BrandName</span>
            <h1 class="product-name">@Model?.Name</h1>

            @{ 
                var reviewCount = Model?.Reviews?.Count ?? 0;
                var averageRating = reviewCount > 0 ? Model.Reviews.Average(r => r.Rating) : 0.0;
                var roundedRating = Math.Round(averageRating, 1);
            }
            <div class="rating-row">
                <div class="stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="star @(i <= Math.Round(averageRating) ? "" : "empty")">★</span>
                    }
                </div>
                <span class="rating-meta">
                    @if (reviewCount > 0)
                    {
                        @($"{roundedRating} ({reviewCount} reviews)")
                    }
                    else
                    {
                        <span>No reviews yet</span>
                    }
                </span>
            </div>

            <div class="price-row">
                <span class="price">฿@Model?.Price.ToString("0.00")</span>
                <button type="button" class="btn-favorite @(ViewBag.IsFavorite == true ? "active" : "")" id="favoriteBtn" onclick="toggleFavorite()" title="@(ViewBag.IsFavorite == true ? "Remove from favorites" : "Add to favorites")">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                </button>
            </div>

            <p class="desc">
                @Model?.Description
            </p>

            <!-- Quantity -->
            <div class="opt-section">
                <span class="opt-title">Quantity</span>
                <div class="qty-wrap">
                    <button class="qty-btn" onclick="changeQty(-1)">−</button>
                    <input  class="qty-val" id="qty-val" value="1" readonly />
                    <button class="qty-btn" onclick="changeQty(1)">+</button>
                </div>
            </div>

            <div class="in-stock">
                <span class="stock-dot"></span>
                @if (Model?.StockQuantity > 0)
                {
                    <span>In Stock (@Model.StockQuantity available)</span>
                }
                else
                {
                    <span style="color: #ef4444;">Out of Stock</span>
                }
            </div>

            <div class="cta-row">
                <button type="button" class="btn-primary" onclick="addToCartAjax()">Add to Cart</button>
                @if (ViewBag.IsAuthenticated == true)
                {
                    <form method="post" asp-action="AddToCart" asp-controller="Home" class="d-inline" id="buyNowForm">
                        <input type="hidden" name="productId" value="@Model?.ProductId" />
                        <input type="hidden" name="quantity" id="qty-hidden-buy" value="1" />
                        <input type="hidden" name="isBuyNow" value="true" />
                        <button type="submit" class="btn-outline">Buy Now</button>
                    </form>
                }
                else
                {
                    <a href='@Url.Action("Login", "Account")' class="btn-outline">Buy Now</a>
                }
            </div>
        </div>
    </section>

    <hr class="divider" />

    <!-- ── PERKS ── -->
    <div class="perks">
        <div class="perk">
            <span class="perk-icon">🚚</span>
            <div>
                <div class="perk-title">Free Shipping</div>
                <div class="perk-sub">Orders over ฿1,500</div>
            </div>
        </div>
        <div class="perk">
            <span class="perk-icon">🛡️</span>
            <div>
                <div class="perk-title">2 Year Warranty</div>
                <div class="perk-sub">Full coverage</div>
            </div>
        </div>
        <div class="perk">
            <span class="perk-icon">↩️</span>
            <div>
                <div class="perk-title">30 Days Return</div>
                <div class="perk-sub">Easy returns</div>
            </div>
        </div>
    </div>

    <hr class="divider" />

    <!-- ── SPECIFICATIONS ── -->
    <section>
        <h2 class="section-title">Specifications</h2>

<style>
    .price-row {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
    }

    .btn-favorite {
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d1d5db;
        transition: all 0.2s ease;
        border-radius: 6px;
    }

    .btn-favorite:hover {
        color: #ef4444;
        background: #fee2e2;
    }

    .btn-favorite.active {
        color: #ef4444;
        fill: currentColor;
    }

    .btn-favorite.active:hover {
        background: #fecaca;
    }

    .review-alert {
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 14px;
        padding: 16px;
        color: #0f172a;
        margin-bottom: 20px;
    }

    .review-list {
        display: grid;
        gap: 18px;
        margin-top: 26px;
    }

    .review-card {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 20px;
    }

    .review-input-card.user-review-card {
        border-color: #fbbf24;
        background: #fff7ed;
    }

    .review-breakdown {
        display: grid;
        gap: 12px;
        margin: 18px 0 28px;
    }

    .review-breakdown-row {
        display: grid;
        grid-template-columns: 48px 1fr 40px;
        gap: 10px;
        align-items: center;
        font-size: 0.95rem;
        color: #374151;
    }

    .breakdown-bar {
        background: #e2e8f0;
        border-radius: 999px;
        height: 10px;
        width: 100%;
        overflow: hidden;
    }

    .breakdown-fill {
        height: 100%;
        background: #f59e0b;
        border-radius: 999px;
    }

    .breakdown-count {
        text-align: right;
    }

    .review-card {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 20px;
    }

    .review-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
        color: #475569;
        font-size: 0.95rem;
    }

    .review-card-stars {
        display: inline-flex;
        gap: 4px;
        margin-bottom: 10px;
    }

    .review-star {
        font-size: 1rem;
        color: #d1d5db;
    }

    .review-star.filled {
        color: #f59e0b;
    }

    .review-card-content {
        margin-top: 14px;
    }

    .review-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 18px;
        font-size: 0.9rem;
        color: #475569;
    }

    .btn-delete-review {
        background: none;
        border: 1px solid #dc2626;
        color: #dc2626;
        padding: 8px 14px;
        border-radius: 8px;
        cursor: pointer;
    }

    .btn-delete-review:hover {
        background: rgba(220, 38, 38, 0.08);
    }

    .review-card-comment {
        margin: 0;
        color: #111827;
        line-height: 1.7;
    }
</style>
        @if (Model?.Specifications != null && Model.Specifications.Count > 0)
        {
            <table class="spec-table">
                @foreach (var spec in Model.Specifications)
                {
                    <tr>
                        <td>@spec.SpecKey</td>
                        <td>@spec.SpecValue</td>
                    </tr>
                }
            </table>
        }
        else
        {
            <p style="color: #7a7c85;">No specifications available for this product.</p>
        }
    </section>

    <hr class="divider" />

    <!-- ── REVIEWS ── -->
    <section>
        <h2 class="section-title">Customer Reviews</h2>

        @if (TempData["ReviewMessage"] != null)
        {
            <div class="review-alert">@TempData["ReviewMessage"]</div>
        }

        <div class="review-breakdown">
            @{ var totalReviews = Model?.ReviewCount ?? 0; }
            @foreach (var starEntry in new[] {
                new { Stars = 5, Count = Model?.Star5Count ?? 0 },
                new { Stars = 4, Count = Model?.Star4Count ?? 0 },
                new { Stars = 3, Count = Model?.Star3Count ?? 0 },
                new { Stars = 2, Count = Model?.Star2Count ?? 0 },
                new { Stars = 1, Count = Model?.Star1Count ?? 0 }
            })
            {
                var ratio = totalReviews > 0 ? (int)Math.Round((double)starEntry.Count / totalReviews * 100) : 0;
                <div class="review-breakdown-row">
                    <span>@starEntry.Stars star</span>
                    <div class="breakdown-bar">
                        <div class="breakdown-fill" style="width:@ratio%"></div>
                    </div>
                    <span class="breakdown-count">@starEntry.Count</span>
                </div>
            }
        </div>

        @if (Model?.UserReview != null)
        {
            <div class="review-input-card user-review-card">
                <div class="review-input-header">
                    <div>
                        <div class="review-input-title">Your review</div>
                        <div class="review-input-subtitle">You can delete this review and submit a new one.</div>
                    </div>
                    <div class="review-card-stars">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <span class="review-star @(i <= Model.UserReview.Rating ? "filled" : "empty")">★</span>
                        }
                    </div>
                </div>
                <div class="review-card-content">
                    <p class="review-card-comment">@Model.UserReview.Comment</p>
                    <div class="review-card-footer">
                        <span class="review-card-date">@Model.UserReview.ReviewDate.ToString("yyyy-MM-dd")</span>
                        <form method="post" asp-action="DeleteReview" asp-controller="Home" class="d-inline">
                            <input type="hidden" name="productId" value="@Model?.ProductId" />
                            <button type="submit" class="btn-outline btn-delete-review">Delete review</button>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <form id="reviewForm" method="post" asp-action="AddReview" asp-controller="Home" class="review-input-card" onsubmit="return validateReviewForm()">
                <div class="review-input-header">
                    <div>
                        <div class="review-input-title">Write a review</div>
                        <div class="review-input-subtitle">Share your thoughts on this product.</div>
                    </div>
                    <div id="reviewStars" class="review-stars">
                        <button type="button" class="star-btn active" onclick="setReviewRating(1)">★</button>
                        <button type="button" class="star-btn active" onclick="setReviewRating(2)">★</button>
                        <button type="button" class="star-btn active" onclick="setReviewRating(3)">★</button>
                        <button type="button" class="star-btn active" onclick="setReviewRating(4)">★</button>
                        <button type="button" class="star-btn active" onclick="setReviewRating(5)">★</button>
                    </div>
                </div>
                <input type="hidden" name="productId" value="@Model?.ProductId" />
                <input type="hidden" name="rating" id="reviewRatingInput" value="5" />
                <textarea id="reviewComment" name="comment" placeholder="What did you like? What can be improved?"></textarea>
                <div class="review-input-footer">
                    <button type="submit" class="btn-primary btn-submit-review">Submit Review</button>
                </div>
            </form>
        }

        @if (Model?.Reviews != null && Model.Reviews.Count > 0)
        {
            <div class="review-list">
                @foreach (var review in Model.Reviews)
                {
                    <div class="review-card">
                        <div class="review-card-header">
                            <span class="review-card-name">@review.ReviewerName</span>
                            <span class="review-card-date">@review.ReviewDate.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div class="review-card-stars">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <span class="review-star @(i <= review.Rating ? "filled" : "empty")">★</span>
                            }
                        </div>
                        <p class="review-card-comment">@review.Comment</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="background: var(--surface2); border: 1px solid var(--border); border-radius: var(--r); padding: 40px; text-align: center; color: #7a7c85;">
                <p>Reviews for this product will be available soon.</p>
            </div>
        }
    </section>

</div><!-- /page -->

<script>
    // ── Quantity ──
    let qty = 1;
    function changeQty(delta) {
        qty = Math.max(1, qty + delta);
        document.getElementById('qty-val').value = qty;
        // อัปเดตทั้ง hidden fields
        var hiddenAddToCart = document.getElementById('qty-hidden');
        var hiddenBuyNow = document.getElementById('qty-hidden-buy');
        if (hiddenAddToCart) hiddenAddToCart.value = qty;
        if (hiddenBuyNow) hiddenBuyNow.value = qty;
    }

    // ── Option buttons ──
    function selectOpt(btn, groupId) {
        document.getElementById(groupId)
            .querySelectorAll('.opt-btn')
            .forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    }

    // ── Gallery thumbnails ──
    let currentImageIndex = 0;

    function setActiveThumb(index) {
        const thumbs = Array.from(document.querySelectorAll('.thumb'));
        if (!thumbs.length) return;
        index = (index + thumbs.length) % thumbs.length;
        currentImageIndex = index;
        const newSrc = thumbs[index].dataset.imageUrl;
        const mainImage = document.getElementById('mainProductImage');
        thumbs.forEach((t, i) => t.classList.toggle('active', i === index));

        if (newSrc && mainImage) {
            const normalizedSrc = new URL(newSrc, window.location.href).href;
            if (mainImage.src !== normalizedSrc) {
                mainImage.style.opacity = '0';
                const onLoad = () => {
                    mainImage.style.opacity = '1';
                    mainImage.removeEventListener('load', onLoad);
                };
                mainImage.addEventListener('load', onLoad);
                setTimeout(() => {
                    mainImage.src = newSrc;
                }, 120);
            }
        }
    }

    function selThumb(el) {
        const thumbs = Array.from(document.querySelectorAll('.thumb'));
        const index = thumbs.indexOf(el);
        if (index >= 0) {
            setActiveThumb(index);
        }
    }

    function updateGalleryCursor(e) {
        const galleryMain = document.querySelector('.gallery-main');
        if (!galleryMain) return;
        const rect = galleryMain.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const leftThreshold = rect.width * 0.25;
        const rightThreshold = rect.width * 0.75;

        galleryMain.classList.remove('cursor-left', 'cursor-right', 'cursor-center');
        if (x < leftThreshold) {
            galleryMain.classList.add('cursor-left');
        } else if (x > rightThreshold) {
            galleryMain.classList.add('cursor-right');
        } else {
            galleryMain.classList.add('cursor-center');
        }
    }

    function galleryMainClick(e) {
        const galleryMain = document.querySelector('.gallery-main');
        if (!galleryMain) return;
        const thumbs = Array.from(document.querySelectorAll('.thumb'));
        if (thumbs.length <= 1) return;
        const rect = galleryMain.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const leftThreshold = rect.width * 0.25;
        const rightThreshold = rect.width * 0.75;

        if (x < leftThreshold) {
            setActiveThumb(currentImageIndex - 1);
        } else if (x > rightThreshold) {
            setActiveThumb(currentImageIndex + 1);
        }
    }

    const galleryMain = document.querySelector('.gallery-main');
    if (galleryMain) {
        const thumbs = Array.from(document.querySelectorAll('.thumb'));
        const activeThumb = thumbs.findIndex(t => t.classList.contains('active'));
        if (activeThumb >= 0) {
            currentImageIndex = activeThumb;
        }
        galleryMain.addEventListener('mousemove', updateGalleryCursor);
        galleryMain.addEventListener('mouseleave', () => {
            galleryMain.classList.remove('cursor-left', 'cursor-right');
            galleryMain.classList.add('cursor-center');
        });
        galleryMain.addEventListener('click', galleryMainClick);
    }

    // ── Add to Cart (AJAX - ไม่เปลี่ยนหน้า) ──
    async function addToCartAjax() {
        const productId = '@Model?.ProductId';

        try {
            const response = await fetch('@Url.Action("AddToCart", "Home")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    productId: Number(productId),
                    quantity: qty,
                    isBuyNow: false
                })
            });

            if (!response.ok) {
                if (response.status === 401) {
                    const data = await response.json().catch(() => null);
                    window.location.href = data?.redirectUrl || '/Account/Login';
                    return;
                }
                throw new Error('ไม่สามารถเพิ่มสินค้าลงตะกร้าได้');
            }

            const result = await response.json();
            if (result.success) {
                const toast = document.getElementById('toast');
                const productName = '@Model?.Name';
                toast.textContent = `✓ Added ${qty}x ${productName} to cart!`;
                toast.style.display = 'block';
                clearTimeout(toast._t);
                toast._t = setTimeout(() => toast.style.display = 'none', 3000);
            } else if (result.redirectUrl) {
                window.location.href = result.redirectUrl;
            } else {
                alert(result.message || 'เกิดข้อผิดพลาด');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('เกิดข้อผิดพลาดในการเพิ่มสินค้า');
        }
    }

    // ── Add to Cart (Form Submit) ──
    function addToCart() {
        const toast = document.getElementById('toast');
        const productName = '@Model?.Name';
        toast.textContent = `✓ Added ${qty}x ${productName} to cart!`;
        toast.style.display = 'block';
        clearTimeout(toast._t);
        toast._t = setTimeout(() => toast.style.display = 'none', 3000);
    }

    // ── Toggle Favorite ──
    function toggleFavorite() {
        const btn = document.getElementById('favoriteBtn');
        const productId = '@Model?.ProductId';
        const isFavorite = btn.classList.contains('active');

        // Toggle UI immediately for responsiveness
        btn.classList.toggle('active');

        const newState = btn.classList.contains('active');
        const action = newState ? 'AddToWishlist' : 'RemoveFromWishlist';

        fetch(`/Home/${action}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: `productId=${productId}`
        })
        .then(async response => {
            if (!response.ok) {
                throw new Error('Request failed');
            }
            const result = await response.json();
            if (!result.success) {
                btn.classList.toggle('active');
                alert(result.message || 'เกิดข้อผิดพลาดขณะบันทึกรายการโปรด');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            btn.classList.toggle('active');
            alert('เกิดข้อผิดพลาดขณะบันทึกรายการโปรด');
        });
    }

    let reviewRating = 5;
    function setReviewRating(value) {
        reviewRating = value;
        document.getElementById('reviewRatingInput').value = value;
        document.querySelectorAll('#reviewStars .star-btn').forEach((btn, idx) => {
            btn.classList.toggle('active', idx < value);
        });
    }

    function validateReviewForm() {
        const comment = document.getElementById('reviewComment').value.trim();
        if (!comment) {
            alert('Please write a review before submitting.');
            return false;
        }
        return true;
    }
</script>

</body>
</html>
