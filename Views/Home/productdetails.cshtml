@{
    ViewData["Title"] = "productName";

    var switchTypes = new[] { "Gateron Red", "Gateron Brown", "Gateron Blue", "Gateron Yellow" };
    var layouts = new[] { "ANSI (US)", "ISO (EU)", "JIS (JP)" };

    var specs = new[]
    {
        ("Layout",         "75% (84 keys)"),
        ("Switch Type",    "Hot-swappable (3-pin / 5-pin)"),
        ("Keycaps",        "PBT Double-shot, Cherry Profile"),
        ("Backlight",      "RGB Per-key, 16.8M colors"),
        ("Connectivity",   "USB-C Wired / Bluetooth 5.0 / 2.4GHz Wireless"),
        ("Battery",        "4000mAh (up to 200 hours)"),
        ("Frame Material", "Aluminum alloy, CNC machined"),
        ("Weight",         "950g (without cable)"),
        ("Dimensions",     "325 x 145 x 40mm"),
        ("Software",       "KeyCraft Studio (Windows/macOS)"),
        ("Included",       "USB-C cable, keycap puller, switch puller, extra keycaps"),
    };

    var reviews = new[]
    {
        new {
            Initial     = "A",
            Name        = "Alex Chen",
            Date        = "March 15, 2026",
            Stars       = 5,
            Title       = "Best keyboard I've ever owned!",
            Body        = "The build quality is exceptional. The aluminum frame feels premium and the typing experience with Gateron Yellow switches is incredibly smooth. RGB lighting is vibrant and the software allows for extensive customization. Highly recommended for both work and gaming.",
            HelpfulCount = 24
        },
        new {
            Initial     = "S",
            Name        = "Sarah Kim",
            Date        = "March 10, 2026",
            Stars       = 5,
            Title       = "Perfect for programming",
            Body        = "As a software developer, I spend 8+ hours a day typing. This keyboard has significantly reduced my fatigue. The PBT keycaps have a satisfying texture and the hot-swap feature means I can experiment with different switches without soldering.",
            HelpfulCount = 18
        }
    };

    var starDist = new[] { (5, 2), (4, 1), (3, 0), (2, 0), (1, 0) };
    int maxCount = starDist.Max(x => x.Item2);
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – KeyCraft</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Home/Productdetails.css" />
</head>
<body>

<!-- TOAST -->
